<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Nitrous.IO</title>
  <link rel="shortcut icon" href="/favicon.ico">
  <%= stylesheet_link_tag 'application', media: 'all' %>
</head>
<body>
  <div id="app"></div>
  <%= javascript_include_tag 'jquery' %>
  <%= javascript_include_tag 'application' %>
  <script>
    App.set('terminalJsUrl',  '<%= javascript_url "terminal" %>')
    App.set('terminalCssUrl', '<%= stylesheet_url "terminal" %>')
  </script>
</body>
</html>
