.card-header.bordered
  h2 New Host

form
  .card-body
    .ui.input-group
      label.field-label for='hosts-new-name'
        | Name
      = input type='text' id='hosts-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' value=name

      label.field-label for='hosts-new-slug'
        | Unique Slug
      = input type='text' id='hosts-new-slug' name='slug' classNameBindings='view.slugFieldInvalid:error' pattern='[a-z0-9][a-z0-9\-]*' value=slug

      label.field-label for='hosts-new-region'
        | Region

      ul.ui.checkbox-group.horizontal
        each region in App.regions
          li
            .ui.checkbox
              = input type='radio' name='region' id=region.radioId value=region.slug
              label
            label for={region.radioId}
              = region.name

  .card-body.bordered
    .ui.input-group
      label.field-label
        | Size
    .size-selection
      .size-list
        ul.ui.list.item-1-line
          each plan in App.plans
            li.list-item
              .left-accessory
                .ui.checkbox
                  = input type='radio' name='size' id=plan.radioId value=plan.slug
                  label
              .lines
                p
                  label for=plan.radioId
                    = plan.name
              .lines.right
                p
                  | $&nbsp;
                  = decimal plan.price 2
                  | &nbsp;/&nbsp;mo.

      .size-description
        table.ui.table.horizontal
          tr
            th Max. Containers
            td
              = selectedPlan.maxContainers

          tr
            th Processor Cores
            td
              = selectedPlan.cpu

          tr
            th Total Memory
            td
              = selectedPlan.memory

          tr
            th Total SSD Storage
            td
              = selectedPlan.storage

          tr
            th Container Root Access
            td
              i.fa.fa-check
                span Yes

          tr
            th Vagrant Provider
            td
              i.fa.fa-check
                span Yes

          tr
            th Custom Domains
            td
              i.fa.fa-check
                span Yes

    p.see-terms
      | Please review the&nbsp;
      a href='#' terms of service
      |, and&nbsp;
      a href='#' privacy policy
      |. All sales are final.

  .card-footer.bordered
    .right
      if saving
        button.ui.btn disabled='disabled'
          .spinner
          | Creating...
      else
        button.ui.btn click='cancel' Cancel
        button.ui.btn.primary click='create' disabled={view.createButtonDisabled} Create
