= outlet topnav

.ui.card
  h2.card-header Log In

  form
    .card-body
      .ui.input-group
        label.field-label for='login-login'
          | Username or Email
        input type='text' id='login-login' name='login'

        label.field-label for='login-password'
          | Password
        input type='password' id='login-password' name='password'

    .card-footer
      .right
        button.ui.btn.primary id='login-submit-btn' click='shake target="view"'
          | Log In

p.note
  | Don&rsquo;t have an account?&nbsp;
  link-to 'signup' | Sign up
  | .

= partial 'footer'
