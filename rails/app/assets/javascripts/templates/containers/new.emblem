.card-header.bordered
  h2 New Container

form submit='create target="view"'
  .card-body
    .ui.input-group
      label.field-label
        | Host
      .ui.select
        Ember.Select name='host' content=App.hosts optionValuePath='content.slug' optionLabelPath='content.nameAndSlug' value=selectedHostSlug

      label.field-label for='containers-new-name'
        | Name
      = input type='text' id='containers-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' value=name

      label.field-label for='containers-new-slug'
        | Unique Slug
      = input type='text' id='containers-new-slug' name='slug' classNameBindings='view.slugFieldInvalid:error' pattern=App.slug.inputPattern title=App.slug.inputTitle value=slug

  .card-body.bordered
    .ui.input-group
      label.field-label
        | Image

      .image-selection
        ul.ui.checkbox-group
          li
            .ui.checkbox
              input type='radio' id='containers-new-option-host-image' name='option' checked='checked' value='host-image'
              label
            label for='containers-new-option-host-image' Use Image On This Host

        .ui.select.indent
          Ember.Select class='option-input' name='containers-new-option-host-image' content=selectedHost.images optionValuePath='content.slugAndTag' optionLabelPath='content.slugAndTag' value=view.selectedHostImage

        ul.ui.checkbox-group
          li
            .ui.checkbox
              input type='radio' id='containers-new-option-base-image' name='option' value='base-image'
              label
            label for='containers-new-option-base-image' Use Nitrous.IO Base Image

        .ui.select.indent
          Ember.Select class='option-input' name='containers-new-option-base-image' content=App.baseImages optionValuePath='content.repo' optionLabelPath='content.repo' value=view.selectedBaseImage

        ul.ui.checkbox-group
          li
            .ui.checkbox
              input type='radio' id='containers-new-option-custom-image' name='option' value='custom-image'
              label
            label for='containers-new-option-custom-image' Specify Custom Image

        .indent
          = input type='text' class='option-input' name='containers-new-option-custom-image' placeholder='registry/repo:tag' value=view.customImage

  .advanced-options class={view.showAdvanced::hidden}
    .card-body.bordered.volumes
      .ui.input-group
        label.field-label
          | Volumes

        ul.ui.chips
          li
            | code:/volumes/code
            a.close href='#' &times;

          li
            | dotfiles:/dotfiles
            a.close href='#' &times;

        table.ui.table
          thead
            tr
              th Volume
              th colspan='2' Mount Point (Optional)
          tbody
            tr
              td
                .ui.select
                  select
                    option code
                    option dotfiles
                    option db
              td
                input type='text' placeholder='/code'
              td
                a.ui.btn.raised href='#' Add

    .card-body.bordered.port-bindings
      .ui.input-group
        label.field-label
          | Port Bindings

        ul.ui.chips
          li
            | Public:80:3000
            a.close href='#' &times;

          li
            | Private:1337:1337
            a.close href='#' &times;

        table.ui.table
          thead
            tr
              th Public
              th Host Port (Optional)
              th colspan='2' Container Port
          tbody
            tr
              td
                .ui.checkbox
                  input type='checkbox'
                  label
              td
                input type='number' min='1' max='65535' step='1' placeholder='63000'
              td
                input type='number' min='1' max='65535' step='1' placeholder='3000'
              td
                a.ui.btn.raised href='#' Add

        ul.ui.checkbox-group
          li
            .ui.checkbox
              input type='checkbox' id='containers-new-publish-all' name='publish_all' checked='checked'
              label
            label for='containers-new-publish-all' Publish All Exposed Ports

  .card-footer.bordered
    /.left
      /a#toggle-advanced-btn.ui.btn href='#' click='toggleShowAdvanced target="view"'
        /if view.showAdvanced
          /| Hide Advanced
        /else
          /| Show Advanced

    .right
      if saving
        button.ui.btn disabled='disabled'
          i.spinner
          | Creating...
      else
        a.ui.btn href='#' click='cancel' Cancel
        input.ui.btn.primary type='submit' disabled={view.createButtonDisabled} value='Create'
