= container-tab-bar selected='general'

.card-body
  table.ui.table.horizontal
    tr
      th State
      td colspan='3'
        .state-indicator class={state}
        = state

    tr
      th Slug
      td colspan='3'
        = slug

    tr
      th Image
      td colspan='3'
        = image

    tr
      th CMD
      td colspan='3'
        if cmd
          ul.comma-separated
            each cm in cmd
              li
                = cm
        else
          span.empty &ndash;

    tr
      th ENTRYPOINT
      td colspan='3'
        if entrypoint
          ul.comma-separated
            each ep in entrypoint
              li
                = ep
        else
          span.empty &ndash;

    tr
      th Internal IP
      td
        = ipAddress
      th Gateway IP
      td.right
        = gatewayIP

    tr
      th Created At
      td
        = dateabbr createdAt
      th Started At
      td
        if startedAt
          = dateabbr startedAt
        else
          span.empty &ndash;

    tr
      th Exit Code
      td
        = exitCodeString
      th Finished At
      td.right
        if finishedAt
          = dateabbr finishedAt
        else
          span.empty &ndash;

.card-footer.bordered
  .left
    button.ui.btn Restart
    button.ui.btn Stop
  .right
    button.ui.btn.primary click='openTerminal' Terminal
