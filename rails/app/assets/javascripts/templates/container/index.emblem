= container-tab-bar selected='general'

.card-body
  table.ui.table.horizontal
    tr
      th State
      td colspan='3'
        .state-indicator class={state}
        = state

    tr
      th Slug
      td colspan='3'
        span.click-highlight
          = slug

    tr
      th Image
      td colspan='3'
        span.click-highlight
          = image

    tr
      th CMD
      td colspan='3'
        if cmd
          ul.space-separated.blocks
            each cm in cmd
              li
                span.click-highlight
                  = cm
        else
          span.empty &ndash;

    tr
      th ENTRYPOINT
      td colspan='3'
        if entrypoint
          ul.space-separated.blocks
            each ep in entrypoint
              li
                span.click-highlight
                  = ep
        else
          span.empty &ndash;

    tr
      th Internal IP
      td
        span.click-highlight
          = ipAddress
      th Gateway IP
      td.right
        span.click-highlight
          = gatewayIP

    tr
      th Created At
      td
        = dateabbr createdAt
      th Started At
      td
        if startedAt
          = dateabbr startedAt
        else
          span.empty &ndash;

    tr
      th Exit Code
      td
        span.click-highlight
          = exitCodeString
      th Finished At
      td.right
        if finishedAt
          = dateabbr finishedAt
        else
          span.empty &ndash;

.card-footer.bordered
  if isRunning
    .left
      button.ui.btn click='restart' Restart
      button.ui.btn click='stop' Stop
    .right
      button.ui.btn click='showSnapshotDialog target="view"' Snapshot
      button.ui.btn click='openLogs' Logs
      button.ui.btn click='openAttach' Attach
      button.ui.btn.primary click='openTerminal' Terminal
  else
    if isStopped
      .left
        button.ui.btn click='showTerminateDialog target="view"' Terminate
      .right
        button.ui.btn click='showSnapshotDialog target="view"' Snapshot
        button.ui.btn.primary click='start' Start
    else
      if isTerminated
        .left
          button.ui.btn disabled='disabled' Terminated
      else
        .left
          button.ui.btn disabled='disabled' Please Wait...

#snapshot-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | New Snapshot
    form
      .card-body
        .ui.input-group
          label.field-label for='snapshot-name'
            | Image Name/Tag
          = input type='text' id='snapshot-name' value=snapshotImageName required=true
    .card-footer
      .right
        if snapshotting
          button.ui.btn disabled='disabled'
            i.spinner
            | Taking Snapshot...
        else
          button.ui.btn click='cancelSnapshot target="view"' Cancel
          button.ui.btn.primary click='confirmSnapshot target="view"' disabled=view.snapshotImageNameIsEmpty Take

#terminate-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        | This action&nbsp;
        strong CANNOT
        | &nbsp;be undone!
      p
        | This will permanently delete the&nbsp;
        strong
          | &ldquo;
          = displayName
          | &rdquo;
        | &nbsp;container and all data stored within the container.
      p
        | Please type in the slug of the host&nbsp;
        strong
          |(
          span.click-highlight
            = slug
          |)
        | &nbsp;to confirm:
      .ui.input-group
        Em.TextField class='focus' placeholder=slug value=view.terminateSlugConfirmation insertNewline=view.clickTerminate
    .card-footer
      .right
        button.ui.btn click='cancelTerminate target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmTerminate target="view"' disabled=view.terminateSlugConfirmationInvalid Terminate
