= container-tab-bar selected='keys'

.card-body
  if keys.loaded
    if keys.length
      ul.ui.list.with-separators.item-2-line
        each key in keys
          li.list-item
            .left-accessory
              .ui.checkbox
                input type='checkbox' name='key' id={key.inputId} value={key.id}
                label
            .lines
              label for={key.inputId}
                h4
                  = key.name
                p
                  | Added &nbsp;
                  = dateabbr key.createdAt
    else
      p.hint-text
        i.fa.fa-exclamation-circle
        | This container does not have any public key registered.
  else
    p.hint-text
      i.spinner
      | Loading...

.card-footer.bordered
  .left
    if removing
      button.ui.btn disabled='disabled'
        i.spinner
        | Removing...
    else
      button.ui.btn click='remove target="view"' Remove
  .right
    button.ui.btn.primary click='add' Register Key...
