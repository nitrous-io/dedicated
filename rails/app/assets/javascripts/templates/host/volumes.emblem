= host-tab-bar selected='volumes' host=model

.card-body
  if records.loaded
    if records.length
      ul.ui.list.with-separators.item-2-line
        each volume in records
          li.list-item
            .left-accessory
              .ui.checkbox
                input.record-checkbox type='checkbox' id={volume.inputId} value={volume.id}
                label
            .lines
              label for={volume.inputId}
                h4
                  = volume.displayName
                p
                  = volume.slug
                  span.sep
                  | Created&nbsp;
                  = ago createdAt
                  span.sep
                  a href='#' Calculate Size

    else
      p.hint-text
        i.fa.fa-exclamation-circle
        | This host does not have any volumes.
  else
    p.hint-text
      i.spinner
      | Loading...

.card-footer.bordered
  .left
    if removing
      button.ui.btn disabled='disabled'
        i.spinner
        | Removing...
    else
      button.ui.btn click='remove' disabled=noneSelected Remove
  .right
    button.ui.btn.primary click='add' New Volume...
