= host-tab-bar selected='registries' host=model

.card-body
  if records.loaded
    if records.length
      ul.ui.list.with-separators.item-2-line
        each registry in records
          li.list-item
            .left-accessory
              .ui.checkbox
                input.record-checkbox type='checkbox' id={registry.inputId} value={registry.id}
                label
            .lines
              label for={registry.inputId}
                h4
                  = registry.url
                p
                  = registry.username
                  if registry.email
                    | &nbsp;(
                    = registry.email
                    | )
    else
      p.hint-text
        i.fa.fa-exclamation-circle
        | This host is not connected to any Docker registry.
  else
    p.hint-text
      i.spinner
      | Loading...

.card-footer.bordered
  .left
    if removing
      button.ui.btn disabled='disabled'
        i.spinner
        | Removing...
    else
      button.ui.btn click='remove' disabled=noneSelected Remove
  .right
    button.ui.btn.primary click='add' Connect to Registry...
