= host-tab-bar selected='general'

.card-body
  table.ui.table.horizontal
    tr
      th State
      td
        .state-indicator class={state}
        = state
      th Uptime
      td.usage
        = durationInWords stats.uptime

    tr
      th Slug
      td
        = slug
      th CPU Usage (%)
      td.usage
        ul.cpu-usage
          each cpuUsage in stats.perCPUUsage
            li
              = toFixed cpuUsage 1

    tr
      th Created At
      td
        abbr title={view.createdAtUTC}
          = ago createdAt
      th
        | Memory
        span.no-text-transform &nbsp;(MiB)
      td.usage
        = mebibytes stats.memoryUsage
        | &nbsp;/&nbsp;
        = mebibytes stats.memoryTotal

    tr
      th
      td
      th
        | Storage
        span.no-text-transform &nbsp;(GiB)
      td.usage
        = gibibytes stats.storageUsage
        | &nbsp;/&nbsp;
        = gibibytes stats.storageTotal

.card-footer.bordered
  if view.hostIsRunning
    .left
      button.ui.btn click='restart' Restart
      button.ui.btn click='stop' Stop
    .right
      button.ui.btn.primary.refresh-btn click='refresh target="view"' Refresh
  else
    if view.hostIsStopped
      .left
        button.ui.btn click='terminate' Terminate
      .right
        button.ui.btn.primary click='start' Start
    else
      .left
        button.ui.btn disabled='disabled' Please Wait...
