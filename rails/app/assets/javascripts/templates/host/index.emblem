= host-tab-bar selected='general'

.card-body
  table.ui.table.horizontal
    tr
      th State
      td
        .state-indicator.running
        | Running
      th Uptime
      td.usage 2 days, 13:37

    tr
      th Slug
      td project-x-37
      th CPU Usage (%)
      td.usage 12.5, 27.3

    tr
      th Region
      td US West (sfo)
      th Memory (GB)
      td.usage 0.77 / 2.00

    tr
      th Size
      td Small
      th Storage (GB)
      td.usage 3.14 / 40.00

.card-footer.bordered
  .right
    button.ui.btn.primary Restart
