= host-tab-bar selected='general' disabled=isTerminated

.card-body
  table.ui.table.horizontal
    tr
      th State
      td
        .state-indicator class={state}
        = state
      th Uptime
      td.usage
        if view.hostStatsAvailable
          = durationInWords stats.uptime
        else
          span.empty &ndash;

    tr
      th Slug
      td
        = slug
      th CPU Usage (%)
      td.usage
        if view.hostStatsAvailable
          ul.cpu-usage
            each cpuUsage in stats.perCPUUsage
              li
                = toFixed cpuUsage 1
        else
          span.empty &ndash;

    tr
      th Region
      td
        = region.name
      th
        | Memory
        span.no-text-transform &nbsp;(MiB)
      td.usage
        if view.hostStatsAvailable
          = mebibytes stats.memoryUsage
          | &nbsp;/&nbsp;
          = mebibytes stats.memoryTotal
        else
          span.empty &ndash;

    tr
      th Size
      td
        = plan.name
      th
        | Storage
        span.no-text-transform &nbsp;(GiB)
      td.usage
        if view.hostStatsAvailable
          = gibibytes stats.storageUsage
          | &nbsp;/&nbsp;
          = gibibytes stats.storageTotal
        else
          span.empty &ndash;

    tr
      th Created At
      td colspan='3'
        abbr title={view.createdAtUTC}
          = ago createdAt

.card-footer.bordered
  if isRunning
    .left
      button.ui.btn click='restart' Restart
      button.ui.btn click='stop' Stop
    .right
      button.ui.btn.primary.refresh-btn click='refresh target="view"' Refresh
  else
    if isStopped
      .left
        button.ui.btn click='showTerminateDialog target="view"' Terminate
      .right
        button.ui.btn.primary click='start' Start
    else
      if isTerminated
        .left
          button.ui.btn disabled='disabled' Terminated
      else
        .left
          button.ui.btn disabled='disabled' Please Wait...

#terminate-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        | This action&nbsp;
        strong CANNOT
        | &nbsp;be undone. This will permanently delete the&nbsp;
        strong
          = displayName
        | &nbsp;host, containers, images, volumes, and archives.
      p
        | Please type in the slug of the host&nbsp;
        strong
          |(
          = slug
          |)
        | &nbsp;to confirm:
      .ui.input-group
        Em.TextField class='focus' placeholder=slug value=view.terminateSlugConfirmation insertNewline=view.clickTerminate
    .card-footer
      .right
        button.ui.btn click='cancelTerminate target="view"' Cancel
        button.ui.btn.primary.terminate-btn click='confirmTerminate target="view"' disabled=view.terminateSlugConfirmationInvalid Terminate
