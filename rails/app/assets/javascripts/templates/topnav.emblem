.container
  ul.nav.left
    li
      link-to 'home.index'
        h1.logo Nitrous.IO
  ul.nav.right
    if App.currentUser
      li
        a href='#'
          img.gravatar src='http://gravatar.com/avatar/2ac28b22a3596136ad31d53553383d9b?s=48'
          = App.currentUser
      li.ui.dropdown
        a href='#'
          | New
          .ui.dropdown-triangle
        ul.dropdown-menu style='display: none'
          li
            link-to 'hosts.new' | New Host...
          li
            link-to 'images.new' | New Image...
          li
            link-to 'containers.new' | New Container...
      li.ui.dropdown
        a href='#'
          | Account
          .ui.dropdown-triangle
        ul.dropdown-menu.right style='display: none'
          li.disabled
            a href='#' Account Settings
          li.disabled
            a href='#' Billing
          li.separator
          li.disabled
            a href='#' Help
          li.separator
          li
            a href='#' Log Out
    else
      li
        a href='#' Features
      li
        a href='#' Enterprise
      li
        a href='#' Blog
      li.primary
        a href='#' Sign Up
      li.primary
        a href='#' Log In
