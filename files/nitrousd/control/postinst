#!/bin/bash
set -e

if [ "$1" != "configure" ]; then
  exit 0
fi

chown -R nitrousd /opt/nitrousd

if [ -x "/etc/init/nitrousd.conf" ]; then
  if [ -f "/var/run/nitrousd.pid" ]; then
    service nitrousd restart || echo "nitrousd restart failed"
  else
    service nitrousd start || echo "nitrousd start failed"
  fi
fi
