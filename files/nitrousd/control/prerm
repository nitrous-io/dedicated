#!/bin/bash

set -e

case "$1" in
    remove|deconfigure|remove-in-favour|deconfigure-in-favour)
        if [ -f /var/run/nitrousd.pid ]; then
                service nitrousd stop
        fi
	;;
    upgrade|failed-upgrade)
	;;
    *)
	echo "prerm called with unknown argument \`$1'" >&2
	;;
esac

exit 0
