ADDR=0.0.0.0
DATABASE_URL=host=/var/run/postgresql user=vagrant dbname=nitrous_development sslmode=disable
FREIGHTERD_PORT=65333

# required settings for proxying host's request
HOST_BASE_DOMAIN=.n2odev.com
HOST_PUB_CRT=/certs/n2odev.crt
HOST_PUB_KEY=/certs/n2odev.key

# require settings for proxying container's request
CONTAINER_BASE_DOMAIN=.n2odev.com
CONTAINER_PUB_CRT=/certs/n2odev.crt
CONTAINER_PUB_KEY=/certs/n2odev.crt

# this is the host domain that we should forward request to
TLS_DOMAIN=.n2odev.com
PRI_CRT=/certs/n2odevpro-ca.crt

PREVIEW_START_PORT=8000
PREVIEW_END_PORT=9000
