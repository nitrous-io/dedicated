{
  "address": ":6666",
  "librato_user": "eng+libratodev@nitrous.io",
  "librato_token": "<token-goes-here>",
  "stop_timeout": 900,
  "debug": true,
  "log_level": "debug",
  "providers": {
    "amazon": {
      "access_key": "",
      "secret_key": "",
      "host_version": "1",
      "env": "development",
      "create_timeout": "5m",
      "notify_url": "http://pro.n2odev.com:3333/api/v0/hosts/{{slug}}/freighterd_hook",
      "regions": [
        {
          "id": "us-west-2",
          "keypair": {
            "name": "hostbuilder.us-west-2.dev",
            "private_key_path": "/opt/hostbuilder/keypairs/us-west-2.pem"
          },
          "instance_pool": [
            { "type": "t2.micro", "max": 5 },
            { "type": "t2.small", "max": 2 },
            { "type": "t2.medium", "max": 1 }
          ]
        },
        {
          "id": "ap-southeast-1",
          "keypair": {
            "name": "hostbuilder.ap-southeast-1.dev",
            "private_key_path": "/opt/hostbuilder/keypairs/ap-southeast-1.pem"
          },
          "instance_pool": [
            { "type": "t2.micro", "max": 2 }
          ]
        }
      ],
      "redis": {
        "host": "localhost",
        "port": "6379"
      }
    },
    "digitalocean": {
      "token": "",
      "notify_url": "http://pro.n2odev.com:3333/api/v0/hosts/{{slug}}/freighterd_hook",
      "create_timeout": "5m"
    },
    "docker": {
      "freighterd_location": "/home/vagrant/workspace/dedicated/build/freighterd",
      "docker_location": "/usr/bin/docker",
      "registry_ca_location": "/home/nitrous/code/go/src/github.com/nitrous-io/dedicated/script/certs/n2odev.crt",
      "registry_ca_destination": "/etc/docker/certs.d/registry.n2odev.com:5000/ca.crt",
      "registry_host": "registry.n2odev.com"
    }
  },
  "queue_type": "redis",
  "rabbitmq_addr": "amqp://localhost:5672",
  "redis": {
    "host": "localhost",
    "port": "6379",
    "database": 0
  },
  "profile_dump_folder": "/tmp"
}
