#!/usr/bin/env bash
set -e

# Install ntp. It will sync in max 30 minutes since first execution
sudo apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -q -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" ntp

# Forced sync
sudo ntpdate -u 0.ubuntu.pool.ntp.org

# Add Upstart job to block access to EC2 metadata service from Docker containers.
upstart_file='/etc/init/block-ec2-metadata.conf'

if [ ! -f $upstart_file ]; then
  echo "Adding Upstart job at $upstart_file"

  cat <<'UPSTART' > $upstart_file
description "block access to EC2 metadata service"
author "root"

start on (local-filesystems and net-device-up IFACE!=lo)

console log

exec route add -host 169.254.169.254 reject
UPSTART

  sudo chmod 0644 $upstart_file
fi

sudo service block-ec2-metadata start
