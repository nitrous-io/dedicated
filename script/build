#!/usr/bin/env bash
# we get primary version from `VERSION` file
set -e
export APP=${1:?"app is required"}
export VERSION=${2:?"version is required"}
export BUILD_DIR=./build

rm -f "$BUILD_DIR/$APP"
mkdir -p "$BUILD_DIR"

goop go install -ldflags "-X main.version $VERSION" -x -v ./...
goop exec bash -c 'mv $GOBIN/$APP $BUILD_DIR/$APP'
echo "Binary built successfully: $BUILD_DIR/$APP"
