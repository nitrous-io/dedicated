#!/usr/bin/env bash
# we get primary version from `VERSION` file
set -e
export APP=${1:?"app name is required"}
# by default, we allow build to build without docker
export IN_DOCKER=${2}

NITRO_API_URL=${NITRO_API_URL:='http://127.0.0.1:3333'}
BUILD_DIR=$(pwd)/build
GIT_DIR=$(pwd)/.git
mkdir -p "$BUILD_DIR"

die() {
  echo $* && exit 1
}

# get version of an binary
get_version() {
  app=$1
  version=$(cat $app/VERSION) # get version from version file
  sha=$(git rev-list --max-count=1 --abbrev-commit HEAD -- $app)
  echo "${version}-${sha}" # 1.0.1-asdf
}

# build accepts an app name and $LDFLAGS env which can be used to define
# the app version.
#
# This also writes version info to $BUILD/$app-VERSION
build() {
  app=$1
  binary="$(basename "$app")"
  rm -f "$BUILD_DIR/$app"
  # install only the binary
  # this prevents go from looking at test-only directory
  GOBIN=$BUILD_DIR godep go install \
    -x -ldflags "$LDFLAGS" \
    github.com/nitrous-io/dedicated/$app

  # this file is useful for release to know the current version
  echo $VERSION > $BUILD_DIR/${binary}-VERSION
}

build_assets() {
  # compile the assets
  (
    cd nitrous/rails
    rm -rf ./public/assets
    bundle install
    RACK_ENV=production bundle exec rake assets:clean assets:precompile
    bundle exec rails runner -e production 'puts ActionView::Base.new(Rails::Application::Configuration.new(Rails.root).paths["app/views"]).render(template: "web_app/index")' > public/index.html
  )

  # move assets to build
  (
    rm -rf $BUILD_DIR/public
    cp -dR ./nitrous/rails/public $BUILD_DIR
    rm ./nitrous/rails/public/index.html
  )
}

# as nitro needs to be cross-compiled, it deserves a special function
# we will only allow cross-compiled to be run in docker environment.
#
# this also accepts $LDFLAGS env, which we can use to pass the
# binary's version information
xbuild_nitro() {
  app=nitro

  if [ "$BUILD_IN_DOCKER" != "true" ]; then
    die "cross compile nitro needs to be run inside docker environment"
  fi

  ARCHS="linux/amd64 darwin/amd64"

  for arch in $ARCHS; do
    build=$BUILD_DIR/$arch
    rm -rf $build
    mkdir -p $build

    arch=$arch gox \
      -osarch="${arch}" \
      -ldflags="${LDFLAGS}" \
      -output="${build}/{{.Dir}}" github.com/nitrous-io/dedicated/$app

    # this file is useful for release to know the current version
    echo $VERSION > $build/nitro-VERSION
  done
}

# shortcut for building various applications
build_freighter() {
  (
  VERSION=$(get_version freighter)
  LDFLAGS="-X main.version $VERSION"
  build "freighter/freighterd"
  )
}

build_nitro() {
  (
  VERSION=$(get_version nitro)
  LDFLAGS="\
    -X main.version ${VERSION} \
    -X main.nitrousVersion $(get_version nitrous) \
    -X main.freighterVersion $(get_version freighter) \
    -X github.com/nitrous-io/dedicated/nitro/command.DefaultAPIURL ${NITRO_API_URL} \
    "
  build "nitro"
  )
  if [ "$BUILD_IN_DOCKER" == "true" ]; then
    (
    VERSION=$(get_version nitro)
    LDFLAGS="\
      -X main.version ${VERSION} \
      -X main.nitrousdVersion $(get_version nitrous) \
      -X main.freighterdVersion $(get_version freighter) \
      -X github.com/nitrous-io/dedicated/nitro/command.DefaultAPIURL ${NITRO_API_URL} \
      "
    xbuild_nitro
    )
  fi
}

build_hostbuilder() {
  (
  VERSION=$(get_version hostbuilder)
  LDFLAGS="-X main.version ${VERSION}"
  build "hostbuilder/hostbuilder"
  )
}

build_nitrous() {
  (
  VERSION=$(get_version nitrous)
  LDFLAGS="\
    -X main.version ${VERSION} \
    -X main.nitroVersion $(get_version nitro) \
    -X main.freighterVersion $(get_version freighter) \
    "
  build "nitrous/nitrousd"
  )
  (build "nitrous/cmd/dbseed")
  (build "nitrous/cmd/hssh")
  (build "nitrous/cmd/adminuserseed")
  (build_assets)
}

if [ "$IN_DOCKER" == "true" ]; then
  tmp=$(mktemp -d /tmp/dedicated-build-XXXXX)
  # we want to mount GIT_DIR so that the docker container has read access to
  # git data
  docker run \
    --privileged=true \
    --volume $BUILD_DIR:/opt/src/github.com/nitrous-io/dedicated/build \
    --volume $GIT_DIR:/opt/src/github.com/nitrous-io/dedicated/.git:ro \
    --rm \
    -e BUILD_IN_DOCKER=true \
    -i \
    nitrousio/dedicated-dev \
    /bin/bash -c "./script/build $APP false"

  user=$(whoami)
  sudo chown -R $user:$user $BUILD_DIR
else
  if [ "$APP" == "all" ]; then
    build_freighter
    build_nitro
    build_hostbuilder
    build_nitrous
  elif [ "$APP" == "nitro" ]; then
    build_nitro
  elif [ "$APP" == "freighter" ]; then
    build_freighter
  elif [ "$APP" == "hostbuilder" ]; then
    build_hostbuilder
  elif [ "$APP" == "nitrous" ]; then
    build_nitrous
  else
    die "invalid $APP"
  fi
fi
