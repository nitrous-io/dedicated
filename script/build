#!/usr/bin/env bash
# we get primary version from `VERSION` file
set -e
export APP=${1:?"app name is required"}
# by default, we allow build to build without docker
export IN_DOCKER=${2}

BUILD_DIR=$(pwd)/build
GIT_DIR=$(pwd)/.git
RAILS_TMP=$(pwd)/nitrous/rails/tmp
mkdir -p "$BUILD_DIR"

die() {
  echo $* && exit 1
}

CLOUDFRONT_ENDPOINT=${CLOUDFRONT_ENDPOINT:=disabled}

# get version of an binary
BUILD_NUMBER=${BUILD_NUMBER:=0}

get_version() {
  app=$1
  version=$(cat $app/VERSION) # get version from version file
  sha=$(git rev-list --max-count=1 --abbrev-commit HEAD)

  if [[ "$app" == "freighter" ]]; then
    timestamp=$(date +"%s")
    echo "${version}+${timestamp}-${BUILD_NUMBER}-${sha}"
  else
    echo "${version}-${sha}" # 1.0.1-asdf
  fi
}

# build accepts an app name and $LDFLAGS env which can be used to define
# the app version.
#
# This also writes version info to $BUILD/$app-VERSION
build() {
  pkgs=""
  for app in $@; do
    pkgs+=" github.com/nitrous-io/dedicated/$app"
    rm -f "$BUILD_DIR/$app"
  done

  # install only the binary
  # this prevents go from looking at test-only directory
  GOBIN=$BUILD_DIR godep go install \
    -ldflags "$LDFLAGS" \
    $pkgs

  for app in $@; do
    binary="$(basename "$app")"
    # this file is useful for release to know the current version
    echo $VERSION > $BUILD_DIR/${binary}-VERSION
    # this file is useful for chef version attribute overrides
    echo "{ \"$binary\": { \"version\": \"$VERSION\" } }" > $BUILD_DIR/${binary}-VERSION.json
  done
}

build_assets() {
  # compile the assets
  (
    rm -rf "$BUILD_DIR"/public
    cd nitrous/rails
    rm -rf ./public/assets
    bundle install
    RACK_ENV=production bundle exec rake assets:clean assets:precompile
    RACK_ENV=production bundle exec rake build:generate_views BUILD_DIR=$BUILD_DIR
  )

  # move assets to build
  (
    mv ./nitrous/rails/public/assets "$BUILD_DIR"/public
  )
}

# shortcut for building various applications
build_freighter() {
  (
  VERSION=$(get_version freighter)
  LDFLAGS="-X main.version $VERSION"
  build "freighter/freighterd"
  )
}

build_hostbuilder() {
  (
  VERSION=$(get_version hostbuilder)
  LDFLAGS="-X main.version ${VERSION}"
  build "hostbuilder/hostbuilder"
  )
}

build_compass() {
  (
  VERSION=$(get_version compass)
  LDFLAGS="-X main.version ${VERSION}"
  build "compass/compass"
  )
}

build_tender() {
  (
  VERSION=$(get_version tender)
  LDFLAGS="-X main.version ${VERSION}"
  build "tender/tender"
  )
}

build_nitrous() {
  (
  VERSION=$(get_version nitrous)
  LDFLAGS="\
    -X main.version ${VERSION} \
    -X main.freighterVersion $(get_version freighter) \
    "
  build "nitrous/nitrousd" \
    "nitrous/cmd/dbseed" \
    "nitrous/cmd/stripeseed" \
    "nitrous/cmd/hssh" \
    "nitrous/cmd/adminuserseed" \
    "nitrous/cmd/createinvitecodes" \
    "nitrous/cmd/populatehosttransitions" \
    "nitrous/cmd/biller" \
    "nitrous/cmd/removeexpiredtokens" \
    "nitrous/cmd/engagement" \
    "nitrous/cmd/migrate" \
    "nitrous/cmd/hostshutdown" \
    "nitrous/cmd/populatemxprofiles" \
    "nitrous/cmd/healthcheck" \
    "nitrous/cmd/hostautoterminate" \
    "nitrous/cmd/idlefreehosts"
  )
  if [ "$ENV" != "development" ]; then
    (build_assets)
  fi
}

if [ "$IN_DOCKER" == "true" ]; then
  tmp=$(mktemp -d /tmp/dedicated-build-XXXXX)

  # Ensure tmp folder is created as we want to speed up assets pipeline.
  [[ ! -d $RAILS_TMP ]] && mkdir -p $RAILS_TMP

  # we want to mount GIT_DIR so that the docker container has read access to
  # git data
  docker run \
    --privileged=true \
    --volume $BUILD_DIR:/opt/src/github.com/nitrous-io/dedicated/build \
    --volume $GIT_DIR:/opt/src/github.com/nitrous-io/dedicated/.git:ro \
    --volume $RAILS_TMP:/opt/src/github.com/nitrous-io/dedicated/nitrous/rails/tmp \
    --rm \
    -e BUILD_IN_DOCKER=true \
    -e BUILD_NUMBER=$BUILD_NUMBER \
    -e CLOUDFRONT_ENDPOINT=$CLOUDFRONT_ENDPOINT \
    -i \
    nitrousio/dedicated-dev \
    /bin/bash -c "./script/build $APP false"

  user=$(whoami)
  if [[ "$user" != "jenkins" ]]; then
    sudo chown -R $user:$user $BUILD_DIR
  fi
else
  if [ "$APP" == "all" ]; then
    build_freighter
    build_hostbuilder
    build_compass
    build_tender
    build_nitrous
  elif [ "$APP" == "freighter" ]; then
    build_freighter
  elif [ "$APP" == "hostbuilder" ]; then
    build_hostbuilder
  elif [ "$APP" == "compass" ]; then
    build_compass
  elif [ "$APP" == "tender" ]; then
    build_tender
  elif [ "$APP" == "nitrous" ]; then
    build_nitrous
  else
    die "invalid $APP"
  fi
fi
