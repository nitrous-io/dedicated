#!/usr/bin/env bash
# we get primary version from `VERSION` file
set -e

REVISION=$(git rev-parse --short HEAD)
VERSION="$(cat VERSION)-$REVISION"

APP=freighter
PACKAGE=github.com/nitrous-io/$APP
BUILD=$(pwd)/build

mkdir -p $BUILD

GOBIN=$BUILD go install -x -ldflags "-X main.version ${VERSION}" -v $PACKAGE/...
