#!/usr/bin/env bash
# Setup the shell environment suitable for running build etc...
set -e

APP=${1:?"app name is required"}
VERSION=${2:?"version is required"}

echo "installing dependencies..."

go get github.com/nitrous-io/goop
goop install

ARTIFACT_DIR=/tmp/$APP/$VERSION

ARCHS="linux/amd64 linux/386 darwin/amd64 darwin/386"
BUILD=$ARTIFACT_DIR/"{{.Dir}}_{{.OS}}_{{.Arch}}"
 
gox -osarch="${ARCHS}" -ldflags="-X main.version ${VERSION}" -output="${BUILD}" ./...
