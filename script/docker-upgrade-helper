#!/usr/bin/env bash
set -e 

for L in nitrousio.list docker.io.list; do
        DEBIAN_FRONTEND=noninteractive apt-get update -y -o Dir::Etc::sourcelist="sources.list.d/${L}" -o Dir::Etc::sourceparts="-" -o APT::Get::List-Cleanup="0"
done

DEBIAN_FRONTEND=noninteractive apt-get -yy install lxc-docker-1.3.1
DEBIAN_FRONTEND=noninteractive apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" freighterd

service docker restart
service freighterd restart
