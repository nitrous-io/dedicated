#!/usr/bin/env bash
# Runs benchmarks inside a docker container.
set -e
PKG=${1}
PATTERN=${2}

if [[ -z $DOCKER_BIN ]]; then
  docker run \
    --privileged=true \
    --rm \
    --env IN_DOCKER=true \
    nitrousio/dedicated-dev:latest /bin/bash -c "./script/benchmark $PKG $PATTERN"
else
  docker run \
    --privileged=true \
    --rm \
    --volume "$DOCKER_BIN":/usr/bin/docker \
    --env IN_DOCKER=true \
    nitrousio/dedicated-dev:latest /bin/bash -c "./script/benchmark $PKG $PATTERN"
fi
