#!/usr/bin/env bash

VERSION=${1:?"version is required"}
APP=freighter

docker run \
  --privileged \
  --rm=true \
  --volume $(pwd):/opt/src/github.com/nitrous-io/$APP \
  --volume $(readlink -f $SSH_AUTH_SOCK):/ssh-agent \
  -e SSH_AUTH_SOCK=/ssh-agent \
  freighter:$VERSION script/docker-build $VERSION
