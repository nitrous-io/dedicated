#!/usr/bin/env bash
# we get primary version from `VERSION` file
set -e

mkdir -p $(pwd)/build

VERSION=${1:?"version is required"}

ARCHS="linux/amd64 linux/386 darwin/amd64 darwin/386"
BUILD=$(pwd)/build/"{{.Dir}}_{{.OS}}_{{.Arch}}"
GOPATH=$(pwd)/.vendor:$GOPATH

gox -osarch="${ARCHS}" -ldflags="-X main.version ${VERSION}" -output="${BUILD}" ./...
