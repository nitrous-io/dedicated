#!/usr/bin/env bash
# create .deb file for freighterd
#
# This requires the binary to be built and placed into ./build

PKGNAME="freighterd"
PKGVERSION="$1"
PACKAGE_URL="http://nitrous.io/"
PACKAGE_ARCHITECTURE="$(dpkg-architecture -qDEB_HOST_ARCH)"
PACKAGE_DESCRIPTION="Nitrous.IO HTTP frontend for docker"
PACKAGE_LICENSE="Private"

BUILD=$WORKDIR/build # where we store freighterd binary
FILES=$WORKDIR/files/$PKGNAME # where we store configuration files
PKGDIR=/opt/$PKGNAME/build # /opt/freighterd/build is mapped to $HOME/build on the host

echo "PKGDIR: $PKGDIR"

bundle() {
  rm -rf $PKGDIR
  mkdir -p $PKGDIR

  # install our freighterd configuration
  install -m 0644 -D $FILES/data/etc/init/freighterd.conf $PKGDIR/etc/init/freighterd.conf

  # docker settings that we want
  install -m 0644 -D $FILES/data/etc/default/docker $PKGDIR/etc/default/freighter-docker

  # install our freighterd binary
  install -m 0755 -D $BUILD/freighterd $PKGDIR/usr/sbin/freighterd

  # TODO: we wants --depends docker.io too
  (
  cd $PKGDIR

  fpm \
    -s dir \
    -C $PKGDIR \
    --name $PKGNAME-$PKGVERSION \
    --version $PKGVERSION \
    --architecture "$PACKAGE_ARCHITECTURE" \
    --prefix / \
    --description "$PACKAGE_DESCRIPTION" \
    --maintainer "$PACKAGE_MAINTAINER" \
    --provides $PKGNAME \
    --replaces $PKGNAME \
    --depends lxc \
    --before-install $FILES/control/preinst \
    --after-install $FILES/control/postinst \
    --before-remove $FILES/control/prerm \
    --config-files /etc/init/freighterd.conf \
    --config-files /etc/default/freighter-docker \
    --deb-compression gz \
    -t deb .

  fpm -s empty \
    --name $PKGNAME \
    --version $PKGVERSION \
    --architecture "$PACKAGE_ARCHITECTURE" \
    --depends $PKGNAME-$PKGVERSION \
    --description "$PACKAGE_DESCRIPTION" \
    --maintainer "$PACKAGE_MAINTAINER" \
    --url "$PACKAGE_URL" \
    --license "$PACKAGE_LICENSE" \
    --deb-compression gz \
    -t deb
  )

  # cleanup the build directory
  rm -rf $PKGDIR/etc
  rm -rf $PKGDIR/usr
  rm -rf $PKGDIR/var
  rm -rf $PKGDIR/lib
}

bundle
