#!/usr/bin/env bash
set -x
set -e

APP=${1:?"app name is required"}
VERSION=${2:?"version is required"}
ARTIFACT_DIR=/tmp/$APP/$VERSION/darwin/amd64

# OSX package
OSX_ARCH="darwin_amd64"
OSX_PKG=${APP}-${VERSION}-${OSX_ARCH}.tar.gz
OSX_BUCKET=osx.nitrous.io

cd $ARTIFACT_DIR
tar -zvcf ${OSX_PKG} ${APP}

s3cmd --access_key=$ACCESS_KEY --secret_key=$SECRET_KEY --acl-public put ${ARTIFACT_DIR}/${OSX_PKG} s3://${OSX_BUCKET}/${OSX_PKG}
s3cmd --access_key=$ACCESS_KEY --secret_key=$SECRET_KEY --acl-public put ${ARTIFACT_DIR}/${OSX_PKG} s3://${OSX_BUCKET}/${APP}-latest-${OSX_ARCH}.tar.gz

