#!/usr/bin/env bash
#Setup the shell environment suitable for running tests etc...

# start docker daemon
if which docker >/dev/null; then
  docker -d -e lxc >& /var/log/docker.log &
fi

echo "waiting for docker to start"
sleep 1

echo "pulling ubuntu-upstart:trusty for test"
docker pull ubuntu-upstart:trusty

export GOBIN=$(pwd)/_vendor/bin
mkdir -p $GOBIN
if [ ! -f $GOBIN/ginkgo ]; then
  echo "dont have ginkgo binary. Installing now"
  go get github.com/onsi/ginkgo/ginkgo
fi

export PATH=$GOBIN:$PATH

exec /bin/bash
