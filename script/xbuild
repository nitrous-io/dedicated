#!/usr/bin/env bash
set -e

rm -rf $(pwd)/build
mkdir -p $(pwd)/build
export APP=${1:?"app is required"}
export VERSION=${2:?"version is required"}
export NITRO_API_URL=${3:-http://127.0.0.1:3333}
ARCHS="linux/amd64 darwin/amd64"

for arch in $ARCHS; do
  export BUILD=$(pwd)/build/$arch
  mkdir -p $BUILD
  arch=$arch goop exec gox -osarch="${arch}" -ldflags="-X main.version ${VERSION} -X command.DefaultAPIURL ${NITRO_API_URL}" -output="${BUILD}/{{.Dir}}" ./...
done
