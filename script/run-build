#!/usr/bin/env bash

APP=freighter
REVISION=$(shell git rev-parse --short HEAD)
BASE_VERSION=$(shell cat VERSION)
VERSION=$(BASE_VERSION)-$(REVISION)

script/make-image

docker run \
  --privileged \
  --rm=true \
  --volume $(pwd):/opt/src/github.com/nitrous-io/$APP \
  registry.nitrous.io/$APP script/build $VERSION
