#!/usr/bin/env bash
# Runs tests inside a docker container. This will not build the
# binary. Call other jobs if you want to do that.
set -e
APP=${1:?"app name is required"}

killContainer() {
	if [ -n "$cid" ]; then
		echo "Killing and removing Docker container '$cid'"
		docker rm --volumes --force $cid >/dev/null
	fi
}

# We do this to make sure the Docker container is properly cleaned up upon exit.
trap killContainer EXIT

# if APP is shell, then we just launch a shell inside the current container
if [[ "$APP" = "shell" ]]; then
	if [[ -z $DOCKER_BIN ]]; then
		exec docker run \
			--privileged=true \
			--rm \
			--volume $(pwd):/opt/src/github.com/nitrous-io/dedicated \
			-it \
			nitrousio/dedicated-dev:latest /bin/bash -c "./script/test $APP"
	else
		exec docker run \
			--privileged=true \
			--rm \
			--volume $(pwd):/opt/src/github.com/nitrous-io/dedicated \
			--volume "$DOCKER_BIN":/usr/bin/docker \
			-it \
			nitrousio/dedicated-dev:latest /bin/bash -c "./script/test $APP"
	fi
else
	SUITE=${3}

	if [[ -z $DOCKER_BIN ]]; then
		cid=$(docker run \
			--detach \
			--privileged=true \
			--env IN_DOCKER=true \
			nitrousio/dedicated-dev:latest /bin/bash -c "./script/test $APP $SUITE")
	else
		cid=$(docker run \
			--detach \
			--privileged=true \
			--volume "$DOCKER_BIN":/usr/bin/docker \
			--env IN_DOCKER=true \
			nitrousio/dedicated-dev:latest /bin/bash -c "./script/test $APP $SUITE")
	fi

	echo "Running tests in container '$cid'"

	docker attach --no-stdin=true --sig-proxy=false $cid
fi
