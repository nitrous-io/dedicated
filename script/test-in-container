#!/usr/bin/env bash
# Runs tests inside a docker container. This will not build the
# binary. Call other jobs if you want to do that.
set -e
APP=${1:?"app name is required"}

# if APP is shell, then we just launch a shell inside the current container
if [[ "$APP" = "shell" ]]; then
	if [[ -z $DOCKER_BIN ]]; then
		exec docker run \
			--privileged=true \
			--rm \
			--volume $(pwd):/opt/src/github.com/nitrous-io/dedicated \
			-it \
			nitrousio/dedicated-dev:latest /bin/bash -c "./script/test $APP"
	else
		exec docker run \
			--privileged=true \
			--rm \
			--volume $(pwd):/opt/src/github.com/nitrous-io/dedicated \
			--volume "$DOCKER_BIN":/usr/bin/docker \
			-it \
			nitrousio/dedicated-dev:latest /bin/bash -c "./script/test $APP"
	fi
else
  SUITE=${3}

	if [[ -z $DOCKER_BIN ]]; then
		docker run \
			--privileged=true \
			--rm \
			--env IN_DOCKER=true \
			nitrousio/dedicated-dev:latest /bin/bash -c "./script/test $APP $SUITE"
	else
		docker run \
			--privileged=true \
			--rm \
			--volume "$DOCKER_BIN":/usr/bin/docker \
			--env IN_DOCKER=true \
			nitrousio/dedicated-dev:latest /bin/bash -c "./script/test $APP $SUITE"
	fi
fi
