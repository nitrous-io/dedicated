#!/usr/bin/env bash
# Runs tests inside a docker container. This will not build the
# binary. Call other jobs if you want to do that.
set -e
APP=${1:?"app name is required"}

# if APP is shell, then we just launch a shell inside the current container
if [[ "$APP" = "shell" ]]; then
  exec docker run \
    --privileged=true \
    --rm \
    --volume $(pwd):/opt/src/github.com/nitrous-io/dedicated \
    -it \
    nitrousio/dedicated-dev:$VERSION /bin/bash -c "./script/test $APP"
else
  VERSION=${2="latest"}
  SUITE=${3}

  docker run \
    --privileged=true \
    --rm \
    nitrousio/dedicated-dev:$VERSION /bin/bash -c "./script/test $APP $SUITE"
fi
