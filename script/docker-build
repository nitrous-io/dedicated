#!/bin/bash
set -e

APP=${1:?"app is required"}
VERSION=${2:?"version is required"}
ARTIFACT_DIR=/tmp/$APP/$VERSION

echo "installing dependencies..."
rm -rf .vendor
rm $(which goop)
go get github.com/nitrous-io/goop
goop install

# echo "running tests..."
# goop exec forego run ginkgo -r -trace -keepGoing

echo "compiling ${APP} go app..."
rm -f "$ARTIFACT_DIR/nitrousd"
goop go install -x -v ./...
BUILD_DIR=$ARTIFACT_DIR goop exec bash -c 'cp $GOBIN/nitrousd $BUILD_DIR/nitrousd'
BUILD_DIR=$ARTIFACT_DIR goop exec bash -c 'cp $GOBIN/dbseed $BUILD_DIR/dbseed'

echo "rendering web files... "
cd rails
rm -rf ./public/assets
bundle install
RACK_ENV=production bundle exec rake assets:clean assets:precompile
bundle exec rails runner -e production 'puts ActionView::Base.new(Rails::Application::Configuration.new(Rails.root).paths["app/views"]).render(template: "web_app/index")' > public/index.html
cd ..

rm -rf "$ARTIFACT_DIR"/public
cp -dR ./rails/public "$ARTIFACT_DIR"
