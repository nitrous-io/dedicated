#!/usr/bin/env bash
# Setup the shell environment suitable for running build etc...
set -e

VERSION=${1:?"version is required"}
BUILD=$(pwd)/build
mkdir -p $BUILD

echo "installing dependencies..."
rm -rf /opt/src/github.com/nitrous-io/freighter/.vendor

go get github.com/nitrous-io/goop
goop install

goop go install -x -ldflags "-X main.version ${VERSION}" -v \
  github.com/nitrous-io/freighter/freighterd
