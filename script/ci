#!/bin/bash

APP=${1:?"app name is required"}
VERSION=${2:?"version is required"}
NITRO_API_URL=${3:-http://127.0.0.1:3333}

ARTIFACT_DIR=/tmp/$APP/$VERSION
rm -rf $ARTIFACT_DIR
mkdir -p $ARTIFACT_DIR
BIN_DIR=/opt/src/github.com/nitrous-io/$APP/build

rm -rf $ARTIFACT_DIR
mkdir -p $ARTIFACT_DIR
tmp=$(mktemp -d /tmp/docker_XXXXX)

docker run \
  --cidfile $tmp/$APP \
  -v $(readlink -f $SSH_AUTH_SOCK):/ssh-agent \
  -e SSH_AUTH_SOCK=/ssh-agent \
  $APP:$VERSION /bin/bash -c "./script/install-deps && ./script/test && ./script/xbuild $APP $VERSION $NITRO_API_URL"

cid=$(cat $tmp/$APP)
docker cp $cid:$BIN_DIR/linux $ARTIFACT_DIR
docker cp $cid:$BIN_DIR/darwin $ARTIFACT_DIR
