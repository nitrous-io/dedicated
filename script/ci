#!/usr/bin/env bash
# script/ci run tests inside a docker container. This will not build the
# binary. Call other jobs if you want to do that
set -e
APP=${1:?"app name is required"}
REVISION=${2="latest"}

docker run \
  --privileged=true \
  --rm \
  nitrousio/dedicated-dev:$REVISION /bin/bash -c "./script/test $APP"
