#!/usr/bin/env bash
set -e

APP=${1:?"app is required"}
VERSION=${2:?"version is required"}
BUCKET=nitrous-dedicated

ARTIFACT_DIR=/tmp/$APP/$VERSION
cd $ARTIFACT_DIR

if [[ -f "hostbuilder-${VERSION}.tgz" || -f "hostbuilder-latest.tgz" ]]; then
        echo "Uploading binary packages to s3... "
        s3cmd put hostbuilder-${VERSION}.tgz s3://${BUCKET}/hostbuilder-${VERSION}.tgz
        s3cmd put hostbuilder-latest.tgz s3://${BUCKET}/hostbuilder-latest.tgz
else
        echo "Failed to find package: $VERSION in ${ARTIFACT_DIR} directory."
        exit 1
fi
