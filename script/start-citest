#!/usr/bin/env bash
#Setup the shell environment suitable for running tests etc...

echo "installing dependencies..."
go get github.com/nitrous-io/goop
goop install

# start docker daemon
echo "starting docker daemon..."
if which docker >/dev/null; then
  docker -d -e lxc >& /var/log/docker.log &
fi

echo "Running tests..."
goop exec ginkgo -r -trace -keepGoing
