#!/usr/bin/env bash
# this runs the test locally, which assumes that the setup is done correctly
# because we are not running inside a docker container
export APP=${1:="all"}
export SUITE=${2}
export GOPATH=$(godep path):$GOPATH
RESULT="passed"

# install ginkgo
godep go install github.com/onsi/ginkgo/ginkgo

cleanup_container() {
  unset FREIGHTERD_BASE DOCKER_IP DOCKER_HOST
  docker stop $1 >/dev/null
  docker rm --volumes=true $cid >/dev/null
}

die() {
  echo $* && exit 1
}

# run spawn a function runs inside a subshell and record its error status
run() {
  cmd=$1
  shift
  ($cmd $@)
  if [[ "$?" == "1" ]]; then
    RESULT="failed"
  fi
}

test_app() {
  app=$1
  shift
  if [ ! -d $app ]; then
    die "Incorrect app: $app"
  fi
  echo "===> Running test for $app"
  cd $app

  if [ -f .env-example ]; then
    forego run -e .env-example ginkgo -r -trace $@
  else
    ginkgo -r -trace $@
  fi
}

test_db() {
  echo "===> Starting database dependencies"
  sudo service postgresql restart
  test_app $@
}

test_dind() {
  test -f /var/run/docker.pid || docker -d >& /var/log/docker.log &
  while test ! -f /var/run/docker.pid; do sleep 1; done

  version='1.3.0'
  echo "checking nitrousio/dind:$version ....."
  docker images | grep nitrousio/dind | grep $version
  if [ $? -ne 0 ]; then
    echo "updating nitrousio/dind:$version ....."
    docker pull nitrousio/dind:$version >/dev/null 2>&1 || die "image nitrousio/dind:$version does not exist"
  fi
  echo "nitrousio/dind:$version is up to date ..."

  # nitrousio/dind is built from https://github.com/nitrousio/dind
  tmp=$(mktemp -d /tmp/docker_XXXXX)
  cid=$(docker run --privileged --net=host -d -v $tmp:$tmp -e PORT=4444 nitrousio/dind:$version)
  ip=$(docker inspect --format '{{ .NetworkSettings.IPAddress }}' $cid)

  trap "cleanup_container $cid" EXIT

  # run test
  export FREIGHTERD_BASE=$tmp
  export DOCKER_IP=$ip
  export DOCKER_HOST=tcp://$ip:4444
  test_app $@
}

if [ "$APP" == "all" ]; then
  run test_app nitro
  run test_app hostbuilder
  run test_db nitrous
  run test_dind freighter
  run test_db tender
  run test_db compass
elif [ "$APP" == "hostbuilder" ]; then
  run test_app hostbuilder $SUITE
elif [ "$APP" == "freighter" ]; then
  run test_dind freighter $SUITE
elif [ "$APP" == "tender" ]; then
  run test_db tender $SUITE
elif [ "$APP" == "compass" ]; then
  run test_db compass $SUITE
elif [ "$APP" == "nitrous" ]; then
  run test_db nitrous $SUITE
else
  run test_app $APP $SUITE
fi

if [[ "$RESULT" == "failed" ]]; then
  die "one or more test suites failed"
fi
