#!/usr/bin/env bash
tmp=$(mktemp -d /tmp/docker_XXXXX)

cleanup() {
  (docker stop $cid && docker rm $cid) >/dev/null
}

die() {
  echo $* && exit 1
}

test -f /var/run/docker.pid || docker -d -e lxc >& /var/log/docker.log &
while test ! -f /var/run/docker.pid; do sleep 1; done
version=$(docker version | grep 'Client version' | cut -d':' -f2 | tr -d ' ')
echo "checking ddollar/dind:$version ....."
docker images | grep ddollar/dind | grep $version
if [ $? -ne 0 ]; then
  echo "updating ddollar/dind:$version ....."
  docker pull ddollar/dind:$version >/dev/null 2>&1 || die "image ddollar/dind:$version does not exist"
fi
echo "ddollar/dind:$version is up to date ..."

# ddollar/dind is built from https://github.com/jpetazzo/dind
cid=$(docker run --privileged -d -v $tmp:$tmp -e PORT=4444 ddollar/dind:$version)
ip=$(docker inspect --format '{{ .NetworkSettings.IPAddress }}' $cid)

trap cleanup EXIT

env FREIGHTERD_BASE=$tmp DOCKER_IP=$ip DOCKER_HOST=tcp://$ip:4444 goop exec ginkgo -r -trace -keepGoing -noisyPendings=false $*
