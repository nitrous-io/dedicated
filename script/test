#!/usr/bin/env bash
# this runs the test locally, which assumes that the setup is done correctly
# because we are not running inside a docker container
export APP=${1:="all"}
export SUITE=${2}
export GOPATH=$(godep path):$GOPATH

# install ginkgo
godep go install github.com/onsi/ginkgo/ginkgo

die() {
  echo $* && exit 1
}

# run spawn a function runs inside a subshell and record its error status
run() {
  cmd=$1
  shift
  ($cmd $@)
  if [[ "$?" == "1" ]]; then
    die 'One or more tests have failed'
  fi
}

test_app() {
  app=$1
  shift
  if [ ! -d $app ]; then
    die "Incorrect app: $app"
  fi
  echo "===> Running tests for $app"
  cd $app

  export TESTING=1
  if [ -f .env-example ]; then
    forego run -e .env-example ginkgo -r -trace -noColor -slowSpecThreshold=2 $@
  else
    ginkgo -r -trace $@
  fi
}

test_db() {
  echo "===> Starting database dependencies"
  sudo service postgresql restart
  test_app $@
}

test_redis_queue() {
  echo "===> Starting redis dependencies"
  sudo service redis_6379 restart
  test_app $@
}

test_queue() {
  echo "===> Starting redis dependencies"
  sudo service redis_6379 restart

  test_app $@
  local code=$?
  return $code
}

test_db_and_redis_queue() {
  echo "===> Starting database dependencies"
  sudo service postgresql restart

  echo "===> Starting redis dependencies"
  sudo service redis_6379 restart
  test_app $@
}

test_with_docker() {
  echo "===> Starting Docker daemon"
  sudo service docker start
  test_app $@
}

if [ "$APP" == "all" ]; then
  run test_queue pkg
  run test_redis_queue hostbuilder
  run test_db_and_redis_queue nitrous
  run test_with_docker freighter
  run test_db tender
  run test_db compass
elif [ "$APP" == "hostbuilder" ]; then
  run test_redis_queue hostbuilder $SUITE
elif [ "$APP" == "freighter" ]; then
  run test_with_docker freighter $SUITE
elif [ "$APP" == "tender" ]; then
  run test_db tender $SUITE
elif [ "$APP" == "compass" ]; then
  run test_db compass $SUITE
elif [ "$APP" == "nitrous" ]; then
  run test_db_and_redis_queue nitrous $SUITE
elif [ "$APP" == "pkg" ]; then
  run test_queue pkg $SUITE
elif [ "$APP" == "shell" ]; then
  # start necessary service and launch the shell
  echo "===> Starting Docker daemon"
  sudo service docker start
  echo "===> Starting database dependencies"
  sudo service postgresql restart
  echo "===> Starting redis dependencies"
  sudo service redis_6379 start
  exec /bin/bash
else
  run test_app $APP $SUITE
fi
