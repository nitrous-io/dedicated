#!/usr/bin/env bash
set -e

VERSION=${1:?"version is required"}
APP=freighter

mkdir -p $(pwd)/build
mkdir -p $HOME/build

# we only link the build directory as that will be used to store the build
# output
docker run \
  --privileged \
  --volume $HOME/build:/opt/freighterd/build \
  --volume $(pwd):/opt/src/github.com/nitrous-io/$APP \
  registry.nitrous.io/$APP ./script/release $VERSION
