#!/usr/bin/env bash
set -e
set -x

HOSTSFILE=${1:?"First argument is the host file. A host per line."}
SCRIPT=${2:?"Second argument is the script to be run in the remote host."}
SCRIPTBASE=`basename $SCRIPT`
RUN_LOG=/tmp/hssh-run.log
REMOTESCRIPT=/tmp/$SCRIPTBASE

die() {
        echo $@ && exit 1
}

check_file() {
       local F=$1
       [[ ! -f $F ]] && die "Error: supplied argument $F not a file." || true
}

check_file $HOSTSFILE
check_file $SCRIPT

[[ ! -x ./build/hssh && ! -f ./build/hssh ]] && (echo "You need to build the hssh tool. Try make nitrous." && exit 1)

[[ -f ${RUN_LOG} ]] || touch ${RUN_LOG}

for HOST in `cat $HOSTSFILE`; do
  echo "$(date +%Y%m%d%H%M%S) ######## ${HOST} ########" | tee -a ${RUN_LOG}
  ./build/hssh upload ${HOST} $SCRIPT:$REMOTESCRIPT | tee -a ${RUN_LOG} 
  ./build/hssh run ${HOST} "chmod 755 $REMOTESCRIPT && bash -c $REMOTESCRIPT" | tee -a ${RUN_LOG}
done
