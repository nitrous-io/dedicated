#!/bin/bash
set -e

APP=${1:?"app is required"}
VERSION=${2:?"version is required"}

ARTIFACT_DIR=/tmp/$APP/$VERSION

go get github.com/nitrous-io/goop
rm -rf .vendor

goop install
goop exec ginkgo -r -trace -keepGoing

VERSION=$VERSION goop go install -x -ldflags "-X main.version ${VERSION}" -v ./...
BUILD_DIR=$ARTIFACT_DIR goop exec bash -c 'cp $GOBIN/hostbuilder $BUILD_DIR/hostbuilder'
