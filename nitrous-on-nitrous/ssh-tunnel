  #!/usr/bin/env ruby

require 'uri'

if ARGV.size == 0
  puts "usage: ssh-tunnel <SSH_URL>"
  exit 2
end

ssh_url=ARGV[0]
uri = URI.parse(ssh_url)
raise "ssh url required" if uri.scheme != 'ssh' || !uri.port || !uri.host

user = uri.user || 'nitrous'

forwarded_ports = [7000]
forwarded_ports.concat (32768..32800).to_a
forward = forwarded_ports.map { |o| "-L #{o}:localhost:#{o}" }.join ' '

cmd = """ssh \
-N -v \
-o TCPKeepAlive=yes \
-o ServerAliveInterval=60 \
-o UserKnownHostsFile=/dev/null \
-o StrictHostKeyChecking=no \
-o PreferredAuthentications=publickey \
-o ExitOnForwardFailure=yes \
-p #{uri.port} \
#{user}@#{uri.host} \
#{forward}
"""

exec(cmd)
