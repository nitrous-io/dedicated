map $http_upgrade $connection_upgrade {
	default upgrade;
	''      close;
}

server {
	listen 7000 ssl default_server;

	ssl_certificate /etc/nginx/certs/n2odev.crt;
	ssl_certificate_key /etc/nginx/certs/n2odev.key;

	server_name www.n2odev.com;

	location / {
		proxy_pass http://127.0.0.1:4000;
	}

	# Comment out above location block and comment in this one to work on
	# legacy ember app or IDE
	# location / {
	# 	proxy_pass http://127.0.0.1:3000;
	# }

	location /api/v0/ {
		proxy_pass http://127.0.0.1:3333;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
	}
}
