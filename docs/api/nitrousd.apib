                    "gateway_ip": "172.17.42.1",
                    "state": "running",
                    "config": {
                        "cmd": [
                            "/sbin/init",
                            "--default-console",
                            "none"
                        ],
                        "env": [
                            "__HOST=172.17.42.1",
                            "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                            "container=docker",
                            "NITROUS_IMAGE_VERSION=2",
                            "NITROUS_USERNAME=nitrous",
                            "NITROUS_SSH_ENABLED=true",
                            "NITROUS_README_URL=https://nitrous-readmes.s3.amazonaws.com/ubuntu.2015-03-02.html"
                        ],
                        "port": [
                            "public:32768:22/tcp"
                        ],
                        "config_port_bindings": [
                            "public::22/tcp"
                        ],
                        "volume": [],
                        "privileged": false,
