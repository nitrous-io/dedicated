#!/bin/bash
export APP=${1:?"app name is required"}
export VERSION=${2:?"version is required"}

ARTIFACT_DIR=/tmp/$APP/$VERSION
rm -rf $ARTIFACT_DIR
mkdir -p $ARTIFACT_DIR
tmp=$(mktemp -d /tmp/docker_XXXXX)

docker run \
  --privileged=true \
  --cidfile $tmp/$APP \
  --net=host \
  -v $(readlink -f $SSH_AUTH_SOCK):/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent \
  $APP:$VERSION /bin/bash -c "./script/install-deps ./script/test && ./script/build $APP $VERSION"

cid=`cat $tmp/$APP`
docker cp $cid:/opt/src/github.com/nitrous-io/dedicated/freighter/build/$APP $ARTIFACT_DIR/
