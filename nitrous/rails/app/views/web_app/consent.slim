- content_for :head_stylesheet
  = stylesheet_link_tag 'consent', media: 'all'
  sass:
    html
      background: #2a3239

.container
  .ui.card
    .card-header.bordered
      h2 Authorize Application
    .card-body.bordered.hide#client-info
      p
        | Hello,
        span#username
      p
        span#client-name
        |  would like permission to access your container

      form method='POST' action='/api/v0/oauth/authorize' enctype='application/x-www-form-urlencoded'
        .ui.input-group
          input#access-token type='hidden' name='access_token'
          input#state type='hidden' name='state'
          input#client-id type='hidden' name='client_id'
          input#redirect-uri type='hidden' name='redirect_uri'
          input type='hidden' name='response_type' value='code'

          button.ui.btn type='submit' name='action' value='approve'
            | Approve
          button.ui.btn type='submit' name='action' value='decline'
            | Decline

- content_for :body_script
  = javascript_include_tag 'consent'
