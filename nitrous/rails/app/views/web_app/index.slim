doctype 5
html lang='en'
  head
    meta charset='utf-8'
    title Nitrous
    link rel='shortcut icon' href='/favicon.ico'
    = stylesheet_link_tag 'application', media: 'all'
  body
    #app
    = javascript_include_tag 'jquery'
    = javascript_include_tag 'application'
    javascript:
      App.set('terminalJsPath','#{javascript_path "terminal"}')
      App.set('terminalCssPath','#{stylesheet_path "terminal"}')
