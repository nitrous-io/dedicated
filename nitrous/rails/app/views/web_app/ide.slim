doctype 5
html lang='en'
  head
    meta charset='utf-8'
    title Nitrous IDE
    link rel='shortcut icon' href='/favicon.ico'
    = stylesheet_link_tag 'application', media: 'all'

    = render 'layouts/google_analytics'
  body
    #app
    = javascript_include_tag 'jquery'
    = javascript_include_tag 'ide/application'
    = javascript_include_tag 'ide/app'
    javascript:
      App.bootstrap()
    = render 'web_app/livechat'
