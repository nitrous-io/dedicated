doctype 5
html lang='en'
  head
    meta charset='utf-8'
    title
      = @title || "Nitrous"
    = favicon_link_tag
    = yield :head_before
    = stylesheet_link_tag 'application', media: 'all'
    = stylesheet_link_tag 'codemirror', media: 'all'
    = stylesheet_link_tag 'web_app', media: 'all'
    = yield :head_stylesheet
    = render 'layouts/google_analytics'
    = render 'layouts/mixpanel'
    = yield :head_after
  body
    = yield :body_before
    #webapp-loading
      .ui.progress
        .bar
    = yield
    = javascript_include_tag 'compat'
    = javascript_include_tag 'loading'
    = javascript_include_tag 'jquery'
    = javascript_include_tag 'codemirror'
    = javascript_include_tag 'application'
    = yield :body_script
    javascript:
      if (navigator.userAgent.indexOf('Trident') != -1) {
        $('html').addClass('msie');
      }
      App.setProperties({
        terminalJsPath: '#{javascript_path "terminal"}',
        terminalCssPath: '#{stylesheet_path "terminal"}',
        codemirrorJsPath: '#{javascript_path "codemirror"}',
        codemirrorCssPath: '#{stylesheet_path "codemirror"}'
      });
    = yield :body_after
