doctype 5
html lang='en' class=@html_class
  head
    meta charset='utf-8'
    title
      = @title
    link rel='shortcut icon' href='/favicon.ico'
    = stylesheet_link_tag 'application', media: 'all'
  body
    = yield :body_head
    = render 'layouts/topnav'
    = yield
    = render 'layouts/footer'
    = javascript_include_tag 'pages'
    = yield :body_tail
