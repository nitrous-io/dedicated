doctype 5
html lang='en' class=@html_class
  head
    meta charset='utf-8'
    title
      = @title || "Nitrous"
    = favicon_link_tag
    = yield :head_before
    / = stylesheet_link_tag 'application', media: 'all'
    / = stylesheet_link_tag 'pages', media: 'all'
    = stylesheet_link_tag 'website', media: 'all'
    = yield :head_stylesheet
    = render 'layouts/google_analytics'
    = render 'layouts/mixpanel'
    = yield :head_after
  body id=@body_id class=@body_class
    = yield :body_before
    = yield
    = javascript_include_tag 'compat'
    = javascript_include_tag 'jquery'
    = javascript_include_tag 'pages'
    = yield :body_script
    = yield :body_after
    javascript:
      pages.Shared.init();
