doctype 5
html lang='en'
  head
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="description" content="Quickly spin up a development environment for AngularJS, ReactJS, Ruby on Rails, Spree and more by adding a nitrous.json file to repository."
    meta charset="utf-8"
    title
      = "Quickstart · Nitrous"
    = favicon_link_tag
    link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:400,300,600" rel="stylesheet" type="text/css"
    = stylesheet_link_tag 'quickstart', media: 'all'
    = render 'layouts/google_analytics'
    = render 'layouts/mixpanel'
  body
    = yield
    = javascript_include_tag 'jquery'
    = javascript_include_tag 'pages'
    javascript:
      pages.Quickstart.init();
      pages.Shared.init();
