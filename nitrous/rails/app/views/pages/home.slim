- @title = 'Nitrous'
- @html_class = 'dark'
- @body_id = 'home'

- content_for :body_before
  javascript:
    // redirect to web app if logged in
    if(localStorage.getItem('token')) {
       window.location.replace('/app/#/');
    }

- content_for :body_after
  javascript:
    pages.Home.init();


.notice-banner
  .container
    p
      ' The
      strong
        ' Nitrous Lite
      ' service is no longer available.
      ' Enter your e-mail address below to create a new account.

    a href="#" class="close" &times;

.page
  .hero
    .container
      = render partial: 'layouts/webnav', locals: { active: 'home' }
      .hero-copy
        h2
          | Software Development Without the Pain
        h3
          | Cloud-based code editor with collaboration, one-click installs and snapshots

        = render 'layouts/cta_form'
      .shadows

  .notice
    .container
      p
        a href='/flatiron'
          span.new Latest
          | The Flatiron School has selected Nitrous as its software development platform
          span.link Read more
          i.fa.fa-chevron-right

  article.featurette.ide.attached-bottom
    .container
      h3.big-title A full-featured IDE in your browser
      h4
        | With support for over 90 languages out of the box, Nitrous is the lightweight and modern IDE you’ve been waiting for.
        br
        | Run web servers, databases, caches and more, right from your Web browser.
      .full-visual
        .window-controls.osx
          span
          span
          span

        video autoplay="autoplay" loop="loop" muted="true"
          source src="https://nitrous-image-icons.s3.amazonaws.com/nitrous-pro-collab.webm" type="video/webm"
          source src="https://nitrous-image-icons.s3.amazonaws.com/nitrous-pro-collab.mp4" type="video/mp4"

        .annotations
          .annotation-dot.tooltip.blue.zoom data-id="1" data-tooltip="Browse, upload, manage files and folders, just as you would on your desktop"
            .target
          .annotation-dot.tooltip.blue.zoom data-id="2" data-tooltip="Lightning-fast code editor in the browser, with rich language support"
            .target
          .annotation-dot.tooltip.blue.zoom data-id="3" data-tooltip="Dedicated Linux containers with full root-enabled shell access"
            .target
          .annotation-dot.tooltip.blue.zoom data-id="4" data-tooltip="Edit files side by side with Nitrous's new Split Editing mode"
            .target


  article.featurette
    .container

      .box-wrapper.three
        .box.terminal
          h3.with-icon Built-in terminal
          p Install libraries, manage dependencies and execute scripts in your project with terminal and full root access.

        .box.code
          h3.with-icon Zero-to-code in seconds
          p Stop letting valuable development time go to waste on system setup and maintenance. We’ll take care of that for you, so you never have to.

        .box.containers
          h3.with-icon The power of Docker
          p Create and work on multiple containers, or create custom containers using Docker images.

      .box-wrapper.three
        .box.github
          h3.with-icon GitHub integration
          p Connect your GitHub account, pull repos, push code, and stay productive wherever you are.

        .box.collaboration
          h3.with-icon Collaboration
          p Code collaboratively in real-time. Get help from a friend or co-worker, and code directly on the same machine in the cloud.

        .box.snapshots
          h3.with-icon Snapshots
          p Take snapshots to preserve the state of your project's environment, and revert back to them at any time.

      .centered
        a class="btn white-outline" href="/features"
          | Learn more

  article.quotes
    .carousel
      .carousel-inner

        input#carousel-1.carousel-open type="radio" name="carousel" aria-hidden="true" hidden="" checked="checked"
        .carousel-item
          .container
            .box-wrapper.one
              blockquote
                p
                  | I know how to administer a computer well enough.&nbsp;
                  strong But I don't want to
                  | . Nitrous allows me to just say "I want to code some Rails now, kthx" and not have to worry about getting all the details straight. Sometimes, I care about the details, but most of the time, I don't.
                cite
                  = image_tag 'home/quote-steveklabnik.png'
                  | Steve Klabnik
                  span , Rails Core Committer & prolific Open Source contributor

        input#carousel-2.carousel-open type="radio" name="carousel" aria-hidden="true" hidden=""
        .carousel-item
          .container
            .box-wrapper.one
              blockquote
                p
                  | You don't have to install anything so&nbsp;
                  strong you save time
                  |. Plus the students have a text editor and terminal in the same screen, and don't have to switch all the time, which also makes it less confusing.
                cite
                  = image_tag 'home/quote-andreas-tiefenthaler.png'
                  | Andreas Tiefenthaler
                  span , Rails Girls Instructor

        input#carousel-3.carousel-open type="radio" name="carousel" aria-hidden="true" hidden=""
        .carousel-item
          .container
            .box-wrapper.one
              blockquote
                p
                  ' Many companies — including Heroku — have attempted to move development to the cloud. Nitrous is
                  strong the first solution that doesn't feel like a toy
                  |. I can use it to get work done, today.
                cite
                  = image_tag 'home/quote-max-schoening.png'
                  | Max Schoening
                  span , Software Designer at Heroku

        input#carousel-4.carousel-open type="radio" name="carousel" aria-hidden="true" hidden=""
        .carousel-item
          .container
            .box-wrapper.one
              blockquote
                p
                  | I love that I can spin up a new box in seconds and start developing proof of concepts in minutes. Another sweet feature that I've used a lot is the ability to provide a&nbsp;
                  strong public preview link
                  | &nbsp;of my app.
                cite
                  = image_tag 'home/quote-shaunmcavinney.png'
                  | Shaun McAvinney
                  span , Engineer at RJMetrics

        label.carousel-control.prev.control-1 for="carousel-4"
          i.fa.fa-chevron-left
        label.carousel-control.next.control-1 for="carousel-2"
          i.fa.fa-chevron-right
        label.carousel-control.prev.control-2 for="carousel-1"
          i.fa.fa-chevron-left
        label.carousel-control.next.control-2 for="carousel-3"
          i.fa.fa-chevron-right
        label.carousel-control.prev.control-3 for="carousel-2"
          i.fa.fa-chevron-left
        label.carousel-control.next.control-3 for="carousel-4"
          i.fa.fa-chevron-right
        label.carousel-control.prev.control-4 for="carousel-3"
          i.fa.fa-chevron-left
        label.carousel-control.next.control-4 for="carousel-1"
          i.fa.fa-chevron-right

  article.for-everyone.lighter
    .container
      .box-wrapper.four
        .box
          h3.larger For Teams
          p Work collaboratively on applications and private repos. Leverage Nitrous's cutting-edge cloud IDE to stay productive wherever you are.
          a.learn-more href="/orgs"
            | Learn more
            i.fa.fa-chevron-right

        .box
          h3.larger For Agencies
          p Create a sandboxed environment for each of your clients in just minutes. Snapshot your projects and maintain a working application environment to revisit anytime.
          a.learn-more href="/agencies"
            | Learn more
            i.fa.fa-chevron-right

        .box
          h3.larger For Developers
          p Stop wasting time on system setup and maintenance. Go straight to what you do best: coding. Spin up boxes, build apps, deploy, and start again.
          a.learn-more href="/enterprises"
            | Learn more
            i.fa.fa-chevron-right

        .box
          h3.larger For Students
          p Work on your projects from Chromebooks, Windows machines, or school computer. Your development environment follows you wherever you are.
          a.learn-more href="/education"
            | Learn more
            i.fa.fa-chevron-right


  = render partial: 'layouts/companies', locals: { theme: '' }

  = render 'layouts/cta'

= render partial: 'layouts/footer', locals: { active: 'home' }
