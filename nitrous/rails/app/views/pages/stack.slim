- @title = "#{@stack['name']} on Nitrous"
- @html_class = 'light'
- @body_id = 'stack'
- @body_class = "stack-#{@stack['slug']}"

- content_for :body_after
  javascript:
    pages.Stack.init();

.page
  .page-hero
    .container
      = render partial: 'layouts/webnav', locals: { active: 'stacks' }
      .hero-copy
          h2
            span.stack-lang.nitrous Nitrous
            span.plus +
            span.stack-lang *{:class => @stack['slug']}
              = @stack['name']
  .notice
    .container
      ul
        - @stacks[0..9].each do |k,v|
          li
            a href="/stacks/#{v['slug']}"
              ="#{v['name']}"

        li.more
          span More
          i.fa.fa-bars
          ol
            - @stacks[10..@stacks.length].each do |k,v|
              li
                a href="/stacks/#{v['slug']}"
                  ="#{v['name']}"

  article.darker
    .container
      .box-wrapper.two
        .box
          h3
            | About
            =@stack['name']
          p
            =@stack['about']

        .box
          h3 About Nitrous.io
          p Nitrous provides a lightning fast way to set up development environments and code in the cloud. Nitrous allows developers to collaborate on their projects in real-time, deploy to production servers with one-click, and to version dev environments with ease.

  article.featurette.stack-steps
    .container
      h3.big-title="Getting started with #{@stack['name']} and Nitrous"
      ol
        // TODO: only if not signed in
        li.step1 *{:class => @stack['slug']}
          h2
            span.step 1
            | Sign up for your Free Nitrous Account

          // = render 'layouts/cta_form'

        li.step2 *{:class => @stack['slug']}
          h2
           span.step 2
           ="Select the #{@stack['name']} template in the New Container screen."

        li.step3 *{:class => @stack['slug']}
          h2
            span.step 3
            ="Start coding on your new #{@stack['name']} environment in just seconds!"


  = render partial: 'layouts/cta', locals: { theme: 'lighter' }

= render partial: 'layouts/footer', locals: { active: params[:stack] }
