- elsif params[:stack] == 'rails'
  - @title = 'Rails on Nitrous'
- elsif params[:stack] == 'python'
  - @title = 'Python on Nitrous'
- elsif params[:stack] == 'django'
  - @title = 'Django on Nitrous'
- elsif params[:stack] == 'node'
  - @title = 'Node.js on Nitrous'
- elsif params[:stack] == 'meteor'
  - @title = 'Meteor on Nitrous'
- elsif params[:stack] == 'html5'
  - @title = 'HTML5 on Nitrous'
- elsif params[:stack] == 'php'
  - @title = 'PHP on Nitrous'
- elsif params[:stack] == 'go'
  - @title = 'Go on Nitrous'
- elsif params[:stack] == 'laravel'
  - @title = 'Laravel on Nitrous'
- elsif params[:stack] == 'wordpress'
  - @title = 'Wordpress on Nitrous'
- elsif params[:stack] == 'iojs'
  - @title = 'io.js on Nitrous'
- elsif params[:stack] == 'java'
  - @title = 'Java on Nitrous'
- elsif params[:stack] == 'ubuntu'
  - @title = 'Ubuntu on Nitrous'
- else
  - @title = 'Stacks · Nitrous'
- @html_class = 'light'
- @body_id = 'stack'
- @body_class = 'stack-'+params[:stack]

- content_for :body_after
