- @title = 'Education · Nitrous'
- @html_class = 'light'
- @body_id = 'education'
- @body_class = 'story'


.page
  .page-hero
    .container
      = render partial: 'layouts/webnav', locals: { active: 'education' }
      .hero-copy
        h2
          | Nitrous and Education
        h3
          | Lightning-fast development in the cloud: the ultimate learning companion

        a.btn.white href="/app/#/signup" Sign Up To Nitrous
        
  .notice.darker
    .container
      p
        a href="/flatiron" target='_blank'
          span.new Education
          | Learn how the Flatiron School in NY is using Nitrous
          span.link Read more
          i.fa.fa-chevron-right


  article.featurette.full-window.with-border
    .container
      h3.big-title All your school's projects, in one place
      h4
        | Nitrous lets you create, administer, share, and snapshot
        br
        | your school's development projects from one convenient place

      .full-visual
        .window-controls.osx-safari
          span
          span
          span
          .nav-btn
          .nav-btn
          .url-address
          .nav-new-tab

        = image_tag 'home/dashboard-next-education.png', width:"970", height:"524"

  article.featurette.with-pulled-visual.cut-off.with-border
    .container
      .box-wrapper.text-on-left

        .box.auto.text
          .content
            h3.big-title Org member Administration
            p
              | Quickly add and remove team members, and set their role within the organization.

        .box.auto
          .content
            .full-visual.window.centered
              .window-controls.osx.colored
                span
                span
                span
              = image_tag 'home/members-next-education.png', width:"970", height:"524", alt: 'Nitrous Org member Administration'

  article.featurette.with-pulled-visual.cut-off.with-border
    .container
      .box-wrapper.text-on-left

        .box.auto.text
          .content
            h3.big-title Snapshots
            p
              | Preserve the state of your project's environment, and revert back to them at any time

        .box.auto
          .content
            .full-visual.window.centered
              .window-controls.osx.colored
                span
                span
                span
              = image_tag 'home/snapshots-next-education.png', width:"970", height:"524", alt: 'Nitrous Org member Administration'

  article.used-by
    .container
      h3.section-title
       | Used by students &amp; instructors at universities,
       br
       | coding academies, learning groups and hackathons
      .logos
        .row
          = image_tag 'home/harvard-on-light.png',    class: 'harvard on-light',    alt: 'Harvard University'
          = image_tag 'home/pilotdc-on-light.png',    class: 'pilotdc on-light',    alt: 'PilotDC'
          = image_tag 'home/carnegie-on-light.svg',        class: 'carnegie on-light',        alt: 'Carnegie Mellon'
          = image_tag 'home/berkeley-on-light.svg',    class: 'berkeley on-light',    alt: 'Berkeley'
          = image_tag 'home/ucl-on-light.png',    class: 'ucl on-light',    alt: 'University College London'
          = image_tag 'home/cornell-on-light.svg',    class: 'cornell on-light',    alt: 'Cornell University'
          = image_tag 'home/railsgirls-on-light.svg',        class: 'railsgirls on-light',        alt: 'Rails Girls'
        .row
          = image_tag 'home/mit-on-light.png',        class: 'mit on-light',        alt: 'MIT'
          = image_tag 'home/imperial-on-light.svg',        class: 'imperial on-light',        alt: 'Imperial College London'
          = image_tag 'home/stanford-on-light.svg',        class: 'stanford on-light',        alt: 'Stanford'
          = image_tag 'home/tealeaf-on-light.svg',        class: 'tealeaf on-light',        alt: 'Tealeaf Academy'
          = image_tag 'home/lahacks-on-light.png',        class: 'lahacks on-light',        alt: 'LA Hacks'
          = image_tag 'home/gaslight-on-light.svg',        class: 'gaslight on-light',        alt: 'Gaslight'
          = image_tag 'home/codeacademy-on-light.svg',        class: 'codeacademy on-light',        alt: 'Code Academy'

  article.colored.tealeaf-academy.quote
    .container

      blockquote
        = image_tag 'home/quote-tealeaf-logo.svg', class: 'visual', alt: 'Tealeaf Academy'

        p
          | Nitrous has&nbsp;
          strong saved us a lot of time
          |, because its one-click development environment allows our students to&nbsp;
          strong focus on the most important thing: learning to code
          |. What we love about Nitrous is that it's all that you need as a developer and nothing more. In other words, when our students use Nitrous, they're learning how to work like a real developer, not learning a proprietary product. The Nitrous development environment is just Unix, and a code editor - that's how real programmers work. We love that about Nitrous.
        cite
          | Chris Lee
          span , Co-founder of Tealeaf Academy


  article.colored.pilot-dc.quote
    .container

      blockquote
        = image_tag 'home/quote-pilotdc-logo.png', class: 'visual', alt: 'PilotDC'
        p
          | We definitely love the&nbsp;
          strong easy-to-use coding interface
          | &nbsp;and the&nbsp;
          strong amazing collaborative technology
          | &nbsp;that Nitrous offers. In the past, we had used other code sharing software such as Git and Dropbox, but the live code collaboration that Nitrous provides is just awesome. Nitrous definitely&nbsp;
          strong increased our productivity
          | &nbsp;a great deal, especially in an overnight event, where fatigue can catch up with your body and tempers can rise quickly if software doesn't cooperate.
        cite
          | Michael Reininger
          span , part of the PilotDC hackathon's winning team from Montgomery High


  article.cta.darker
    .container
      h3.section-title Register your interest, get group pricing plans
      h4
        | Learn and build software using our Web IDE, Chrome app, or your favorite Desktop editor.
        br
        | Share workspaces, and code collaboratively in the classroom.
      a.btn.blue.submit href="/education-pricing" Register Interest


= render partial: 'layouts/footer', locals: { active: 'education' }
