ruby:
  @title = 'Features · Nitrous'
  @html_class = 'light'
  @body_id = 'features'

  ua = request.env['HTTP_USER_AGENT'].downcase
  if ua.match(/mac/i)
    @os = "osx"
  elsif ua.match(/windows/i)
    @os = "windows"
  elsif ua.match(/linux/i)
    @os = "linux"
  else
    @os = "nitrogen"
  end

- content_for :body_after
  javascript:
    pages.Features.init();


.page
  .page-hero.no-hero
    .container
      = render partial: 'layouts/webnav', locals: { active: 'features' }
      .hero-copy
        h2
          | Making coding in the cloud a reality
        h3
          | Get coding fast, be productive like never before

  article.featurette
    .container

      .box-wrapper.three
        .box.terminal
          h3.with-icon Built-in Terminal
          p Install libraries, manage dependencies and execute scripts in your project with terminal and full root access.

        .box.code
          h3.with-icon Zero-to-code in seconds
          p Stop letting valuable development time go to waste on system setup and maintenance. We’ll take care of that for you, so you never have to.

        .box.containers
          h3.with-icon Powered by Docker
          p Create & develop on multiple projects within a workstation, or create custom project using Docker images.

      .box-wrapper.three
        .box.collaboration
          h3.with-icon Collaboration
          p Code collaboratively in real-time. Get help from a friend or co-worker, and code directly on the same machine in the cloud.

        .box.github
          h3.with-icon GitHub integration
          p Connect your GitHub account, pull repos, push code, and stay productive wherever you are.

        .box.snapshots
          h3.with-icon Snapshots
          p Take snapshots to preserve the state of your project's environment, and revert back to them at any time.

      .box-wrapper.three
        .box.go-to-file
          h3.with-icon Go to file
          p Quickly jump between files with only a few keystrokes, just like your favorite desktop editor.

        .box.split-editing
          h3.with-icon Split Editing
          p Get the most out of your screen real-estate with split editing support. Edit files side by side.

        .box.ssh
          h3.with-icon Full SSH access
          p
            | Get complete control of your workstation and projects, and access them anytime with SSH.

      .box-wrapper.three
        .box.ssl
          h3.with-icon SSL Data Encryption
          p All of your information is encrypted and transmitted securely using the Secure Sockets Layer (SSL) protocol.

        .box.backup
          h3.with-icon Backup &amp; Redundancy
          p Never worry about losing your work because of a coffee spill or stolen laptop. Your projects are in the cloud, in military-grade secure facilities.

        .box.secure
          h3.with-icon Your data, secured
          p Every user operates within their own isolated environment and cannot interact with other applications or areas of the system.


  article.featurette.with-pulled-visual.cut-off
    .container
      .box-wrapper.text-on-left

        .box.auto.text
          .content
            h3.big-title Self-service dashboard
            p
              | Easily create and manage new projects, or load your own using Docker images.
            p
              | Access your app's public preview or SSH URLs, and invite others to collaborate on your project.

        .box.auto
          .content
            .full-visual.window.centered
              .window-controls.osx.colored
                span
                span
                span
              = image_tag 'home/dashboard-next-features.png', width:"970", height:"524", alt: 'Self-service Dashboard'


  article.featurette.with-pulled-visual.cut-off
    .container
      .box-wrapper.text-on-right

        .box.auto.visual-on-left
          .content
            .full-visual.window
              .window-controls.osx.colored
                span
                span
                span
              = image_tag 'home/create-next-features.png', width:"970", height:"524", alt: 'Get coding fast with Nitrous'

        .box.auto.text
          .content
            h3.big-title Get coding fast
            p
              ' Nitrous projects come with a set of
              strong pre-installed tools, libraries
              ', and
              strong frameworks
              |  to get you coding fast.
            p
              | Stop worrying about setting up your development environment, we'll take care of that for you.

  article.featurette.with-pulled-visual.trio.with-wallpaper
    .container
      h3.big-title Best-in-class Cloud IDE
      h4
        | Multiple layouts, smart auto-complete, live collaboration, and power-tools
        br
        |that will put your desktop code editor to shame

      .visual-wrapper
        .full-visual.window.centered
          .window-controls.osx.colored
            span
            span
            span
          = image_tag 'home/ide-featurette-2.png', width: '808px', height: '486px', alt: 'Self-service Dashboard'

        .full-visual.window
          .window-controls.osx.colored
            span
            span
            span
          = image_tag 'home/ide-featurette-3.png', width: '808px', height: '486px', alt: 'Self-service Dashboard'

        .full-visual.window
          .window-controls.osx.colored
            span
            span
            span
          = image_tag 'home/ide-featurette-1.png', width: '808px', height: '486px', alt: 'Self-service Dashboard'


  article.downloads.lighter
    .container
      .box-wrapper

        .box.auto.nitrous-desktop
          .content
            h3.section-title Nitrogen Plugin for Atom

            .item
              h4 Manage your cloud environments
              p
                | Nitrogen (available for Windows, OS X, and Linux) lets you manage your Nitrous projects running in the cloud.

            .item
              h4 Sync files, use your favorite editor
              p
                ' Sync files between Nitrous and desktop computer, allowing you to edit files using
                a href="https://atom.io/" target="_blank" Atom
                '
                | or your text editor of choice.

              .download-btns
                a.btn.download class="#{@os}" href="https://community.nitrous.io/docs/installing-the-nitrogen-atom-plugin-d9a97d12-b6ab-4ad2-b219-45f05451d692" target="_blank" Install Nitrogen

        .box.auto.nitrous-chrome
          .content
            h3.section-title Nitrous for Chrome

            .item
              h4 Lightning fast, works everywhere
              p
                | Written from scratch with performance in mind, Nitrous for Chrome will profoundly enhance your coding experience, whichever device you use.

            .item
              h4 Native keyboard shortcuts
              p
                ' Nitrous for Chrome takes advantage of the freedom offered by Chrome apps, and provides a "native-like" coding experience.
                a href="https://community.nitrous.io/posts/nitrous-pro-chrome-app-now-available" target="_blank" Learn more
                | .

              .download-btns
                a.btn.download.chrome href="https://chrome.google.com/webstore/detail/nitrous/efdcneeepllhjlbejkfnaolelbpdacai?hl=en" target="_blank" Chrome Web Store


  = render partial: 'layouts/stacks', locals: { theme: 'darker' }

  = render partial: 'layouts/companies', locals: { theme: '' }

  = render partial: 'layouts/cta'

= render partial: 'layouts/footer', locals: { active: 'features' }
