- @title = 'Press · Nitrous'
- @html_class = 'light'
- @body_id = 'press'


.page
  .page-hero
    .container
      = render partial: 'layouts/webnav', locals: { active: 'press' }
      .hero-copy
        h2
          | Press
        h3
          | Nitrous is a cloud-based code editor with collaboration, 
          br 
          | one-click installs and snapshots



  article.featurette
    .container
      h3.big-title In the press

      .grid-wrapper
        .grid-item.article.readwrite
          a href="https://readwrite.com/2014/07/11/one-click-messaging-app" target="_blank"
            span.date July 11, 2014
            h3 Create Your Own Obnoxiously Simple Messaging App Just Like Yo

