            h3 Action Aims to Be the Heroku of Development Environments


  article.featurette
    .container
      h3.big-title Brand assets

      .box-wrapper.three.centered
        .box.press-asset
          a href="https://nitrous-image-icons.s3.amazonaws.com/brand/nitrous-logo-dark.eps"
            = image_tag 'home/press-logo-dark.png', alt: 'Nitrous Logo'
            i.fa.fa-cloud-download
            span.download Download logo

        .box.press-asset
          a href="https://nitrous-image-icons.s3.amazonaws.com/brand/nitrous-logo-white.eps"
            = image_tag 'home/press-logo-white.png', alt: 'Nitrous Logo'
            i.fa.fa-cloud-download
            span.download Download logo

        .box.press-asset
          a href="https://nitrous-image-icons.s3.amazonaws.com/brand/nitrous-mark.eps"
            = image_tag 'home/press-logo-mark.png', alt: 'Nitrous Logo'
            i.fa.fa-cloud-download
            span.download Download mark

  article.featurette
    .container
      h3.big-title Contact us
      h4 
        | If you'd like to write a story about Nitrous, please 
        a.blue href="mailto:press@nitrous.io" get in touch
        | !
        br
        | Check out 
        a.blue href="/enterprises" Nitrous for Entreprises
        |  if you are a business interested in using Nitrous.



  = render 'layouts/cta', locals: { style: 'darker' }

= render partial: 'layouts/footer', locals: { active: 'press' }
