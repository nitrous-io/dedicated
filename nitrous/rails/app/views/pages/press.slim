          a href="http://thenextweb.com/insider/2014/04/17/nitrous-io-launches-hack-button-help-developers-test-open-source-codes-one-click/" target="_blank"
            span.date April 17, 2014
            h3 Nitrous launches 'Hack' button to help developers test drive applications with one click

        .grid-item.article.gigaom
          a href="http://gigaom.com/2014/03/18/nitrous-io-scores-6-65m-to-free-developers-from-messy-ide-set-up/" target="_blank"
            span.date March 18, 2014
            h3 Nitrous scores $6.65M to eliminate messy development set up
      
        .grid-item.article.techcrunch
          a href="http://techcrunch.com/2014/03/18/cloud-development-platform-nitrous-io-closes-6-65m-series-a-round-led-by-bessemer/" target="_blank"
