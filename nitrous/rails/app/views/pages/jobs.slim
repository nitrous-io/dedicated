- @title = 'Jobs · Nitrous'
- @html_class = 'dark'
- @body_id = 'jobs'


.page
  .page-hero
    .container
      = render partial: 'layouts/webnav', locals: { active: 'jobs' }
      .hero-copy
        h2
          | Join the team, grow with us
        h3
          | We're looking for remarkable people to help us change the way the world codes


  article.square-grid

    a.grid-item.opening.job-eng href='/jobs/platform-engineer'
      span.icon
      span.title Platform Engineer
      span.location San Francisco — Singapore

    a.grid-item.opening.job-eng href='/jobs/software-engineer'
      span.icon
      span.title Software Engineer
      span.location San Francisco — Singapore
    
    a.grid-item.opening.job-devrel href='/jobs/developer-evangelist'
      span.icon
      span.title Developer Evangelist
      span.location San Francisco

    a.grid-item.opening.job-support href='/jobs/support-engineer'
      span.icon
      span.title Support Engineer
      span.location San Francisco — Singapore

    
  article.life-at.darker
    .container
      .box-wrapper.three.centered
        .box
          h3.section-title.big-title Two offices
          p
            | Nitrous has offices in two of the world’s most exciting cities: San Francisco and Singapore. As an employee, you can participate in our SF-Singapore Exchange Program

        .box
          h3.section-title.big-title Pick your equipment
          p
            | Because we want you to do the best work of your life, pick whatever equipment makes you most productive
        
        .box
          h3.section-title.big-title Perks &amp; benefits
          p
            | On top of competitive salary and equity, Nitrous offers free lunches, Health, Vision and Dental insurance, flexible vacations, team outings, and a referral bonus program
      
      .centered
        a class="btn white-outline" href="/company"
          | Learn more about Nitrous

  article.maps
    .map
      .address
        .address-1 300 Brannan St. Ste 201
        .address-2 San Francisco
      .pin
    .map
      .address
        .address-1 1A Trengganu St. 2nd Floor
        .address-2 Singapore
      .pin

= render partial: 'layouts/footer', locals: { active: 'jobs' }
