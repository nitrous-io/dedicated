- @title = 'Enterprises · Nitrous'
- @html_class = 'light'
- @body_id = 'enterprises'
- @body_class = 'story'


.page
  .page-hero
    .container
      = render partial: 'layouts/webnav', locals: { active: 'education' }
      .hero-copy
        h2
          | Nitrous and Enterprises
        h3
          | With split-pane editing, powerful containers, realtime collaboration and enterprise-grade
          br
          | control, Nitrous keeps both your teams and developers happy and productive



  article.featurette.offset-visual
    .container
      
      .full-visual
        = image_tag 'home/ide-theme-split-5.png', width: '970px', alt: 'Nitrous Editor themes'

      .box-wrapper.three.centered
        .box
          .visual
            = image_tag 'home/large-featurette-onboarding.svg', class: 'visual', alt: 'Seamless Onboarding'
          h3.section-title Seamless Onboarding
          p Getting a fresh hire up to speed? Simply spin up a complex development environment for any app, language or stack in seconds. Works perfectly with native tools and existing workflow.
        
        .box
          .visual
            = image_tag 'home/large-featurette-collab.svg', class: 'visual', alt: 'Realtime Collaboration'
          h3.section-title Realtime Collaboration
          p Nitrous not only lets you edit code with your colleagues in realtime, you can also snapshot your project into an Image and share it across the world with other teams. Get everyone on the same page with consistent, shareable dev environments.
        
        .box
          .visual
            = image_tag 'home/large-featurette-secure.svg', class: 'visual', alt: 'Your Data, Secured'
          h3.section-title Your Data, Secured
          p Data security is a matter of paramount importance at Nitrous - all of your information is encrypted and transmitted securely using the Secure Sockets Layer (SSL) protocol. Every user operates within their own isolated environment.
      

      .centered
        a href="/vpc"
          | Learn more about our on-premise/VPC solutions
          i.fa.fa-chevron-right

  
  article.used-by
    .container
      h3.section-title 
       | Used by developers at these amazing enterprises
      .logos
        .row
          = image_tag 'home/heroku-on-light.svg',     class: 'heroku on-light',     alt: 'Heroku'
          = image_tag 'home/facebook-on-light.svg',      class: 'facebook on-light',      alt: 'Facebook'
          = image_tag 'home/sendgrid-on-light.svg',   class: 'sendgrid on-light',   alt: 'Sendgrid'
          = image_tag 'home/thoughtbot-on-light.svg', class: 'thoughtbot on-light', alt: 'thoughtbot'
          = image_tag 'home/zendesk-on-light.svg',    class: 'zendesk on-light',    alt: 'Zendesk'
          = image_tag 'home/shopify-on-light.svg',    class: 'shopify on-light',    alt: 'Shopify'
        .row
          = image_tag 'home/visa-on-light.svg',       class: 'visa',       alt: 'Visa'
          = image_tag 'home/ibm-on-light.svg',        class: 'ibm',        alt: 'IBM'
          = image_tag 'home/tencent-on-light.svg',    class: 'tencent',    alt: 'Tencent'
          = image_tag 'home/google-on-light.svg',    class: 'google',    alt: 'Google'
          = image_tag 'home/emc-on-light.svg',    class: 'emc',    alt: 'EMC'
          = image_tag 'home/microsoft-on-light.svg',    class: 'microsoft',    alt: 'Microsoft'

  

  article.colored.heroku.quote
    .container

      blockquote
        = image_tag 'home/quote-heroku-logo.svg', class: 'visual', alt: 'Heroku'

        p
          | Many companies — including Heroku — have attempted to move development to the cloud. Nitrous.io is 
          strong the first solution that doesn't feel like a toy
          |. I can use it to get work done, today.
        cite
          | Max Schoening
          span , Software Designer at Heroku



  = render 'layouts/cta'

= render partial: 'layouts/footer', locals: { active: 'enterprises' }
