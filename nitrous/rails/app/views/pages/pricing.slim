- @title = 'Pricing · Nitrous'
- @html_class = 'pricing'

- content_for :body_after
  javascript:
    pages.Pricing.init();

.seo-aid
  h2 Pricing
  p You are billed per workspace, so if you spin up one $25/mo workspace and one $50/mo workspace, you get billed $75/mo.

  h3 Workspace Size
  ul
    li
      h4 Shift
      ul
        li Up to 2 Containers
        li 1 GB Memory
        li 20 GB Storage
        li Root Access
        li Dedicated Resources
    li
      h4 Turbo
      ul
        li Up to 5 Containers
        li 2 GB Memory
        li 30 GB Storage
        li Root Access
        li Dedicated Resources
    li
      h4 Turbo
      ul
        li Up to 10 Containers
        li 4 GB Memory
        li 50 GB Storage
        li Root Access
        li Dedicated Resources
  h4 All plans also come with:
  ul
    li Always On
    li SSH Access
    li Desktop Sync (Mac/Windows/Linux)
    li Custom Domains
    li SSL Protection
    li Web IDE
    li Snapshots
    li Custom Container Management
