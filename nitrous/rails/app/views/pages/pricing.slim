                  strong
                  '
                  | Projects
                li.memory
                  strong
                  '
                  | Memory
                li.storage
                  strong
                  '
                  | SSD Storage
              a.btn.blue.ripple href="/app/#/signup/" Sign Up

            li.selectable.popular data-index='1'
              .most-popular
