                  | Memory
                li.storage
                  strong
                  '
                  | SSD Storage
              a.btn.blue.ripple href="/app/#/signup/" Sign Up

            li.selectable data-index='2'
              .title
              .desc
              .plan-price
                .monthly
                  .focus
