- @title = 'March 27 2015 plan changes · Nitrous'
- @html_class = 'dark'
- @body_id = 'plan-changes'

.page
  .page-hero
    .container
      = render partial: 'layouts/webnav', locals: { active: 'plan_changes' }
      .hero-copy
        h2
          | March 27, 2015 changes in plans

  article.featurette
    .container

      h3.big-title New names, lower prices, more storage

      h4 If you have an existing workspace, you have already been switched to a new plan when your workspace was migrated on March 27, 2015.

      .box-wrapper.three
        .box
          h3.no-icon Shift &rArr; Basic
          p
            span.strikethrough $25/month
            | &nbsp;
            span.new-plan $14.99/month
          p 20 GB Storage
          p 1 GB Memory

        .box
          h3.no-icon Turbo &rArr; Standard
          p
            span.strikethrough $45/month
            | &nbsp;
            span.new-plan $29.99/month
          p
            span.strikethrough 30 GB storage
            | &nbsp;
            span.new-plan 50 GB storage
          p 2 GB Memory

        .box
          h3.no-icon Nitro &rArr; Pro
          p
            span.strikethrough $80/month
            | &nbsp;
            span.new-plan $64.99/month
          p
            span.strikethrough 50 GB storage
            | &nbsp;
            span.new-plan 120 GB storage
          p 4 GB Memory

  article.featurette
    .container
      h3.big-title Usage-based billing

      h4 We have introduced a usage-based component for billing.  You can now lower your monthly bill by stopping your workspace when you are not using it.

= render partial: 'layouts/footer', locals: { active: 'plan_changes' }
