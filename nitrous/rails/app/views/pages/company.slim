- @title = 'Company · Nitrous'
- @html_class = 'light'
- @body_id = 'company'

- content_for :body_after
  javascript:
    pages.Company.init();


.page
  .page-hero
    .container
      = render partial: 'layouts/webnav', locals: { active: 'company' }
      .hero-copy
        h2
          | Our Company
        h3
          | Building the future of development environments

  article.centered.attached-bottom
    .container
      p.big
        | Nitrous is developed and maintained by an experienced team based out of San Francisco and Singapore. We focus on building the best tools for developers and teams around the world.

      .people
        ul
          li.tooltip.team.blue.zoom data-tooltip="Scott has a deep knowledge of platforms and cloud computing with three successful startup exits - one in excess of $1b. He has managed teams at Microsoft, Salesforce and VMWare."
            = image_tag 'home/scott.png', width: '92px', height: '92px', alt: 'Scott Collison', class: 'zoom'
          li.tooltip.team.blue.zoom data-tooltip="AJ loves baseball, surfing, and networked home appliances. He studied economics at Harvard and is obsessed with microformats"
            = image_tag 'home/aj.png', width: '92px', height: '92px', alt: 'AJ', class: 'zoom'
          li.tooltip.team.blue.zoom data-tooltip="Pete started programming at the age of 8, when most kids were still picking their nose. He likes cycling and playing airsoft games"
            = image_tag 'home/pete.png', width: '92px', height: '92px', alt: 'Pete', class: 'zoom'
          li.tooltip.team.blue.zoom data-tooltip="Nicole is the glue that holds it all together at Nitrous. She enjoys designing clothes, animals of all kinds, and reading great books"
            = image_tag 'home/nicole.png', width: '92px', height: '92px', alt: 'Nicole', class: 'zoom'
          li.tooltip.team.blue.zoom data-tooltip="Betty is an accomplished financial and operations professional. Finance and accounting are her passion"
            = image_tag 'home/betty.png', width: '92px', height: '92px', alt: 'Betty', class: 'zoom'
          li.tooltip.team.blue.zoom data-tooltip="Chu Yeow likes: Miyo (his tortoiseshell cat), Japan, anime. Dislikes: trailing whitespace, tabs"
            = image_tag 'home/cheah.png', width: '92px', height: '92px', alt: 'Chu Yeow', class: 'zoom'
          li.tooltip.team.blue.zoom data-tooltip="Tim is a frenzy of keyboard activity in multiplexed terminals. Sometimes sounds pretentious, often actually is"
            = image_tag 'home/timothy.png', width: '92px', height: '92px', alt: 'Tim', class: 'zoom'
          li.tooltip.team.blue.zoom data-tooltip="Juan loves sports, open source, connecting to API services, and helping other developers. He enjoys being outdoors, and tinkers with amateur photography of awe-inspiring landscapes. And, there's always room for guacamole!"
            = image_tag 'home/juan.png', width: '92px', height: '92px', alt: 'Juan', class: 'zoom'
          li.tooltip.team.blue.zoom data-tooltip='Audrey is a litigious Go coder. She prefers to be called "lawful". A lawyer by training, she often writes code-reviews in legalese, for example "Illegal start of expression", "Illegal assignment" and threatens to bring the GitHub issue to court unless the problematic code is fixed immediately'
            = image_tag 'home/audrey.png', width: '92px', height: '92px', alt: 'Audrey', class: 'zoom'
          li.tooltip.team.blue.zoom data-tooltip="Sunjin is a Level 90 Pandaren Ale-Drinker at Nitrous. He is able to code for multiple days without sleep as long as there is an uninterrupted supply of beer"
            = image_tag 'home/sunjin.png', width: '92px', height: '92px', alt: 'Sunjin', class: 'zoom'
          li.tooltip.team.blue.zoom data-tooltip="Javier is an avid cyclist who likes to spin up servers and watch them run in graphs and metrics"
            = image_tag 'home/javier.png', width: '92px', height: '92px', alt: 'Javier', class: 'zoom'

  article.life-at
    .container
      .box-wrapper.two.centered
        .box
          h3.section-title.big-title Life at Nitrous
          p
            | Our employees enjoy access to the best tools available, an open and collaborative work environment, and come to work each day knowing they are having a tangible impact on the lives of developers worldwide

        .box
          h3.section-title.big-title Perks &amp; benefits
          p
            | We offer competitive salaries, office exchange programs between our two offices, free lunches, Health, Vision and Dental insurance, flexible vacations, team outings, and a referral bonus program

  article.photos
    .cover-photo
    .cover-photo

  article.investors.darker
    .lead.container
      .shot
        = image_tag 'home/bvp-logo.png', width: '315px', height: '80px', alt: 'Bessemer Venture Partners logo'
      .copy
        p
          | Bessemer Venture Partners led Nitrous' Seed and Series A financing rounds.
        p
          ' Bessemer Venture Partners (BVP) invests in early-stage and hyper-growth startups, partnering closely with entrepreneurs to build durable businesses. With $4 billion under management, BVP invests anywhere from $100,000 to $75 million in innovative companies like Pinterest, Twilio, Box, LinkedIn, Shopify, Yelp, Skype and Nitrous. Over 100 BVP companies have gone public – in the last three years alone, BVP has had 46 exits (IPO and M&amp;A) and made new investments in more than 85 companies. Learn more at
          a href="http://www.bvp.com/" www.bvp.com
    .container
      ul.investor-logos
        li
          a.bvp href="http://www.bvp.com/" target="_blank"
        li
          a.five-hundred-startups href="http://500.co/" target="_blank"
        li
          a.goldengate-ventures href="http://goldengate.vc/" target="_blank"
        li
          a.crunchfund href="https://www.crunchbase.com/organization/crunchfund" target="_blank"
        li
          a.draper-associates href="http://drapercompany.com/" target="_blank"
        li
          a.tibco href="http://www.tibco.com/" target="_blank"

  article.investors.attached-bottom
    .container
      h3.big-title Our Angels &amp; Advisors
      ul.angels
        li
          a href="https://angel.co/saverin" target="_blank"
            = image_tag 'home/eduardo-saverin.png', width: '62px', height: '62px', alt: 'Nitrous angel', class: 'zoom'
            span Eduardo Saverin

        li
          a href="http://en.wikipedia.org/wiki/Bill_Ackman" target="_blank"
            = image_tag 'home/bill-ackman.png', width: '62px', height: '62px', alt: 'Nitrous angel', class: 'zoom'
            span Bill Ackman

        li
          a href="https://angel.co/prospern" target="_blank"
            = image_tag 'home/prosper-nwankpa.png', width: '62px', height: '62px', alt: 'Nitrous angel', class: 'zoom'
            span Prosper Nwankpa

        li
          a href="https://angel.co/razmig-hovaghimian" target="_blank"
            = image_tag 'home/razmig-hovaghimian.png', width: '62px', height: '62px', alt: 'Nitrous angel', class: 'zoom'
            span Razmig Hovaghimian

        li
          a href="https://www.linkedin.com/pub/larry-link/3/112/301" target="_blank"
            = image_tag 'home/larry-link.png', width: '62px', height: '62px', alt: 'Nitrous angel', class: 'zoom'
            span Larry Link

      ul.advisors
        li
          a href="https://twitter.com/tobi" target="_blank"
            = image_tag 'home/tobi-lutke.png', width: '62px', height: '62px', alt: 'Nitrous advisor', class: 'zoom'
            span Tobi Lutke

        li
          a href="https://twitter.com/jamesjyu" target="_blank"
            = image_tag 'home/james-yu.png', width: '62px', height: '62px', alt: 'Nitrous advisor', class: 'zoom'
            span James Yu

        li
          a href="https://twitter.com/joestump" target="_blank"
            = image_tag 'home/joe-stump.png', width: '62px', height: '62px', alt: 'Nitrous advisor', class: 'zoom'
            span Joe Stump

        li
          a href="https://twitter.com/andrewchen" target="_blank"
            = image_tag 'home/andrew-chen.png', width: '62px', height: '62px', alt: 'Nitrous advisor', class: 'zoom'
            span Andrew Chen

        li
          a href="https://twitter.com/iamclovin" target="_blank"
            = image_tag 'home/arun-thampi.png', width: '62px', height: '62px', alt: 'Nitrous advisor', class: 'zoom'
            span Arun Thampi

  article.maps
    .map
      .address
        .address-1 300 Brannan St. Ste 201
        .address-2 San Francisco
      .pin
    .map
      .address
        .address-1 29A Teo Hong Road
        .address-2 Singapore
      .pin

  = render 'layouts/cta', locals: { style: 'darker' }

= render partial: 'layouts/footer', locals: { active: 'company' }
