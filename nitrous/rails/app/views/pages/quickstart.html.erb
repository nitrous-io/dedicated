      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/telephone-pictionary")}", class: "button" %>
    </div>
    <div class="repo">
      <%= image_tag "quickstart/angular.png" %>
      <h3><a href="https://github.com/nitrous-io/quickstart">Angular 2 QuickStart</a></h3>
      <p class="who">Angular</p>
      <p class="description">
        A good starting point for your Angular 2 application.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/quickstart")}", class: "button" %>
    </div>
    <div class="repo left">
      <%= image_tag "quickstart/learn-rails.png" %>
      <h3><a href="https://github.com/nitrous-io/learn-rails">Learn Rails</a></h3>
      <p class="who">RailsApps</p>
      <p class="description">
        An example Rails application to accompany the <a href="http://learn-rails.com/learn-ruby-on-rails.html">Learn Ruby on Rails</a> book.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/learn-rails")}", class: "button" %>
    </div>
    <div class="clear"></div>
  </div>

</div>
