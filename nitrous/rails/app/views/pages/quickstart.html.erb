<div id="header">
  <%= link_to "/", id: "logo" do %>
    <%= image_tag "home/nitrous-logo.svg" %>
  <% end %>
  <h1>
    Nitrous
    <br>
    Quickstart
  </h1>
  <p class="wtf">
    Quickly spin up a development environment for project by adding a <code>nitrous.json</code> file to your repository. In fact, this page is a <%= link_to "GitHub repo", "https://github.com/nitrous-io/nitrous-quickstart", target: "_blank" %> that you can edit live via our Cloud IDE.
  </p>
  <%= link_to "Edit This Page", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/nitrous-quickstart")}", class: "button" %>
  <p class="psycho">(Give it a try, this button actually works!)</p>
</div>

<div id="categories">

  <div class="category">
    <h2>Popular</h2>
    <div class="repo left">
      <%= image_tag "quickstart/suspenders.png" %>
      <h3><a href="https://github.com/nitrous-io/suspenders">Suspenders</a></h3>
      <p class="who">Thoughtbot</p>
      <p class="description">
        Suspenders is a base Rails application. It is used by Thoughtbot to get a jump start on a working app.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/suspenders")}", class: "button" %>
    </div>
    <div class="repo">
      <%= image_tag "quickstart/dashing.png" %>
      <h3><a href="https://github.com/nitrous-io/dashing">Dashing</a></h3>
      <p class="who">Shopify</p>
      <p class="description">
        Dashing is a Sinatra based framework that lets you build beautiful dashboards.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/dashing")}", class: "button" %>
    </div>
    <div class="repo left">
      <%= image_tag "quickstart/discourse.png" %>
      <h3><a href="https://github.com/nitrous-io/discourse">Discourse</a></h3>
      <p class="who">Discourse</p>
      <p class="description">
        Discourse is discussion forum built with Ruby on Rails.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/discourse")}", class: "button" %>
    </div>
    <div class="repo">
      <%= image_tag "quickstart/rails-devise.png" %>
      <h3><a href="https://github.com/nitrous-io/rails-devise">rails-devise</a></h3>
      <p class="who">RailsApps</p>
      <p class="description">
        A Rails starter app that uses <a href="https://github.com/plataformatec/devise">Devise</a> for authentication.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/rails-devise")}", class: "button" %>
    </div>
    <div class="clear"></div>
  </div>

  <div class="howto">
    <h4>Not interested in any of these repositories?</h4>
    <p>
      <a href="https://community.nitrous.io/docs/nitrous-quickstarts">Add Nitrous Quickstart</a> to your favorite GitHub repositories.
    </p>
  </div>

  <div class="category">
    <h2>Recently Added</h2>
    <div class="repo left">
      <%= image_tag "quickstart/publify.png" %>
      <h3><a href="https://github.com/nitrous-io/publify">Publify</a></h3>
      <p class="who">Publify (formerly Typo)</p>
      <p class="description">
        Publify is a blogging engine built with Ruby on Rails.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/publify")}", class: "button" %>
    </div>
    <div class="repo">
      <%= image_tag "quickstart/spree.png" %>
      <h3><a href="https://github.com/nitrous-io/spree">Spree</a></h3>
      <p class="who">Spree Commerce</p>
      <p class="description">
        Spree is an e-commerce solution built with Ruby on Rails.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/spree")}", class: "button" %>
    </div>
    <div class="repo left">
      <%= image_tag "quickstart/telephone-pictionary.png" %>
      <h3><a href="https://github.com/nitrous-io/telephone-pictionary">Telephone-Pictionary</a></h3>
