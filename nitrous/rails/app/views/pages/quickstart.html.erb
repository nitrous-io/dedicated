<div id="header">
  <%= link_to "/", id: "logo" do %>
    <%= image_tag "home/nitrous-logo.svg" %>
  <% end %>
  <h1>
    Nitrous
    <br>
    Quickstart
  </h1>
  <p class="wtf">
    Quickly spin up a development environment for project by adding a <code>nitrous.json</code> file to your repository. In fact, this page is a <%= link_to "GitHub repo", "https://github.com/nitrous-io/nitrous-quickstart", target: "_blank" %> that you can edit live via our Cloud IDE.
  </p>
  <%= link_to "Edit This Page", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/nitrous-quickstart")}", class: "button" %>
  <p class="psycho">(Give it a try, this button actually works!)</p>
</div>

<div id="categories">

  <div class="category">
    <h2>Popular</h2>

    <div class="repo left">
      <%= image_tag "quickstart/angular.png" %>
      <h3><a href="https://github.com/nitrous-io/quickstart">Angular 2 QuickStart</a></h3>
      <p class="who">Angular</p>
      <p class="description">
        A good starting point for your Angular 2 application.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/quickstart")}", class: "button" %>
    </div>
    <div class="repo">
      <%= image_tag "quickstart/dashing.png" %>
      <h3><a href="https://github.com/nitrous-io/dashing">Dashing</a></h3>
      <p class="who">Shopify</p>
      <p class="description">
        Dashing is a Sinatra based framework that lets you build beautiful dashboards.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/dashing")}", class: "button" %>
    </div>
    <div class="repo left">
      <%= image_tag "quickstart/discourse.png" %>
      <h3><a href="https://github.com/nitrous-io/discourse">Discourse</a></h3>
      <p class="who">Discourse</p>
      <p class="description">
        Discourse is discussion forum built with Ruby on Rails.
      </p>
      <%= link_to "Nitrous Quickstart", "https://www.nitrous.io/quickstart?repo=#{CGI.escape("https://github.com/nitrous-io/discourse")}", class: "button" %>
