- @title = 'AWS Activate · Nitrous'
- @html_class = 'light'
- @body_id = 'awsactivate'

.page
  .page-hero
    .container
      = render partial: 'layouts/webnav', locals: { active: '' }
      .hero-copy
        h2
          | AWS Activate
        h3
          | Collaboratively develop powerful web applications within any modern web browser

  article.featurette
    .container

      h3.big-title 60 day free trial on our organization plans

      h4
        | The AWS Activate package is perfect for professional development teams who want to leverage isolated, replicable dev environments. Plans include:

      .box-wrapper.three
        .box
          p
            | Increased performance on a powerful cloud hosted VM

        .box
          p
            | Instant Provisioning - Sign Up and Start Coding in the cloud 30 seconds in Ruby/Rails, Python/Django, NodeJS or Go.

        .box
          p
            | Intuitive Web IDE - Work from any modern web browser

      .box-wrapper.three
        .box
          p
            | Native App Integration - Use you favorite text editor when you're on your home computer.

        .box
          p
            | Shareable Dev Environments - Easily pair program with up to 1 additional colleagues to enable Front End Developers & Designers to access development backend services.

        .box
          p
            | Live Preview - Get immediate feedback from colleagues and clients with shareable "staging" urls.

  article.cta
    .container
      a.btn.blue.submit href='http://aws.amazon.com/activate/benefits/special-offers/appdev/' Read more about applying


= render partial: 'layouts/footer', locals: { active: '' }
