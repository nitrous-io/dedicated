- @title = 'Orgs · Nitrous'
- @html_class = 'light'
- @body_id = 'orgs'
- @body_class = 'story'

.page
  .page-hero
    .container
      = render partial: 'layouts/webnav', locals: { active: 'education' }

      .hero-copy
        h2
          | Nitrous Orgs
        h3
          | Securely manage and administer your team's
          br
          | development environments

        a.btn.white href="/app/#/signup?intent=org" Sign Up For Orgs

  .notice.darker
    .container
      p
        span.new Orgs
        | Nitrous Orgs offers the advanced security, controls, and support your enterprise needs


  article.featurette.with-pulled-visual.cut-off.with-border
    .container
      .box-wrapper.text-on-left

        .box.auto.text
          .content
            h3.big-title Centralized Billing
            p
              | Nitrous Orgs brings you simplified billing for your team. The Org owner handles billing for all users.

        .box.auto
          .content
            .full-visual.window.centered
              .window-controls.osx.colored
                span
                span
                span
              = image_tag 'home/billing-next-org.png', width:"970", height:"524", alt: 'Nitrous Centralized Billing'


  article.featurette.with-pulled-visual.cut-off.with-border
    .container
      .box-wrapper.text-on-left

        .box.auto.text
          .content
            h3.big-title Org member Administration
            p
              | Quickly add and remove team members, and set their role within the organization.

        .box.auto
          .content
            .full-visual.window.centered
              .window-controls.osx.colored
                span
                span
                span
              = image_tag 'home/members-next-org.png', width:"970", height:"524", alt: 'Nitrous Org member Administration'


  article.quotes
    .carousel
      .carousel-inner

        input#carousel-1.carousel-open type="radio" name="carousel" aria-hidden="true" hidden="" checked="checked"
        .carousel-item
          .container
            .box-wrapper.one
              blockquote
                p
                  ' Flatiron is growing rapidly, and to offer our summer courses in multiple locations around the country, we need a
                  strong zero-install solution
                  | . Nitrous allows Flatiron's students to have&nbsp;
                  strong the flexibility of using any device
                  |  — Windows, Mac, Linux or Chromebook — and begin coding from day one.
                cite
                  = image_tag 'home/quote-avi-flombaum.png'
                  | Avi Flombaum
                  span , Dean and Co-Founder of The Flatiron School

        input#carousel-2.carousel-open type="radio" name="carousel" aria-hidden="true" hidden=""
        .carousel-item
          .container
            .box-wrapper.one
              blockquote
                p
                  ' Many companies — including Heroku — have attempted to move development to the cloud. Nitrous is
                  strong the first solution that doesn't feel like a toy
                  |. I can use it to get work done, today.
                cite
                  = image_tag 'home/quote-max-schoening.png'
                  | Max Schoening
                  span , Software Designer at Heroku

        label.carousel-control.prev.control-1 for="carousel-2"
          i.fa.fa-chevron-left
        label.carousel-control.next.control-1 for="carousel-2"
          i.fa.fa-chevron-right
        label.carousel-control.prev.control-2 for="carousel-1"
          i.fa.fa-chevron-left
        label.carousel-control.next.control-2 for="carousel-1"
          i.fa.fa-chevron-right


  article.featurette.full-window.with-border
    .container
      h3.big-title All your team's projects, in one place
      h4
        | Nitrous Orgs lets you create, administer, share, and snapshot
        br
        | your team's development projects from one convenient place

      .full-visual
        .window-controls.osx-safari
          span
          span
          span
          .nav-btn
          .nav-btn
          .url-address
          .nav-new-tab

        = image_tag 'home/dashboard-next-org.png', width:"970", height:"524"

  article.featurette.with-border
    .container

      h3.big-title Nitrous at a glance

      .box-wrapper.three
        .box.terminal
          h3.with-icon Built-in Terminal
          p Install libraries, manage dependencies and execute scripts in your project with terminal and full root access.

        .box.code
          h3.with-icon Zero-to-code in seconds
          p Stop letting valuable development time go to waste on system setup and maintenance. We’ll take care of that for you, so you never have to.

        .box.containers
          h3.with-icon Powered by Docker
          p Create & develop on multiple containers within a workspace, or create custom containers using Docker images.

      .box-wrapper.three
        .box.collaboration
          h3.with-icon Collaboration
          p Code collaboratively in real-time. Get help from a friend or co-worker, and code directly on the same machine in the cloud.

        .box.github
          h3.with-icon GitHub integration
          p Connect your GitHub account, pull repos, push code, and stay productive wherever you are.

        .box.snapshots
          h3.with-icon Snapshots
          p Preserve the state of any container and project environment, and stop worrying about breaking things.

      .box-wrapper.three
        .box.go-to-file
          h3.with-icon Go to file
          p Quickly jump between files with only a few keystrokes, just like your favorite desktop editor.

        .box.split-editing
          h3.with-icon Split Editing
          p Get the most out of your screen real-estate with split editing support. Edit files side by side.

        .box.ssh
          h3.with-icon Full SSH access
          p
            | Get complete control of your workstation and projects, and access them anytime with SSH.

      .centered
        a class="btn grey-outline" href="/features"
          | Learn more

  = render partial: 'layouts/companies', locals: { theme: 'with-border' }

  article.datasheet-cta.with-border
    .container
      = render partial: 'layouts/datasheet'

  article.cta
    .container
      h3.section-title Let's get started
      h4 Code your next project with Nitrous and see how well it works for your team
      a.btn.blue.submit href="/app/#/signup?intent=org" Sign Up for Orgs

= render partial: 'layouts/footer', locals: { active: 'orgs' }
