.code-editor

.ide-toolbar.bottom.status-bar
  .ide-toolbar-btns
    button.ui.btn click='didClickSave target="view"' disabled=view.savingDisabled
      | Save

    button.ui.btn click='didClickFind target="view"'
      | Find

    button.ui.btn click='didClickReplace target="view"'
      | Replace

  .ide-toolbar-btns
    unless collabEnabled
      button.ui.btn.disabled title='Upgrade your workspace to enable collaborative editing.'
        | Collab Disabled

    button.ui.btn.dropdown
      span
        if view.softTabs
          ' Soft Tabs:
        else
          ' Tab Size:
      span
        = view.tabSize

      ul.dropdown-menu.right
        each view.availableTabSizes
          li
            a click='didSelectTabSize size target="view"'
              if active
                i.fa.fa-check
              = size

        li.separator
        li
          a href='#' click='didClickSoftTabToggle target="view"'
            if view.softTabs
              i.fa.fa-check
            | Soft Tabs (Spaces)

    button.ui.btn.dropdown
      span
        = view.modeName
      span.caret
      ul.dropdown-menu.modes.right
        each view.availableModes
          li
            a href='#' click='didSelectMode mode target="view"'
              if active
                i.fa.fa-check
              = name
