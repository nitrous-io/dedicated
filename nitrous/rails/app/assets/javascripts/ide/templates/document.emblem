.code-editor

.ide-toolbar.bottom.special
  .ide-toolbar-btns
    button.ui.btn click='didClickSave target="view"' disabled=view.savingDisabled
      i.fa.fa-download
      '
      | Save
    button.ui.btn click='didClickFind target="view"'
      i.fa.fa-search
      '
      | Find
    button.ui.btn.dropdown.right
      span
        = view.modeName
      span.caret
      ul.dropdown-menu.modes
        each view.availableModes
          li
            a href='#' click='didSelectMode mode target="view"'
              if active
                i.fa.fa-check
              = name

    button.ui.btn.dropdown.right
      span
        if view.softTabs
          ' Soft Tabs:
        else
          ' Tab Size:
      span
        = view.tabSize
      .ui.dropdown-triangle

      ul.dropdown-menu
        each view.availableTabSizes
          li
            a click='didSelectTabSize size target="view"'
              if active
                i.fa.fa-check
              = size

        li.separator
        li
          a href='#' click='didClickSoftTabToggle target="view"'
            if view.softTabs
              i.fa.fa-check
            | Soft Tabs (Spaces)
