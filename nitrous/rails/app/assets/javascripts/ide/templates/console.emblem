App.IdeConsoleBorderView

.ide-toolbar.top
  ul.ide-tabs
    each content
      li class={active}
        a href='#' click='didClickTab this target="view"'
          button.close_tab_button.fa.fa-times click='didClickClose this target="view"' title='Close Tab'
          span Console
  .ide-toolbar-btns.ide-new-tab
    button.new_tab_button.small_button.btn.fa.fa-plus click='didClickNew target="view"' title='New Tab'
  .ide-toolbar-btns
    button.fullscreen_button.small_button.btn.fa.fa-arrows-alt click='didClickFullScreen target="view"' title='Toggle Full Screen'

.console_sessions
  each content
    App.IdeConsoleSessionView consoleSession=this
