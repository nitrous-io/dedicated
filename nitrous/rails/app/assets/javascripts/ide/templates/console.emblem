App.IdeConsoleBorderView

.ide-toolbar.ide-tab-bar.top
  ul.ui.tab-bar.ide-tabs
    each content
      li class={active:selected}
        a href='#' click='didClickTab this target="view"'
          button.close title='Close Tab' click='didClickClose this target="view"'
            i.fa.fa-times
          span Console
  .ide-toolbar-btns.ide-new-tab
    button.ui.btn.icon title='New Tab' click='didClickNew target="view"'
      i.fa.fa-plus
  .ide-toolbar-btns
    if minimized
      button.ui.btn.icon title='Maximize' click='didClickMaximizeConsole target="view"'
        i.fa.fa-caret-up
    else
      button.ui.btn.icon title='Minimize' click='didClickMinimizeConsole target="view"' class={view.hideMinimizeBtn:hide}
        i.fa.fa-minus
    button.ui.btn.icon title='Toggle Full Screen' click='didClickFullScreen target="view"' class={view.hideFullscreenBtn:hide}
      i.fa.fa-arrows-alt

.console-sessions
  each content
    App.IdeConsoleSessionView consoleSession=this
