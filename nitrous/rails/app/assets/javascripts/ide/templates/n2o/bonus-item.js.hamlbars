.title.clickable
  %span.pull-right
    =hb 'if view.completed' do
      %i.fa.fa-check
      {{ else }}
      %i.fa.fa-bolt
      {{ view.reward }}
  %i{ bind: { class: ':fa view.icon' } }
  %span.name
    {{ view.name }}
    =hb 'if view.completedOauthItem' do
      %a.disconnect(_action='didClickDisconnect target="view"') Disconnect
