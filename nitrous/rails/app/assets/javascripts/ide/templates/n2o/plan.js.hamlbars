%h3
  {{ name }}
  =hb 'if highlight' do
    %small Most Popular
.n2o-amount
  %span.amount {{ n2o_amount }}
  N2O

%ul.plan-features
  =hb 'each features' do
    %li
      {{ name }}
      =hb 'unless live' do
        %small (coming soon)

.pricing
  %div{ bind: { class: 'view.discounted:discounted :cost' } }
    {{ view.formattedPrice }}
    %span.interval / mo.
  =hb 'if view.discounted' do
    .discounted-price
      {{ view.formattedTotal }}
      %span.interval / mo.

=hb 'if view.isCurrentPlan' do
  .currentPlan
    %h6 Current Plan
