.modal-header
  %h3
    Share why you love Nitrous on Twitter
.modal-body
  {{view App.ComposeTweetDialogTextArea id="message" valueBinding="view.message"}}

.modal-footer
  %div{ bind: { class: ':tweet-counter view.messageInvalid:invalid' } }
    {{ view.messageLength }} / 140

  %button.btn(_action='didClickCancel target="view"')
    Cancel
  %button.btn(_action='didClickSendTweet target="view"'){ bind: { disabled: 'view.messageInvalid' } }
    Tweet
