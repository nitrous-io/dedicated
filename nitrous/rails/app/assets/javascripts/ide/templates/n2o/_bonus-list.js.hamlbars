%ul.dark-list
  =hb 'if content.accepted_invite' do
    {{view App.N2oBonusItemView name="Accept Invitation" icon="fa-star" completed=true}}

  {{view App.N2oBonusItemView name="Complete Sign Up" icon="fa-user" completed=true hiddenBinding="isIntro"}}
  =hb 'if App.config.paymentsEnabled' do
    {{view App.N2oBonusItemView name="Buy N2O" rewardBinding="bonusInfo.upgrade_account" icon="fa-dollar" targetBinding="view" route="n2o.upgrade" class="buy-n2o"}}
  {{view App.N2oBonusItemView name="Invite Friends & Colleagues" icon="fa-group" completedBinding="content.invite_friends" rewardBinding="bonusInfo.invite_friends" route="invites" hiddenBinding="isIntro"}}
  =hb 'if view.isUsingChrome' do
    {{view App.N2oBonusItemView name="Install Chrome App" icon="fa-google-plus-square" completedBinding="content.chrome_app" rewardBinding="bonusInfo.chrome_app" targetBinding="view" action="installChromeApp" hiddenBinding="isIntro"}}
  =hb 'if isIntro' do
    {{view App.N2oBonusItemView name="Connect GitHub"  service="github" icon="fa-github"      completedBinding="content.github"  rewardBinding="bonusInfo.github"  url="/users/auth/github" oauth=true popup=true}}
    {{view App.N2oBonusItemView name="Connect Google"  service="google" icon="fa-google-plus" completedBinding="content.google"  rewardBinding="bonusInfo.google"  url="/users/auth/google_oauth2" oauth=true popup=true width=500 height=600}}
    {{view App.N2oBonusItemView name="Connect Twitter" service="twitter" icon="fa-twitter"    completedBinding="content.twitter" rewardBinding="bonusInfo.twitter" url="/users/auth/twitter" oauth=true popup=true width=700 height=500}}
    =hb 'else'
    {{view App.N2oBonusItemView name="Tell Us How You Work" icon="fa-laptop" completedBinding="content.user_survey_1" rewardBinding="bonusInfo.user_survey_1" url="/user-survey-1"}}
    {{view App.N2oBonusItemView name="Get in line for Nitrous for Business" icon="fa-bolt" completedBinding="content.business_survey" rewardBinding="bonusInfo.business_survey" hiddenBinding="hideBusinessSurveyBonus" url="/business"}}
    {{view App.N2oBonusItemView name="Connect GitHub"   service="github"    icon="fa-github"      completedBinding="content.github"   rewardBinding="bonusInfo.github"    url="/users/auth/github"        oauth=true popup=true}}
    {{view App.N2oBonusItemView name="Connect Google"   service="google"    icon="fa-google-plus" completedBinding="content.google"   rewardBinding="bonusInfo.google"    url="/users/auth/google_oauth2" oauth=true popup=true width=500 height=600}}
    {{view App.N2oBonusItemView name="Connect Facebook" service="facebook"  icon="fa-facebook"    completedBinding="content.facebook" rewardBinding="bonusInfo.facebook"  url="/users/auth/facebook"      oauth=true popup=true width=1000 height=600}}
    {{view App.N2oBonusItemView name="Connect LinkedIn" service="linkedin"  icon="fa-linkedin"    completedBinding="content.linkedin" rewardBinding="bonusInfo.linkedin"  url="/users/auth/linkedin"      oauth=true}}
    {{view App.N2oBonusItemView name="Connect Twitter"  service="twitter"   icon="fa-twitter"     completedBinding="content.twitter"  rewardBinding="bonusInfo.twitter"   url="/users/auth/twitter"       oauth=true popup=true width=700 height=500}}

  {{view App.N2oBonusItemView name="Follow @nitrousio on Twitter" icon="fa-twitter"  completedBinding="content.twitter_follow" rewardBinding="bonusInfo.twitter_follow" enabledBinding="content.twitter" targetBinding="view" action="followOnTwitter"}}
  {{view App.N2oBonusItemView name="Tweet about Nitrous"       icon="fa-twitter"  completedBinding="content.tweet_sent"     rewardBinding="bonusInfo.tweet_sent" enabledBinding="content.twitter" targetBinding="view" action="composeTweet"}}
