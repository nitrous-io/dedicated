.controls.controls-row
  %div{ bind: { class: ':control-group card.errors.name:error :card-name :span8' } }
    %label.control-label.span6(for='card_name') Cardholder's Name
    {{view Ember.TextField id="card_name" valueBinding="card.name" autocompletetype="cc-name" class="span8"}}

.controls.controls-row
  %div{ bind: { class: ':control-group card.errors.number:error :card-number :span6' } }
    %label.control-label.span3(for='card_number') Credit Card Number
    {{view Ember.TextField id="card_number" valueBinding="card.number" autocompletetype="cc-number" class="span6"}}

  %div{ bind: { class: ':control-group card.errors.expiration:error :card-expiration :span2' } }
    %label.control-label.span2(for='card_expiration') Expiration
    {{view Ember.TextField id="card_expiration" placeholder="MM/YYYY" valueBinding="card.expiration" class="span2"}}

.controls.controls-row
  %div{ bind: { class: ':control-group card.errors.cvc:error :card-cvc :span4' } }
    %label.control-label.span2(for='card_cvc') CVC
    {{view Ember.TextField id="card_cvc" type="password" valueBinding="card.cvc" placeholder="CVC" autocomplete="off" class="span4"}}

  %div{ bind: { class: ':control-group card.errors.billingZip:error :card-billing-zip :span4' } }
    %label.control-label.span2(for='card_billing_zip') Zip / Postal Code
    {{view Ember.TextField id="card_billing_zip" valueBinding="card.billingZip" class="span4"}}

