.sidebar-body
  .ide-toolbar.top
    h2
      = App.router.ideController.content.name
    .ide-toolbar-btns
      button.ui.btn.icon title='Set Home Folder As Root' click='didClickSetHomeAsRoot target="view"' disabled=sftpSocketNotReady
        i.fa.fa-home
      button.ui.btn.icon title='Refresh Tree' click='didClickRefresh target="view"' disabled=sftpSocketNotReady
        i.fa.fa-refresh
  .tree contextMenu='didRightClickBackground target="view"'
    ul.root
      App.IdePathView path=rootPath
  .ide-toolbar.bottom
    .ide-toolbar-btns
      button.ui.btn click='didClickUpload target="view"' disabled=sftpSocketNotReady
        | Upload Files
      button.ui.btn click='didClickShowHidden target="view"' disabled=sftpSocketNotReady
        if hiddenFilesVisible
          | Hide Hidden
        else
          | Show Hidden
  App.IdeSidebarBorderView

App.IdePathContextMenuView viewName="contextMenuView"
App.IdeUploadDialogView
App.IdeConfirmDeletePathDialogView
