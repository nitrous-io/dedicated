.btn-toolbar
  .btn-group
    %button.btn(_action='didClickSave target="view"'){ bind: { disabled: 'view.savingDisabled' } }
      %i.fa.fa-download
      Save
  .btn-group
    %button.btn(_action='didClickFind target="view"')
      %i.fa.fa-search
      Find
  .btn-group
    %button.btn.dropdown-toggle(data-toggle='dropdown')
      %span {{ view.modeName }}
      %span.caret
    %ul.dropdown-menu
      =hb 'each view.availableModes' do
        %li
          %a(_action='didSelectMode mode target="view"')
            =hb 'if active' do
              %i.fa.fa-check
              =hb 'else'
              %i.icon-
            %span {{ name }}

  .btn-group
    %button.btn.dropdown-toggle(data-toggle='dropdown')
      %span
        =hb 'if view.softTabs' do
          Soft Tabs:
          = hb 'else'
          Tab Size:
      %span {{ view.tabSize }}
      %span.caret

    %ul.dropdown-menu
      =hb 'each view.availableTabSizes' do
        %li
          %a(_action='didSelectTabSize size target="view"')
            =hb 'if active' do
              %i.fa.fa-check
              =hb 'else'
              %i.icon-
            %span {{ size }}

      %li.divider
      %li
        %a(_action='didClickSoftTabToggle target="view"')
          =hb 'if view.softTabs' do
            %i.fa.fa-check
            =hb 'else'
            %i.icon-
          Soft Tabs (Spaces)

  .pull-right
    %button.collab-mode-btn.btn(title='Experimental!' _action='didClickCollabToggle target="view"'){ bind: { disabled: 'view.collabModeDisabled' }}
      %div{ bind: { class: ':stateOrb view.collabMode:on:off' } }
      =hb 'if view.collabModeDisabled' do
        Please Save
        =hb 'else'
        Collab Mode

.code_editor

