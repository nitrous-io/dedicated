.container
  {{view App.HeaderView}}

  %h2 Settings for {{ box.name }}

  {{view App.SettingsTabsView boxBinding="box" activeTab="snapshots"}}

  .settings-pane
    %ul.dark-list
      =hb 'each content' do
        %li
          .title
            %h3.name {{ name }}
            %p.time created {{ humanizedCreatedAt }}

            =hb 'if queued' do
              %button.btn(disabled=true) Queued&hellip;
            =hb 'if initiated' do
              %button.btn(disabled=true) Taking snapshot&hellip;
            =hb 'if completed' do
              =hb 'if deleting' do
                %button.btn(disabled=true) Deleting&hellip;
                =hb 'else'
                %button.btn.btn-danger(_action='didClickDelete this target="view"') Delete
            =hb 'if failed' do
              %a.btn.btn-info(disabled=true) Failed
            =hb 'if deleted' do
              %a.btn.btn-info(disabled=true) Deleted

      =hb 'unless length' do
        .dark-list
          .title
            %p You have not taken any snapshots of this box.

    .panel
      %button.btn.btn-primary(_action='didClickSnapshot target="view"')
        Take snapshot
      %button.btn(_action='didClickCancel target="view"')
        Cancel
