=hb 'with view.path' do
  =hb 'unless editable' do
    {{view App.IdePathNameView pathBinding="this"}}
    =hb 'else'
    {{view App.IdeEditablePathNameView pathBinding="this"}}

  =hb 'unless beingDeleted' do
    =hb 'if expanded' do
      %ul
        =hb 'each arrangedContent' do
          =hb 'if controller.hiddenFilesVisible' do
            {{view App.IdePathView pathBinding="this"}}
            =hb 'else'
            =hb 'unless hidden' do
              {{view App.IdePathView pathBinding="this"}}

