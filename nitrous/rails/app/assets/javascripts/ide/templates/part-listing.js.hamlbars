.pull-left
  %h5
    {{ humanized.name }} {{ version }}
  %p
    {{ humanized.description }}
  %p.error-message
    {{ errorMessage }}
.pull-right
  =hb 'if status' do
    =hb 'if running' do
      %button.btn.btn-primary(_action='didClickStop target="view"')
        Stop
      =hb 'else'
      %button.btn.btn-primary(_action='didClickStart target="view"')
        Start

  =hb 'if installed' do
    %button.btn.btn-danger(_action='didClickUninstall target="view"')
      Uninstall
    =hb 'else'
    %button.btn.btn-primary(_action='didClickInstall target="view"')
      Install
