.ui.topnav
  .primary-nav
    ul.nav
      each view.filteredMenu
        li.ui.dropdown
          a href='#'
            = name
          App.IdeMenuView content=this

  .secondary-nav
    ul.nav
      li.ui.dropdown
        a href='#'
          img.gravatar src={App.user.gravatar}
          = App.user.username
          .ui.dropdown-triangle
        ul.dropdown-menu.right
          li
            a href=view.dashboardURL target='_blank'
              | Dashboard
          li
            a href='/app/#/account' target='_blank'
              | Account Settings
          li.separator
          li
            a href='/app/#/logout'
              | Log Out

#about-nitrous.ui.modal
  .ui.card
    h2.card-header
      | About Nitrous
    .card-body
      .logo Nitrous
      p
        | TM and &copy; 2012-
        = view.currentYear
        '
        | Nitrous, Inc.
        br
        | All Rights Reserved.
    .card-footer
      .right
        button.ui.btn click='closeAboutDialog target="view"' OK
