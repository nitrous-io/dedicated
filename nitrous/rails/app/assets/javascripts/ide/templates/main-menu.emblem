.ui.topnav
  .primary-nav
    ul.nav
      each view.menu
        li.ui.dropdown
          a href='#'
            = name
          App.IdeMenuView content=this

  .secondary-nav
    ul.nav
      li.ui.dropdown
        a href='#'
          img.gravatar src={App.user.gravatar}
          = App.user.username
          .ui.dropdown-triangle
        ul.dropdown-menu.right
          li
            a href=view.dashboardURL
              | Dashboard
          li
            a href='/app/#/account'
              | Account Settings
          li.separator
          if App.usage
            li
              span.usage
                if App.usage.expired
                  span
                    i.fa.fa-exclamation-circle
                    | Daily usage exceeded
                  if App.usage.refreshIn
                    span
                      = durationInWords App.usage.refreshIn
                      |  until reset
                else
                  span.left Usage left:
                  span.right
                    = durationInWords App.usage.remaining
                  .progress-bar
                    .progress-bar-inner style=App.usage.progressBarStyle

            li.separator
          li
            a href='/app/#/logout'
              | Log Out

#about-nitrous.ui.modal
  .ui.card
    h2.card-header
      | About Nitrous
    .card-body
      .logo Nitrous
      p
        | TM and &copy; 2012-
        = view.currentYear
        '
        | Nitrous, Inc.
        br
        | All Rights Reserved.
    .card-footer
      .right
        button.ui.btn click='closeAboutDialog target="view"' OK
