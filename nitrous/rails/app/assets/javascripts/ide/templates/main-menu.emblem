.ui.topnav
  .primary-nav
    ul.nav
      each view.menu
        li.ui.dropdown
          a href='#'
            = name
          App.IdeMenuView content=this

  .secondary-nav
    ul.nav
      li.ui.dropdown
        a href='#'
          = App.currentUser.username
          .ui.dropdown-triangle
        ul.dropdown-menu.right
          li
            a href='#/account'
              | Account Settings
          li
            a href='/users/sign_out' data-method='delete' rel='nofollow'
              | Sign Out

#about_nitrousio.modal.hide.fade
  .modal-header
    h3 About Nitrous
  .modal-body
    p Nitrous
    p
      | Copyright &copy; 2012-
      = view.currentYear
      '
      | Nitrous Inc.
      br
      | All Rights Reserved.
  .modal-footer
    button.btn data-dismiss='modal'
      | Close
