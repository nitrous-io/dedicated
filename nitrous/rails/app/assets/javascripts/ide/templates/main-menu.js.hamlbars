=hb 'if view.hideMainMenu' do
  %h2 {{ App.router.indexController.content.name }}
  =hb 'else'
  .primary-nav
    %ul.nav
      =hb 'each view.menu' do
        %li.dropdown
          %a.dropdown-toggle(data-toggle='dropdown')
            %span {{ name }}
          {{view App.IdeMenuView contentBinding="this"}}

#about_nitrousio.modal.hide.fade
  .modal-header
    %h3 About Nitrous
  .modal-body
    %p Nitrous
    %p
      Copyright &copy; 2012-{{ view.currentYear }}
      Nitrous Inc.
      %br
      All Rights Reserved.
  .modal-footer
    %button.btn(data-dismiss='modal') Close
