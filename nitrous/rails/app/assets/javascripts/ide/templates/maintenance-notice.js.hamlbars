.modal-header
  %h3 Nitrous is currently under maintenance
.modal-body
  %p
    Please follow our
    %a.link(href='http://twitter.com/NitrousIO') Twitter account for updates
    or email us at
    %a.link(href='mailto:support@nitrous.io') support@nitrous.io
.modal-footer
  %button.btn(_action='didClickCloseIde target="view"')
    Close IDE
