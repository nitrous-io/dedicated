=hb 'unless view.hideHeader' do
  %header#page-header
    .header-logo
    %h1
      %a(href='#')<
        Nitrous
    =hb 'unless view.noMenu' do
      .header-nav
        {{view App.N2OView}}
        %ul
          %li
            %a(href='#/invites') Invites
          %li
            %a(href='#/boxes') Boxes
          %li
            %a(href='#/public_keys') Public Keys
          %li
            %a(href='/') Home
          %li.dropdown
            %a.dropdown-toggle(data-toggle='dropdown')
              %span Help
              %span.caret
            %ul.dropdown-menu
              %li
                %a(href='http://help.nitrous.io/' target='_blank') Help Center
              %li
                %a(href='http://help.nitrous.io/categories/faq' target='_blank') Frequently Asked Questions
              %li.divider
              %li
                %a(href='http://blog.nitrous.io/' target='_blank') Blog
              %li
                %a(href='http://updates.nitrous.io/' target='_blank') Updates
              %li.divider
              %li
                %a(href='mailto:support@nitrous.io?subject=Nitrous%20Feedback' target='_blank') Report an Issue...
          %li.dropdown
            %a.dropdown-toggle(data-toggle='dropdown')
              %span {{ App.currentUser.username }}
              %span.caret
            %ul.dropdown-menu
              =hb 'if App.config.paymentsEnabled' do
                %li
                  %a(href='#/n2o/upgrade')
                    Buy N2O...
              %li
                %a(href='#/n2o/bonus')
                  Get More N2O...
              %li.divider
              %li
                %a(href='/desktop' target='_blank') Download Desktop App
              %li.divider
              %li
                %a(href='/embed' target='_blank') Create Hack Button
              %li.divider
              %li
                %a(href='#/account')
                  Account Settings
              %li
                %a(href='/oauth/authorized_applications' target='_blank')
                  Applications
              %li.divider
              %li
                %a(href='/users/sign_out' data-method='delete' rel='nofollow')
                  Sign Out
  %hr#header-bottom

{{view App.FlashMessageView}}
