.modal-header
  %h3
    Are you
    %strong ABSOLUTELY
    sure?
.modal-body
  =hb 'if App.currentUser.hasMoreThanOneBox' do
    %p
      You currently have
      %strong {{ App.currentUser.visible_box_count }}
      boxes and
      %strong {{ App.currentUser.snapshot_count }}
      snapshots associated with your account.
    %p.warning
      This action may cause your excess boxes and snapshots to be deleted.
    %p
      Please make sure to retrieve any data that you may need before canceling.
  =hb 'unless App.currentUser.hasMoreThanOneBox' do
    %p
      Are you sure you wish to cancel your subscription?

.modal-footer
  %button.btn(_action='didClickCancel target="view"')
    No, Take me back
  %button.btn.btn-danger(_action='didClickProceed target="view"'){ bind: { disabled: 'cancelingSubscription' } }
    Yes, Cancel subscription
