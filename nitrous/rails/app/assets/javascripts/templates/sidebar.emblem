if App.hosts.length
  h2 Workspaces
  ul.hosts
    each host in App.hosts
      li class={host.selected:selected host.isTerminated:disabled}
        if host.isTerminated
          a.noclick href='#'
            h3
              = host.displayName
            .state-indicator.terminated title='terminated'
        else
          link-to 'host.index' host.slug
            h3
              = host.displayName
            .state-indicator class={host.state} title={host.state}
              span
                = host.state
          ul.containers
            if host.isRunning
              if host.sortedContainers.length
                each container in host.sortedContainers
                  li class={container.selected container.isTerminated:disabled}
                    if container.isTerminated
                      a.noclick href='#'
                        h4
                          = container.displayName
                        .state-indicator.terminated title='terminated'
                    else
                      link-to 'container.index' container.slug
                        h4
                          = container.displayName
                        .state-indicator class={container.state} title={container.state}
                          span
                            = container.state

if App.groupedSharedContainers.length
  h2 Shared
  ul.hosts
    each group in App.groupedSharedContainers
      li
          h3
            = group.username
          img.sharer-image src=group.gravatar width="20" height="20"
          ul.containers
            each container in group.items
              li class={container.selected container.isTerminated:disabled}
                link-to 'container.index' container.slug
                  .group
                    h4
                      = container.displayName

                  .state-indicator class={container.state} title={container.state}
                    span
                      = container.state

.app-download
  if App.billingProfile.free
    h3 Desktop Sync
    p Nitrous desktop app allows you to work on your code using your favorite editor. Available for paid users.

    a.ui.btn.raised href='#' click='upgradePaid'
      i.fa.fa-credit-card
      | &nbsp; Upgrade to paid
  else
    h3 Get Desktop Sync
    p Install Nitrous desktop app to work on your code using your favorite editor.

    a.ui.btn.raised href='#' click='downloadDesktopApp'
      i.fa.fa-download
      | &nbsp; Free Download
