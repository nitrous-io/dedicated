#onboarding-welcome.ui.modal
  .ui.card
    h2.card-header
      | Welcome to Nitrous!
    .card-body
      | Let's get your first setup started. It'll just take a few minutes.
    .card-footer
      .left
        a.ui.btn href='#' click='dismissOnboarding' Dismiss
      .right
        input.ui.btn.primary value='Get started' click='nextScreen'

#thankyou.ui.modal
  .ui.card
    h2.card-header
      | Thank you, and congratulations!
    .card-body
      | Your AJ cloud computer is being set up
    .card-footer
      .left
        .ui.checkbox
          = input type='checkbox' id='open-ide' checked=view.openIDE
          label
        label for='open-ide' Open the IDE when ready
      .right
        input.ui.btn.primary value='Done' click='dismissOnboarding'

if view.showGutter
  App.GutterOnboardingView