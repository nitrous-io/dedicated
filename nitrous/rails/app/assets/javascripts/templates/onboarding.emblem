#onboarding-welcome.ui.modal
  .ui.card
    h2.card-header
      | Welcome to Nitrous!
    .card-body
      | Let's get your first setup started. It'll just take a few minutes.
    .card-footer
      .left
        a.ui.text-btn href='#' click='dismissOnboarding' Dismiss
      .right
        a.ui.btn.primary.raised href='#' click='nextScreen' Get started

if view.showGutter
  App.GutterOnboardingView