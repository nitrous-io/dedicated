#onboarding-welcome.ui.modal
  .ui.card
    h2.card-header
      | Welcome to Nitrous!
    .card-body
      | Let's get your first setup started. It'll just take a few minutes.
    .card-footer
      .left
        a.ui.btn href='#' click='dismissOnboarding' Dismiss
      .right
        a.ui.btn.primary.raised href='#' click='nextScreen' Get started

#thankyou.ui.modal
  .ui.card
    h2.card-header
      | Thank you, and congratulations!
    .card-body
      | Your Nitrous machine is being set up – it should just take a few minutes.
    .card-footer
      .right
        .ui.checkbox
          = input type='checkbox' id='open-ide' checked=openIDE
          label
        label for='open-ide' Open the IDE when ready
        a.ui.btn.primary.raised href='#' click='dismissOnboarding' Done

if view.showGutter
  App.GutterOnboardingView
