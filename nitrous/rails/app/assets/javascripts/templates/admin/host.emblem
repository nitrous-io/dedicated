.card-body.bordered
  = if content.length
    table.ui.table
      tbody
        tr
          th ID
          th Slug
          th State
          th Provider State
          th Provider Identifier
          th Region
          th Plan
          th Actions

        = each
          tr
            td.id = id
            td.slug = slug
            td.state = state
            td
              = if liveHost.state
                = liveHost.state
              = else
                | -
            td title=liveHost.id
              = if liveHost.id
                = truncate liveHost.id 12
              = else
                | -
            td.region = region.slug
            td.plan = plan.slug
            td.actions
              button.ui.btn.raised click='showRestartDialog this' Restart
              button.ui.btn.raised click='showTerminateDialog this' Terminate
  = else
    p.note No hosts.

#terminate-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        | This action&nbsp;
        strong CANNOT
        | &nbsp;be undone!
      p
        | This will permanently delete the host&nbsp;
        strong
          | &ldquo;
          = parentController.terminateTargetHost.slug
          | &rdquo;
        | &nbsp; and all services, images, volumes, and archives within the host.
    .card-footer
      .right
        button.ui.btn click='cancelTerminate' Cancel
        button.ui.btn.danger.terminate-btn click='confirmTerminate' Terminate

#restart-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        | This will restart the host&nbsp;
        strong
          | &ldquo;
          = parentController.restartTargetHost.slug
          | &rdquo;
          | .
    .card-footer
      .right
        button.ui.btn click='cancelRestart' Cancel
        button.ui.btn.danger.terminate-btn click='confirmRestart' Restart
