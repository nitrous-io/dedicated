.card-header.bordered
  h2
    ' Viewing
    = model.firstObject.username

each user in model
  .card-body.bordered
    table.ui.table.horizontal
      tr
        th Full Name
        td
          = user.name

      tr
        th Email
        td
          = user.email

      tr
        th Billing State
        td
          = user.billingProfile.state

      if user.deletedAt
        tr
          th Deleted At
          td
            = user.deletedAt

      if user.bannedAt
        tr
          th Banned At
          td
            = user.bannedAt

      if user.bannedBy
        tr
          th Banned By
          td
            = user.bannedBy

  .card-footer
    .right
      unless user.deletedAt
        a.ui.btn href='#' click='switchUser user target="view"' Switch User
        a.ui.btn href='#' click='creditUser user target="view"' Credit User
      unless user.bannedAt
        a.ui.btn href='#' click='showBanDialog user target="view"' Ban User


#ban-user-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        | This will ban the user and email, CC and phone number associated.
      p
        ' Please type in the username of the user
        strong
          | (
          span.click-highlight
            = view.banUser.username
          ' )
        | to confirm:
      .ui.input-group
        Em.TextField class='focus' placeholder=view.banUser.username value=view.banUserConfirmation insertNewline=view.clickBan
    .card-footer
      .right
        button.ui.btn click='cancelBanDialog target="view"' Cancel
        button.ui.btn.danger.ban-btn click='confirmBan target="view"' disabled=view.banUserConfirmationInvalid Ban
