.card-header.bordered
  h2 Admin &mdash; Hosts

.card-body
  h3
    ' Unaccounted
    i.fa.fa-question-circle title="in Hostbuilder but not in DB"
    ' :
    = model.unaccounted.length
  .card-body.bordered
    = if model.unaccounted.length
      table.ui.table
        tbody
          tr
            th ID
            th State
            th IP Address
            th Freighterd Port
            th Actions

          = each model.unaccounted
            tr
              td title=id
                a href=providerUrl
                  = truncate id 12
              td = state
              td = ipAddress
              td = freighterdPort
              td.actions
                button.ui.btn.raised click='showTerminateUnaccountedDialog this' Terminate
    = else
      p.note No hosts.

  h3
    ' Non-running
    i.fa.fa-question-circle title="not running (according to DB or Hostbuilder)"
    ' :
    = model.nonRunning.length
  = render 'admin/host' model.nonRunning

  h3
    ' Dangling
    i.fa.fa-question-circle title="in DB but not in Hostbuilder"
    ' :
    = model.dangling.length
  = render 'admin/host' model.dangling

  h3
    ' OK:
    = model.ok.length
  h4
    ' Assigned:
    = model.assigned.length
  = render 'admin/host' model.assigned
  h4
    ' Preprovisioned:
    = model.preprovisioned.length
  = render 'admin/host' model.preprovisioned

#terminate-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        | This action&nbsp;
        strong CANNOT
        | &nbsp;be undone!
      p
        | This will permanently delete the host&nbsp;
        strong
          | &ldquo;
          if terminateTargetHost.slug
            = terminateTargetHost.slug
          if terminateTargetHost.id
            = truncate terminateTargetHost.id 12
          | &rdquo;
        | &nbsp; and all services, images, volumes, and archives within the host.
    .card-footer
      .right
        button.ui.btn click='cancelTerminate' Cancel
        button.ui.btn.danger.terminate-btn click='confirmTerminate' Terminate

#restart-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        | This will restart the host&nbsp;
        strong
          | &ldquo;
          = restartTargetHost.slug
          | &rdquo;
          | .
    .card-footer
      .right
        button.ui.btn click='cancelRestart' Cancel
        button.ui.btn.danger.terminate-btn click='confirmRestart' Restart
