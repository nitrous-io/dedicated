.ui.card
  .card-header.bordered
    h2 Admin &mdash; Amazon Hosts

  .card-body.bordered
    unless fetchingHosts
      button.ui.btn.raised click='refreshHosts' Refresh
    else
      button.ui.btn.raised disabled=true Refreshing...

    button.ui.btn.raised click='toggleHealthyHosts'
      if showHealthyHosts
        | Hide Healthy Hosts
      else
        | Show Healthy Hosts

    button.ui.btn.raised click='toggleProblemHosts'
      if showProblemHosts
        | Hide Problem Hosts
      else
        | Show Problem Hosts

    if showHealthyHosts
      h3
        ' Healthy:
        = hosts.healthy_hosts.length

      .ui.flex.horizontal
        .ui.input-group
          label.field-label for='region-filter'
            | Region Filter
          = input type='text' id='region-filter' name='region-filter' value=regionFilter

        .ui.input-group
          label.field-label for='slug-filter'
            | Slug Filter
          = input type='text' id='slug-filter' name='slug-filter' value=slugFilter

        .ui.input-group
          label.field-label for='username-filter'
            | Username Filter
          = input type='text' id='username-filter' name='username-filter' value=usernameFilter

      .card-body.bordered
        table.ui.table
          tbody
            tr
              th.checkbox
              th.actions Actions
              th HID
              th Vol ID
              th PID
              th Slug
              th Username
              th State
              th EC2 Region
              th Region
              th Plan

            = each entry in healthyHosts
              tr
                td.ui.checkbox
                  = input type='checkbox' checked=entry.uiState.selected
                  label
                td.actions
                  button.ui.btn.raised click='showHealthyHostDialog entry.db_host' Actions
                td.id
                  = entry.db_host.id
                  if entry.db_host.hotswap
                    | /H
                td
                td.id = entry.live_host.volume_id
                td.id = entry.live_host.id
                td.slug = entry.db_host.slug
                td.username = entry.db_host.username
                td.state = entry.db_host.state
                td.region = entry.live_host.region
                td.region
                  = region-slug entry.db_host.region_id
                td.plan
                  = plan-slug entry.db_host.plan_id

      .actions
        button.ui.btn.raised click='showHealthyHostBulkDialog' Bulk Healthy Host Actions

    if showProblemHosts
      h3
        ' Unaccounted :
        = hosts.unaccounted_hosts.length
      .card-body.bordered
        table.ui.table
          tbody
            tr
              th.checkbox
              th.actions Actions
              th PID
              th Vol ID
              th Slug
              th State
              th EC2 Region
              th IP Address
              th Freighterd Port

            = each host in hosts.unaccounted_hosts
              tr
                td.ui.checkbox
                  = input type='checkbox' checked=host.uiState.selected
                  label
                td.actions
                  button.ui.btn.raised click='showUnaccountedHostDialog host' Actions
                td title=id
                  = host.id
                td = host.volume_id
                td = host.name
                td = host.state
                td = host.region
                td = host.ip_address
                td = host.freighterd_port

      .actions
        button.ui.btn.raised click='showUnaccountedHostBulkDialog' Bulk Unaccounted Host Actions

      h3
        ' Dangling :
        = hosts.dangling_hosts.length

      .card-body.bordered
        table.ui.table
          tbody
            tr
              th.checkbox
              th.actions Actions
              th HID
              th PID
              th Vol ID
              th Slug
              th Username
              th DB State
              th Region
              th Plan

            = each host in hosts.dangling_hosts
              tr
                td.ui.checkbox
                  = input type='checkbox' checked=host.uiState.selected
                  label
                td.actions
                  button.ui.btn.raised click='showDanglingHostDialog host' Actions
                td.id
                  = host.id
                  if host.hotswap
                    | /H
                td.id = host.provider_identifier
                td.id = host.provider_storage_identifier
                td.slug = host.slug
                td.username = host.username
                td.state = host.state
                td.region
                  = region-slug host.region_id
                td.plan
                  = plan-slug host.plan_id

      .actions
        button.ui.btn.raised click='showDanglingHostBulkDialog' Bulk Dangling Host Actions

      h3
        ' Inconsistent :
        = hosts.inconsistent_hosts.length

      .card-body.bordered
        table.ui.table
          tbody
            tr
              th.checkbox
              th.actions Actions
              th HID
              th PID
              th Vol ID
              th Slug
              th Username
              th DB State
              th Live State
              th EC2 Region
              th Region
              th Plan

            = each entry in hosts.inconsistent_hosts
              tr
                td.ui.checkbox
                  = input type='checkbox' checked=entry.uiState.selected
                  label
                td.actions
                  button.ui.btn.raised click='showInconsistentDialog entry.db_host' Actions
                td.id
                  = entry.db_host.id
                  if entry.db_host.hotswap
                    | /H
                td.id = entry.live_host.id
                td.id = entry.live_host.volume_id
                td.slug = entry.db_host.slug
                td.username = entry.db_host.username
                td.state = entry.db_host.state
                td.state = entry.live_host.state
                td.region = entry.live_host.region
                td.region
                  = region-slug entry.db_host.region_id
                td.plan
                  = plan-slug entry.db_host.plan_id

      .actions
        button.ui.btn.raised click='showInconsistentHostBulkDialog' Bulk Inconsistent Host Actions

    .card-body.bordered
      unless fetchingHosts
        button.ui.btn.raised click='refreshHosts' Refresh
      else
        button.ui.btn.raised disabled=true Refreshing..

#action-modal-dialog.ui.modal
  .ui.card
    unless selectedAction
      if showFixBorn
        h2.card-header
          | Apply Hostbuilder settings
        .card-body
          p
            .ui.input-group
              = input type='text' required=true placeholder='Paste Hostbuilder log' value=hostbuilderLog
        .card-footer
          .right
            button.ui.btn click='cancelAction' Cancel
            if saving
              button.ui.btn disabled='disabled'
                i.spinner
                | Fixing...
            else
              button.ui.btn click='fixBorn' Fix

      h2.card-header
        | Perform Action
      .card-body
        p
          | Select action to perform on the following hosts:
        p
          = targetHostSlugs
      .card-footer
        .right
          button.ui.btn click='cancelAction' Cancel

          each action in availableActions
            button.ui.btn click='selectAction action'
              = action.name

    else
      h2.card-header
        | Confirm
        = selectedAction.name

      .card-body
        p
          | Are you ABSOLUTELY sure you want to
          = selectedAction.name
          ' the following host(s):
        p
          = targetHostSlugs
        p
          = selectedAction.description

      .card-footer
        .right
          button.ui.btn click='cancelAction' Cancel
          button.ui.btn.danger.terminate-btn click='confirmAction'
            | Confirm
            '
            = selectedAction.name
