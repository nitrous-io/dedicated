.card-header.bordered
  h2 Account Settings

form submit='save'
  .card-body
    .ui.input-group
      ul.ui.checkbox-group
        li
          .ui.checkbox
            = input type='checkbox' id='account-advanced' checked=advanced
            label
          label for='account-advanced' Show Advanced Options

  .card-footer.bordered
    .right
      if saving
        button.ui.btn disabled='disabled'
          i.spinner
          | Saving...
      else
        input.ui.btn.primary type='submit' disabled={saving} value='Save'

#confirm-advanced-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Warning!
    .card-body
      p
        | Changing advanced settings may affect the stability, security, and performance of your applications and containers, or even render them unusable.
      p
        | Only enable this if you know what you are doing.
    .card-footer
      .right
        button.ui.btn.primary click='hideModal target="view"' OK

.card-header.bordered
  h2 Account Details

form submit='updateDetails'

  .card-body
    .ui.input-group
      label.field-label for='email'
        | Email
      = input type='email' id='email' classNameBindings='view.emailFieldInvalid:error' value=controller.email

    .ui.input-group
      label.field-label for='password'
        | Password
      = input type='password' id='password' classNameBindings='view.passwordFieldInvalid:error' value=controller.password placeholder="Update password"

    if view.showConfirmPassword
      .ui.input-group
        label.field-label for='confirmPassword'
          | Confirm your Password
        = input type='password' id='confirmPassword' classNameBindings='view.passwordFieldInvalid:error' value=controller.confirmPassword

    .card-footer
      .right
        if updatingDetails
          button.ui.btn disabled='disabled'
            i.spinner
            | Updating...
        else
          input.ui.btn.primary type='submit' disabled={updatingDetails} value='Update'