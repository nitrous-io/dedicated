.card-header.bordered
  h2 Account

form submit='updateDetails'
  .card-body
    .ui.input-group
      label.field-label for='account-name'
        | Full Name
      = input type='text' id='account-name' value=controller.name autofocus=true

    .ui.input-group
      label.field-label for='account-email'
        | Email
      = input type='email' id='account-email' classNameBindings='view.emailFieldInvalid:error' value=controller.email
      .note
        if controller.unconfirmedEmail
          p
            ' An email confirmation is pending, emails will be sent to
            = controller.originalEmail
            '
            | until confirmed.

    .ui.input-group
      label.field-label for='account-password'
        | Password
      = input type='password' id='account-password' classNameBindings='view.passwordFieldInvalid:error' value=controller.password placeholder="New Password"

    .ui.input-group
      label.field-label for='account-confirm-password'
        | Confirm Password
      = input type='password' id='account-confirm-password' classNameBindings='view.passwordFieldInvalid:error' value=controller.confirmPassword

  .card-footer.bordered
    .right
      if updatingDetails
        button.ui.btn disabled='disabled'
          i.spinner
          | Saving...
      else
        input.ui.btn.primary type='submit' disabled={updatingDetails} value='Save'

if showGitHub
  .card-header.bordered
    h2 Integrations

  .card-body
    .integration
      .icon.fa.fa-github-square
      if view.showGitHubName
        .actions
          p
            | GitHub connected as '
            = App.userProfile.authorizedGitHubUserName
            | '
      else
        button.ui.btn.raised click='githubAuthorize' Connect with GitHub

  if view.showGitHubName
    .card-footer.bordered
      .right
        if view.showReconnectMessage
          p.note-text
          .notice-text
            i.fa.fa-warning
            | Please reconnect with GitHub to manage your public keys
        button.ui.btn.primary click='githubAuthorize' Reconnect with GitHub

unless App.billingProfile.isFreeOrNoCardState
  .card-header.bordered
    h2 Settings

  form submit='updateSettings'
    .card-body
      .ui.input-group
        ul.ui.checkbox-group
          li
            .ui.checkbox
              = input type='checkbox' id='account-advanced' checked=advanced
              label
            label for='account-advanced' Show Advanced Container Management Options
            p.note-text
              strong
                ' Warning:
              ' Using advanced container management features may affect the stability, security, and performance of your workspaces, or may even render them unusable.
              | Use at your own risk. Enable this option only if you know what you are doing.

    .card-footer.bordered
      .right
        if updatingSettings
          button.ui.btn disabled='disabled'
            i.spinner
            | Applying...
        else
          input.ui.btn.primary type='submit' disabled={updatingSettings} value='Apply'

.card-header.bordered
  h2 Delete My Account

.card-body
  if canDelete
    p
      | Deleting your account is irreversible.
      if !App.billingProfile.free
        '
        | Your credit card will be removed from file.
  else
    .notice-text
      i.fa.fa-warning
      '
      if canDeleteMessage
        = canDeleteMessage
        | .
      else
        | You cannot delete your account at this time.

.card-footer.bordered
  .right
      if canDelete
        if deleting
          button.ui.btn disabled='disabled'
            i.spinner
            | Deleting...
        else
          input.ui.btn.danger type='submit' click='showDeleteAccount target="view"' disabled={deleting} value='Delete My Account'
      else
        button.ui.btn disabled='disabled'
          i
          | Delete My Account

#deleteaccount-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        ' This will permanently delete your account!
      p
        ' Please type in your username
        strong
          | (
          span.click-highlight
            = App.user.username
          ' )
        | to confirm:
      .ui.input-group
        Em.TextField class='focus' placeholder=App.user.username value=view.deleteAccountConfirmation
    .card-footer
      .right
        button.ui.btn click='cancelDeleteAccount target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmDeleteAccount target="view"' disabled=view.deleteAccountConfirmationInvalid Delete My Account
