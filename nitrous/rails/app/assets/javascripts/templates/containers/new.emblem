#new-container-title.card-header.bordered
  h2 New Container

.screens
  if App.user.advanced
    .card-body
      .steps
        .step class={view.showImageScreen:active}
          span 1
          | Image
        .line
        .step class={view.showConfigScreen:active}
          span 2
          | Config
        .line
        .step class={view.showProgressScreen:active}
          span 3
          | Finish

  .screen class={view.showImageScreen::hide}
    form submit='goNextOrCreate target="view"'
      .card-body class={App.user.advanced:bordered}
        .ui.input-group
          label.field-label
            | Stack Templates

          ul.ui.selectable-list.templates
            each template in stackTemplates
              App.TemplateListItemView content=template selected=view.selectedTemplate

        .ui.input-group
          label.field-label
            | Basic Templates

          ul.ui.selectable-list.templates
            each template in basicTemplates
              App.TemplateListItemView content=template selected=view.selectedTemplate

        if App.user.advanced
          .ui.input-group
            label.field-label
              | Advanced Templates

            ul.ui.selectable-list.templates
              each template in advancedTemplates
                App.TemplateListItemView content=template selected=view.selectedTemplate

      if App.user.advanced
        .card-body.bordered
          .ui.input-group.custom-image
            label.field-label
              | Or, Use A Custom Image

            unless App.noHost
              ul.ui.checkbox-group class={view.hostImageOptionDisabled:disabled}
                li
                  .ui.checkbox
                    input type='radio' id='containers-new-option-host-image' name='option' value='host-image' disabled={view.hostImageOptionDisabled}
                    label
                  label for='containers-new-option-host-image' Use Image On This Workspace

              .ui.select.indent
                Ember.Select class='option-input' name='containers-new-option-host-image' content=selectedHost.images optionValuePath='content.slugAndTag' optionLabelPath='content.slugAndTag' value=view.selectedHostImage disabled=view.hostImageOptionDisabled

            ul.ui.checkbox-group class={saving:disabled}
              li
                .ui.checkbox
                  input type='radio' id='containers-new-option-custom-image' name='option' value='custom-image' disabled=saving
                  label
                label for='containers-new-option-custom-image' Specify Image Repository

            .indent
              = input type='text' class='option-input' name='containers-new-option-custom-image' placeholder='registry/repo:tag' pattern=App.Image.repoInputPattern title=App.Image.repoInputTitle value=view.customImage disabled=saving

      .card-body.bordered
        unless App.noHost
          unless App.singleHost
            .ui.input-group
              label.field-label
                | Workspace
              .ui.select
                Ember.Select name='host' content=App.hosts optionValuePath='content.slug' optionLabelPath='content.name' disabled=saving value=selectedHostSlug

        .ui.input-group
          label#select-container-name.field-label for='containers-new-name'
            | Name
          App.ContainerNameTextField id='containers-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' required=true disabled=saving value=name


      .card-footer.bordered
        .left
          a click='showHelp target=view'
            span.onboarding-trigger
        .right
          a.ui.btn href='#' click='cancel' Cancel
          input.ui.btn.primary.raised type='submit' disabled={view.createButtonDisabled} value={view.firstScreenButtonLabel}

  .screen class={view.showConfigScreen::hide}
    .card-body.bordered
      .ui.input-group
        label.field-label
          | Custom Port Bindings

      ul.ui.chips
        each portMapping in portMappings.rawPorts
          li
            = portMapping
            a.close href='#' click='removePortMapping portMapping' &times;

      form.container-config submit='addPortMapping'
        .ui.input-group.container-config-form
          table.ui.table
            thead
              tr
                th Public
                th Workspace Host Port
                th colspan='2' Container Port
            tbody
              tr
                td
                  .ui.checkbox
                    = input type='checkbox' checked=publicPort
                    label
                td
                  = input type='number' min='1' max='65535' step='1' placeholder='e.g., 63000 (optional)' value=hostPort
                td
                  = input type='number' min='1' max='65535' step='1' placeholder='e.g., 3000' required=true value=containerPort
                td
                  input.ui.btn.raised type='submit' disabled={view.addPortMappingButtonDisabled} value='Add'

        ul.ui.checkbox-group
          li
            .ui.checkbox
              = input type='checkbox' id='containers-config-publish-all' checked=publishAll
              label
            label for='containers-config-publish-all' Publish All Exposed Ports

    .card-body.bordered
      .ui.input-group
        label.field-label
          | Environment Variables

      ul.ui.chips
        each envVar in envVars
          li
            = envVar
            a.close href='#' click='removeEnvVar envVar' &times;

      form.container-config submit='addEnvVar'
        .ui.input-group.container-config-form
          table.ui.table
            thead
              tr
                th Key
                th Value
            tbody
              tr
                td
                  = input type='text' placeholder='e.g., FOO' required=true value=envKey
                td
                  = input type='text' placeholder='e.g., bar' required=true value=envValue
                td
                  input.ui.btn.raised type='submit' disabled={view.addEnvVarButtonDisabled} value='Add'

    unless App.noHost
      .card-body.bordered
        .ui.input-group
          label.field-label
            | Volume Mounts

        ul.ui.chips
          each volumeMount in volumeMounts
            li
              = volumeMount
              a.close href='#' click='removeVolumeMount volumeMount' &times;

        form.container-config submit='addVolumeMount'
          .ui.input-group.container-config-form
            table.ui.table
              thead
                tr
                  th Volume
                  th colspan='2' Mount Point (Optional)
              tbody
                tr
                  td
                    .ui.select
                      Ember.Select required=true name='containers-config-selected-volume' content=selectedHost.volumes optionValuePath='content.id' optionLabelPath='content.displayName' value=selectedVolumeId disabled=view.volumeDropdownDisabled
                  td
                    = input type='text' pattern=view.volumeMountpointInputPattern title=view.volumeMountpointInputTitle placeholder=selectedVolume.defaultMountpoint value=volumeMountpoint
                  td
                    input.ui.btn.raised type='submit' disabled={view.addVolumeMountButtonDisabled} value='Add'

    .card-body.bordered
      .ui.input-group
        label.field-label
          | Experimental Settings

      form.container-config
        ul.ui.checkbox-group
          li
            .ui.checkbox
              = input type='checkbox' id='containers-config-privileged' checked=privileged
              label
            label for='containers-config-privileged' Privileged Mode

    .card-footer.bordered
      .right
        a.ui.btn href='#' click='goBack target="view"' Back
        a.ui.btn.primary.raised disabled={view.createButtonDisabled} click='create target="view"'
          = view.advancedButtonLabel
    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=image.progress.progressDetail.current max=image.progress.progressDetail.total

  .screen class={view.showProgressScreen::hide}
    .card-body
      if createdContainer
        .notice-text
          | Your new container &ldquo;
          = name
          | &rdquo; has been created!
      else
        .notice-text
          | Your new container &ldquo;
          = name
          | &rdquo; is being created
          = ui-ellipsis

    .log class={view.showLog:show}
      .terminal-screen

    .card-footer.bordered
      if saving
        if image.progress.status
          .left
            p
              = image.progress.status
        .right
          button.ui.btn disabled='disabled'
            i.spinner
            | Creating...
          button.ui.btn click='toggleLog target="view"'
            if view.showLog
              | Hide Log
            else
              | Show Log
      else
        if createdContainer
          .right
              button.ui.btn click='toggleLog target="view"'
                if view.showLog
                  | Hide Log
                else
                  | Show Log
              button.ui.btn.primary click='showContainer' Show Container
              a.ui.btn.primary.raised.pulsate href=createdContainer.ideURL disabled=openingIDE click='openIDE'
                if openingIDE
                  i.spinner
                  | Opening IDE...
                else
                  | Open IDE
        else
          .right
            button.ui.btn click='goBack target="view"' Back
            button.ui.btn.primary.raised disabled={view.createButtonDisabled} click='create target="view"'
              = view.advancedButtonLabel
    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=image.progress.progressDetail.current max=image.progress.progressDetail.total
