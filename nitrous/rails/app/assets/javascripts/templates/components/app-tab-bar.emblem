li class={generalSelected:selected}
  link-to 'app.index' | Application
/li class={metricsSelected:selected}
  /link-to 'app.metrics' | Metrics
if model.appContainer
  li class={keysSelected:selected}
    link-to 'app.keys' | SSH Keys
  li class={portsSelected:selected}
    link-to 'app.ports' | Ports
/li class={snapshotsSelected:selected}
  /link-to 'app.snapshots' | Snapshots
