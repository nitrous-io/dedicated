.card-header.bordered
  h2 New Organization

form submit='create'
  .card-body
    .ui.flex.horizontal
      .form
        .ui.input-group
          label.field-label for='orgs-new-name'
            | Name
          = input type='text' name='name' id='orgs-new-name' disabled=saving value=model.name

        .ui.input-group
          label.field-label for='orgs-new-slug'
            | Slug
          = input type='text' name='name' id='orgs-new-slug' pattern=App.slug.inputPattern title=App.slug.inputTitle disabled=saving value=model.slug

        .ui.input-group
          label.field-label for='orgs-new-email'
            | Billing Email
          = input type='email' name='email' id='orgs-new-email' disabled=saving value=model.email

  .card-footer.bordered
    .right
      if saving
        button.ui.btn disabled='disabled'
          i.spinner
          | Creating...
      else
        input.ui.btn.primary.raised type='submit' disabled={view.createButtonDisabled} value='Create'
