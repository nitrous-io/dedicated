li class={generalSelected:selected}
  link-to 'container.index' | Container
li class={collaboratorsSelected:selected}
  link-to 'container.collaborators'
    | Collaborators
    if model.collaborators.length
      |  (
      = model.collaborators.length
      | )
if model.sshEnabled
  li class={keysSelected:selected}
    link-to 'container.keys' | SSH Keys
if App.user.advanced
  li class={configSelected:selected}
    link-to 'container.config' | Config
else
  li class={portsSelected:selected}
    link-to 'container.ports' | Ports
unless App.billingProfile.free
  li class={customDomainSelected:selected}
    link-to 'container.custom-domain' | Custom Domain
