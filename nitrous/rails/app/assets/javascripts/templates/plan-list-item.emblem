.content
  with view.content
    .name
      = name
    .price
      if totalPriceInDollars
        span
          ' $
        strong
          = totalPriceInDollars
        em
          '
          | / mo.
      else
        strong
          | FREE
    table.specs
      tr
        td
          span
            ' Up to
          = maxContainers
        td
          span Containers
      tr
        td
          = cpu
          '
          | Core
        td
          span Processor
      tr
        td
          = memory
        td
          span Memory
      tr
        td
          = storage
        td
          span Storage

  if plan.mostPopular
    .ribbon
      p Most Popular
