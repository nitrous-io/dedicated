.content
  with view.content
    .name
      = name
    .price
      if totalPriceInDollars
        span
          ' $
        strong
          = totalPriceInDollars
        em
          '
          | / mo.
      else
        strong
          | FREE
    table.specs
      tr
        td
          span
            ' Up to
          = maxContainers
        td
          span Containers
      tr
        td
          = cpu
          '
          | Core
        td
          span Processor
      tr
        if memory.length
          td
            = memory
          td
            span Memory
        else
          td colspan=2
      tr
        if storage.length
          td
            = storage
          td
            span Storage
        else
          td colspan=2

  if plan.mostPopular
    .ribbon
      p Most Popular
