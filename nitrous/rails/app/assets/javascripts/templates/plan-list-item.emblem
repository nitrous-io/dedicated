.content
  with view.content
    .name
      = name
    .desc
      = description
    .price
      if totalPriceInDollars
        if subscription
          .subscription
            ' $
            strong
              = totalPriceInDollars
            '
            ' /mo.
        else
          .monthly
            ' Up to $
            strong
              = totalPriceInDollars
            '
            ' /mo.
            sup ?
          .hourly
            strong
              = hourlyPriceInCents
            ' ¢ /hr.
            br
            small
              ' + $
              strong
                = basePriceInDollars
              '
              ' /mo. for storage
      else
        .free
          strong
            | FREE
    table.specs
      tr
        td
          ' Up to
          span = maxContainers
          '
          = plural maxContainers 'Container' 'Containers'
      tr
        td
          span = memory
          '
          | Memory
      tr
        td
          span = storage
          '
          | Storage
      /tr
        /if maxSnapshots
          /td
            /' Up to
            /span = maxSnapshots
            /'
            /= plural maxSnapshots 'Snapshot' 'Snapshots'
        /else
          /td No Snapshots
      if ssh
        tr
          td SSH Access
      if desktopApp
        tr
          td Desktop App
      if customDomains
        tr
          td Custom Domains
      if customTemplates
        tr
          td Custom Templates

  if plan.mostPopular
    .ribbon
      p Most Popular
