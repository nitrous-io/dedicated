.content
  with view.content
    .name
      = name
    .price
      if totalPriceInDollars
        .monthly
          ' Up to $
          strong
            = totalPriceInDollars
          '
          ' /mo.
          sup ?
        .hourly
          strong
            = hourlyPriceInCents
          ' ¢ /hr.
          br
          small
            ' + $
            strong
              = basePriceInDollars
            '
            ' /mo. for storage
      else
        .free
          strong
            | FREE
    table.specs
      tr
        td
          span
            ' Up to
          = maxContainers
        td
          span Containers
      /tr
        /td
          /= cpu
          /'
          /| Core
        /td
          /span Processor
      tr
        td
          = memory
        td
          span Memory
      tr
        td
          = storage
        td
          span Storage

  if plan.mostPopular
    .ribbon
      p Most Popular
