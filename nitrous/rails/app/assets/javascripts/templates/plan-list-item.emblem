.content
  with view.content
    .name
      = name
    .desc
      = description
    .price
      if totalPriceInDollars
        if subscription
          .subscription
            ' $
            strong
              = totalPriceInDollars
            '
            ' /mo.
        else
          .monthly
            ' Up to $
            strong
              = totalPriceInDollars
            '
            ' /mo.
            sup ?
          .hourly
            strong
              = hourlyPriceInCents
            ' ¢ /hr.
            br
            small
              ' + $
              strong
                = basePriceInDollars
              '
              ' /mo. for storage
      else
        .free
          strong
            | FREE
    table.specs
      tr
        td
          ' Up to
          span = maxContainers
          '
          = plural maxContainers 'Container' 'Containers'
      tr
        td
          span = memory
          '
          | Memory
      tr
        td
          span = storage
          '
          | Storage
      tr
        td SSH Access
      tr
        td Desktop App

  if plan.trialAvailable
    .ribbon
      p.free-trial Free Trial
  else
    if plan.mostPopular
      .ribbon
        p.most-popular Most Popular
