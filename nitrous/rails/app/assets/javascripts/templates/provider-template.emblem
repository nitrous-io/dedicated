.ui.card
  .card-header.bordered
    h2 Provider Template

  form autocomplete='on' submit='save'
    .card-body
      table.ui.table
        tbody
          tr
            th Field
            th Value
          tr
            td ID
            td = id
          tr
            td Name
            td = name
          tr
            td Region ID
            td = regionId
          tr
            td Plan ID
            td = planId
          tr
            td Provider
            td = provider
          tr
            td Created At
            td = dateabbr createdAt
          tr
            td Updated At
            td = dateabbr updatedAt
          tr
            td Preprovision Max
            td
              .ui.input-group 
                = input id='preprovision-max' type="number" max=9 value=preprovisionMax
                label.field-label for='preprovision-max' Value must be < 10.
          tr
            td Hourly Price
            td
              .ui.input-group 
                = input id='hourly-price' type="number" value=hourlyPrice
                label.field-label for='hourly-price' Price in millicents per hour
          tr
            td Config
            td
              .ui.input-group 
                = textarea id='config' value=configString rows='6'
                label.field-label for='config' Config must be key-value pairs of strings. No nested field allowed.

    .card-footer.bordered
      .right
        button.ui.btn = link-to 'provider-templates' | Back to List
        input.ui.btn.primary type='submit' value='Save' disable=saving
