if view.showPickContainer
  .card data-target="#new-container-title"
    h2
      | First, let's pick a container
    p
      | Containers come with
    .card-footer
      .left
        a.ui.btn href='#' click='dismissOnboarding' Dismiss
      .right
        if view.showNextButton
          input.ui.btn.primary value='Next' click='nextScreen'
        else
          input.ui.btn.primary value='Done' click='nextScreen'

