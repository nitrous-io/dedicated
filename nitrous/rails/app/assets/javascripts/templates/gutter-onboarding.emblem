if view.showPickContainer
  .card data-target="#new-container-title" data-arrow="top-right"
    .card-inner
      h2
        | First, let's pick a Container
      p
        ' Containers come with a set of
        strong
          | pre-installed tools, libraries
        ' , and/or
        strong
         ' frameworks
        | to enable you to start coding so you don't have to worry about setting up your development environment.
      = partial 'partials/onboarding-card-footer'

if view.showSelectContainerName
  .card data-target="#select-container-name" data-arrow="top-right"
    .card-inner
      h2
        | Select a Container name...
      p
        | We've given your container a name based on the starter template you've chosen above, but feel free to change the name to something more suitable.
      = partial 'partials/onboarding-card-footer'

if view.showSelectRegion
  .card data-target="#select-region" data-arrow="top-right"
    .card-inner
      h2
        | Select a region closest to you
      p
        | This is where your dedicated Nitrous machine is hosted. Selecting a region closest to you will optimize your experience with the platform.
      = partial 'partials/onboarding-card-footer'

if view.showSelectPlan
  .card data-target="#select-plan" data-arrow="top-right"
    .card-inner
      h2
        | Select a plan
      p
        | Choose a plan that fits your use case.  If you want more features, you can always upgrade in the future.
      = partial 'partials/onboarding-card-footer'

if view.showCardholdersName
  .card data-target="#cardholders-name" data-arrow="top-right"
    .card-inner
      h2
        | Enter your billing info
      p
        | You’re doing great! Just one last step before you can use your new workspace.
      = partial 'partials/onboarding-card-footer'

if view.showSharedContainer
  .card data-target="#container-index-view" data-arrow="top-right"
    .card-inner
      h2
        | You've been invited to collaborate on a container!
      p
        | Nitrous allows multiple people to collaborate on projects in the same container.
      p
        if App.selectedContainer.isRunning
          | Click on the IDE button to begin working together!
        else
          if App.selectedContainer.isStopped
            | Click on the Start button to start up the container.
      .card-footer
        .right
          a.ui.btn.primary.raised href='#' click='close' Done
