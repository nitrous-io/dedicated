.card-header.tab-bar-title
  h2
    if org
      link-to 'org.index' org.slug
        = org.name
      span.divider.fa.fa-angle-right
    if host
      link-to 'host.index' host.slug
        = host.displayName
      span.divider.fa.fa-angle-right
    link-to 'container.index' slug
      = displayName

  /button.ui.btn.mini.rename-btn
    /i.fa.fa-pencil

= outlet
