= outlet feedback
= outlet topnav
#body-wrapper.container
  #sidebar-wrapper
    = outlet sidebar
  #content-wrapper
    if App.restrictedAccount
      .notice-text
        i.fa.fa-warning
        '
        | Your Nitrous Pro account is currently restricted until you correct issues with your billing account.
    if App.usingOldDomain
      .notice-text.error
        i.fa.fa-warning
        '
        | We are changing our default domain from pro.nitrous.io to
        '
        a href="https://www.nitrous.io"
          | www.nitrous.io
        | . Please login and switch to
        '
        a href="https://www.nitrous.io"
          | www.nitrous.io
        | .
    = outlet content

if App.user.admin
  = outlet admin

= outlet onboarding
