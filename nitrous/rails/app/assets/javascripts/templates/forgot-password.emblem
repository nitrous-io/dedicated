= outlet topnav

.ui.card class={error:shake}
  .card-header.bordered
    h2 Reset Password

  form
    .card-body
      .ui.input-group
        label.field-label for='forgot-password-login'
          | Email or Username
        = input type='text' id='forgot-password-login' value=login

    .card-footer
      .right
        if saving
          button.ui.btn disabled='disabled'
            i.spinner
            | Processing...
        else
          button.ui.btn.primary.login-submit-btn click='sendResetToken' disabled={view.disableSubmitButton}
            | Send Reset Instructions

p.note
  | Already have an account?&nbsp;
  link-to 'login' | Log in
  | .

= partial 'partials/footer'
