= outlet topnav

.ui.card class={error:shake}
  h2.card-header Reset Password

  form
    .card-body
      .ui.input-group
        label.field-label for='reset-password-password'
          | Password
        = input type='password' id='reset-password-password' disabled=saving value=password

      .ui.input-group
        label.field-label for='reset-password-confirmPassword'
          | Confirm your Password
        = input type='password' id='reset-password-confirmPassword' disabled=saving value=confirmPassword

    .card-footer
      .right
        if saving
          button.ui.btn disabled='disabled'
            i.spinner
            | Processing...
        else
          button.ui.btn.primary.login-submit-btn click='resetPassword' disabled={view.disableSubmitButton}
            | Reset

p.note
  | Already have an account?&nbsp;
  link-to 'login' | Log in
  | .

= partial 'partials/footer'
