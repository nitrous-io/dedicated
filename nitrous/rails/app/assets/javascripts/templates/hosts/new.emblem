.card-header.bordered
  h2 New Application

.screens
  .screen class={view.showProgressScreen:hide}
    form submit='create target="view"'
      .card-body
        .ui.flex.horizontal
          .ui.input-group
            label.field-label for='hosts-new-name'
              | Name
            = input type='text' id='hosts-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' disabled=saving value=name

          .ui.input-group
            label.field-label for='hosts-new-slug'
              | Unique Slug
            = input type='text' id='hosts-new-slug' name='slug' classNameBindings='view.slugFieldInvalid:error' pattern=App.slug.inputPattern title=App.slug.inputTitle disabled=saving value=slug

      .card-body.bordered
        .ui.input-group
          label.field-label
            | Starter Template

          ul.starter-templates
            App.StarterTemplateView content='rails' iconUrl='https://nitrous-image-icons.s3.amazonaws.com/rails.png' selected=view.selectedTemplate name='Ruby on Rails'
            App.StarterTemplateView content=null selected=view.selectedTemplate name='Empty'

      .card-body.bordered
        .ui.flex.horizontal.region-size
          .ui.input-group
            label.field-label for='hosts-new-region'
              | Region
            .ui.select
              Ember.Select id='hosts-new-region' name='host' content=App.regions optionValuePath='content.slug' optionLabelPath='content.name' disabled=saving value=selectedRegionSlug

          .ui.input-group
            label.field-label for='hosts-new-plan'
              | Size
            .ui.select
              Ember.Select id='hosts-new-plan' name='host' content=App.plans optionValuePath='content.slug' optionLabelPath='content.displayName' disabled=saving value=selectedPlanSlug

      .card-body.bordered
        .ui.flex.horizontal
          .spec-box
            h4 Memory
            p
              = selectedPlan.memory

          .spec-box
            h4 SSD Storage
            p
              = selectedPlan.storage

          .spec-box
            h4 CPU Cores
            p
              = selectedPlan.cpu

          .spec-box
            h4 Price
            p
              | $&nbsp;
              = decimal selectedPlan.price 2
              | &nbsp;/&nbsp;mo.

        p.see-terms
          | Please review the&nbsp;
          a href='#' terms of service
          |, and&nbsp;
          a href='#' privacy policy
          |. All sales are final.

      .card-footer.bordered
        if saving
          if host.progress.status
            .left
              p
                = host.progress.status
          .right
            button.ui.btn disabled='disabled'
              i.spinner
              | Creating...
        else
          .right
            a.ui.btn href='#' click='cancel' Cancel
            input.ui.btn.primary type='submit' disabled={view.createButtonDisabled} value='Create'

  .screen class={view.showProgressScreen::hide}
    .card-body
      .terminal-screen
    .card-footer.bordered
      if saving
        if host.progress.status
          .left
            p
              = host.progress.status
        .right
          button.ui.btn disabled='disabled'
            i.spinner
            | Creating...
      else
        .right
          a.ui.btn.primary disabled={view.createButtonDisabled} click='create target="view"' Create
    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=host.progress.progressDetail.current max=host.progress.progressDetail.total
