.card-header.bordered
  if hasPendingContainer
    h2 Select Your Plan
  else
    h2 New Workspace

.screens
  .screen class={view.hideProgress::hide}
    form submit='create target="view"'
      .card-body
        .ui.input-group
          if hasPendingContainer
            .spec
              if App.pendingContainerData.selectedTemplate
                img src={App.pendingContainerData.selectedTemplate.iconUrl} class='template'
              .description
                span = name
          else
            label.field-label for='hosts-new-name'
              | Name
            = input type='text' id='hosts-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' required=true disabled=saving value=name autofocus=true

        .ui.input-group
          label.field-label for='hosts-new-region'
            | Region
          ul.ui.selectable-list.regions
            each region in App.regions
              App.RegionListItemView content=region selected=selectedRegion

        .ui.input-group
          label.field-label
            | Workspace Size

          ul.ui.selectable-list.plans
            each plan in plans
              App.PlanListItemView content=plan selected=selectedPlan

        if App.user.admin
          .notice-text The following settings are available for admin
          .ui.input-group
            .ui.checkbox
              = input type='checkbox' id='bypass-preprovision' checked=bypassPreprovision
              label
            label for='bypass-preprovision' &nbsp; Bypass Preprovision

          .ui.input-group
            label.field-label for='hosts-new-template-name' Template Name
            = input type='text' id='hosts-new-template-name' name='template-name' disabled=saving value=templateName

      .card-body.bordered
        .credit-message class='show'
          if App.billingProfile.isNoCardState
            if promoCodeInfo.content
              p.note-text
                ' You have
                span class='free-credit'
                  | $
                  = currency promoCodeInfo.content
                  '  Free Credit
                '
                | available.

          else
            if App.billingUsage.creditsRemaining
              p.note-text
                ' You have
                span class='credits-remaining'
                  | $
                  = currency App.billingUsage.creditsRemaining
                  '  Credit
                '
                | available.
            else
              if App.billingUsage.estimatedCharge
                p.note-text
                  ' Your current estimated billing charge is
                  span
                    | $
                    = currency App.billingUsage.estimatedCharge


        p.note-text.see-terms
          | Please review the&nbsp;
          a href='http://docs.nitrous.io/v1.0/docs/terms-of-use' terms of service
          |, and&nbsp;
          a href='http://docs.nitrous.io/v1.0/docs/privacy-policy' privacy policy
          |. All sales are final.

      .card-footer.bordered
        if saving
          if host.progress.status
            .left
              p
                = host.progress.status
          .right
            button.ui.btn disabled='disabled'
              i.spinner
              | Creating...
        else
          .right
            if hasPendingContainer
              button.ui.btn click='goBack' Back
            input.ui.btn.primary.raised type='submit' disabled={view.submitButtonDisabled} value={view.submitButtonLabel}

    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=host.progress.progressDetail.current max=host.progress.progressDetail.total

  .screen class={view.hideProgress:hide}
    .card-body
      .notice-text
        | Your new workspace &ldquo;
        = name
        | &rdquo; is being created
        = ui-ellipsis

    .log class={view.showLog:show}
      .terminal-screen

    .card-footer.bordered
      if saving
        if host.progress.status
          .left
            p
              = host.progress.status
        .right
          button.ui.btn disabled='disabled'
            i.spinner
            | Creating...
          button.ui.btn click='toggleLog target="view"'
            if view.showLog
              | Hide Log
            else
              | Show Log
      else
        .right
          if hasPendingContainer
            button.ui.btn click='goBack' Back
          a.ui.btn.primary.raised disabled={view.submitButtonDisabled} click='create target="view"'
            = view.submitButtonLabel
    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=host.progress.progressDetail.current max=host.progress.progressDetail.total
