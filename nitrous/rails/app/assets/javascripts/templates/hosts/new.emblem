.card-header.bordered
  if saving
    h2 Creating Workspace
  else
    if hasPendingContainer
      h2 Select Your Plan
    else
      h2 New Workspace

.screens
  .screen class={view.hideProgress::hide}
    form submit='create target="view"'
      .card-body
        if view.freePlanUnavailable
          .notice-text.error
            i.fa.fa-warning
            '
            | Free workspaces are not yet available for your region

        if orgs.length
          .ui.input-group
            label.field-label for='hosts-owner'
              | Owner

            .ui.select
              select name='hosts-new-owner' disabled=saving
                optgroup label='Personal'
                  option value='(user)'
                    | #{App.user.displayName} (You)
                optgroup label='Organization'
                  each org in orgs
                    option value=org.slug
                      = org.name

        .ui.input-group
          label.field-label for='hosts-new-name'
            | Workspace Name
          App.HostNameTextField id='hosts-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' required=true disabled=saving value=name autofocus=true

        .ui.input-group
          label#select-region.field-label for='hosts-new-region'
            | Region
          ul.ui.selectable-list.regions
            each region in App.regions
              App.RegionListItemView content=region selected=selectedRegion

        .ui.input-group
          label#select-plan.field-label
            | Plan

          .plan-groups
            if freePlans.length
              .free
                ul.ui.selectable-list.plans
                  each plan in freePlans
                    App.PlanListItemView content=plan selected=selectedPlan

            .paid
              ul.ui.selectable-list.plans.paid
                each plan in paidPlans
                  App.PlanListItemView content=plan selected=selectedPlan
              if App.billingProfile.creditForPaidPlan
                .bucket-group class={selectedPlan.isFreePlan:free}
                  .bucket
                  p.bucket-text
                    | $#{ App.billingProfile.creditForPaidPlan } credit will be applied

        p.note-text.see-faq
          ' Compare
          a href='/pricing' target='_blank' plans
          ' . View
          a href='/pricing#faq' target='_blank' frequently asked questions
          '
          | about billing and payment.

      .card-body.bordered
        .credit-message class='show'
          if App.billingProfile.isNoCardState
            if promoCodeInfo.content
              p.note-text
                ' You have
                span class='free-credit'
                  | $
                  = currency promoCodeInfo.content
                  '  Free Credit
                '
                | available.

          else
            if App.billingUsage.creditsRemaining
              p.note-text
                ' You have
                span class='credits-remaining'
                  | $
                  = currency App.billingUsage.creditsRemaining
                  '  Credit
                '
                | available.


        p.note-text.see-terms
          | Please review the&nbsp;
          a href='http://docs.nitrous.io/v1.0/docs/terms-of-use' terms of service
          |, and&nbsp;
          a href='http://docs.nitrous.io/v1.0/docs/privacy-policy' privacy policy
          |. All sales are final.

      if App.user.admin
        .card-body.bordered
          .notice-text The following settings are available for admin
          .ui.input-group
            .ui.checkbox
              = input type='checkbox' id='bypass-preprovision' checked=bypassPreprovision
              label
            label for='bypass-preprovision' &nbsp; Bypass Preprovision

          .ui.input-group
            label.field-label for='hosts-new-template-name' Template Name
            = input type='text' id='hosts-new-template-name' name='template-name' disabled=saving value=templateName


      .card-footer.bordered
        if saving
          if host.progress.status
            .left
              p
                = host.progress.status
          .right
            button.ui.btn disabled='disabled'
              i.spinner
              | Creating...
        else
          .left
            a click='showHelp target=view'
              span.onboarding-trigger
          .right
            if hasPendingContainer
              button.ui.btn click='goBack' Back
            input.ui.btn.primary.raised type='submit' disabled={view.submitButtonDisabled} value={view.submitButtonLabel}

    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=host.progress.progressDetail.current max=host.progress.progressDetail.total

  .screen class={view.hideProgress:hide}
    .card-body
      .notice-text
        | Your new workspace &ldquo;
        = name
        | &rdquo; is being created
        = ui-ellipsis

    .log class={view.showLog:show}
      .terminal-screen

    .card-footer.bordered
      if saving
        if host.progress.status
          .left
            p
              = host.progress.status
        .right
          button.ui.btn disabled='disabled'
            i.spinner
            | Creating...
          button.ui.btn click='toggleLog target="view"'
            if view.showLog
              | Hide Log
            else
              | Show Log
      else
        .right
          if hasPendingContainer
            button.ui.btn click='goBack' Back
          a.ui.btn.primary.raised disabled={view.submitButtonDisabled} click='create target="view"'
            = view.submitButtonLabel
    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=host.progress.progressDetail.current max=host.progress.progressDetail.total

#confirm-new-subscription-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Confirm New Subscription
    .card-body
      p
        ' You're adding another
        strong = selectedPlan.name
        '
        ' workspace to your account. You will be billed an additional
        strong
          | $
          = selectedPlan.totalPriceInDollars
          ' /mo.

    .card-footer
      .right
        button.ui.btn click='cancelConfirmation target="view"'
          | Cancel
        button.ui.btn.primary click='createWithConfirmation target="view"'
          | Continue
