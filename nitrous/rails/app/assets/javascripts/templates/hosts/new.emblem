.card-header.bordered
  h2 New Workspace

.screens
  .screen class={view.hideProgress::hide}
    form submit='create target="view"'
      if App.newUser
        .card-body
          .notice-text
            | Workspaces are private & secure computing environments where you can work on multiple applications simultaneously.
      .card-body
        .ui.flex.horizontal
          .ui.input-group
            label.field-label for='hosts-new-name'
              | Name
            = input type='text' id='hosts-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' disabled=saving value=name

          .ui.input-group
            label.field-label for='hosts-new-slug'
              | Unique Slug
            = input type='text' id='hosts-new-slug' name='slug' classNameBindings='view.slugFieldInvalid:error' pattern=App.slug.inputPattern title=App.slug.inputTitle disabled=saving value=slug

        .ui.input-group
          label.field-label for='hosts-new-region'
            | Region
          .ui.select
            Ember.Select id='hosts-new-region' name='host' content=App.regions optionValuePath='content.slug' optionLabelPath='content.name' disabled=saving value=selectedRegionSlug

        .ui.input-group
          label.field-label
            | Workspace Size

          ul.ui.selectable-list.plans
            each plan in App.plans
              App.PlanListItemView content=plan selected=selectedPlan

      .card-body.bordered
        p.credit-message
          ' You have
          span class=App.availableCreditClass
            ' $#{App.availableCredit}
            if App.newUser
              ' Free
            ' Credit
          '
          | available.

        p.see-terms
          | Please review the&nbsp;
          a href='#' terms of service
          |, and&nbsp;
          a href='#' privacy policy
          |. All sales are final.

      .card-footer.bordered
        if saving
          if host.progress.status
            .left
              p
                = host.progress.status
          .right
            button.ui.btn disabled='disabled'
              i.spinner
              | Creating...
        else
          .right
            input.ui.btn.primary type='submit' disabled={view.createButtonDisabled} value='Create'

    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=host.progress.progressDetail.current max=host.progress.progressDetail.total

  .screen class={view.hideProgress:hide}
    .card-body.download-app
      h3
        | Your new workspace &ldquo;
        = name
        | &rdquo; is being created
        = ui-ellipsis
      p In the meantime, download and install the Nitrous desktop application so you can start developing right away once the application is created.
      a.ui.btn.raised.primary click='downloadDesktopApp "hosts-new"' Download Desktop App

    .log class={view.showLog:show}
      .card-body.bordered
        .terminal-screen

    .card-footer.bordered
      if saving
        if host.progress.status
          .left
            p
              = host.progress.status
        .right
          button.ui.btn disabled='disabled'
            i.spinner
            | Creating...
          button.ui.btn click='toggleLog target="view"'
            if view.showLog
              | Hide Log
            else
              | Show Log
      else
        .right
          a.ui.btn.primary disabled={view.createButtonDisabled} click='create target="view"' Create
    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=host.progress.progressDetail.current max=host.progress.progressDetail.total
