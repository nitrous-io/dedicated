.card-header.bordered
  h2 New Workspace

.screens
  .screen class={view.hideProgress::hide}
    form submit='create target="view"'
      .card-body
        .notice-text
          | Workspaces are private dedicated servers where you can create and work on multiple development containers.
        .ui.input-group
          label.field-label for='hosts-new-name'
            | Name
          = input type='text' id='hosts-new-name' name='name' classNameBindings='view.nameFieldInvalid:error' required=true disabled=saving value=name autofocus=true

        .ui.input-group
          label.field-label for='hosts-new-region'
            | Region
          ul.ui.selectable-list.regions
            each region in App.regions
              App.RegionListItemView content=region selected=selectedRegion

        .ui.input-group
          label.field-label
            | Workspace Size

          ul.ui.selectable-list.plans
            each plan in App.plans
              App.PlanListItemView content=plan selected=selectedPlan

      .card-body.bordered
        .credit-message class={App.billingUsage.creditsRemaining:show}
          p.note-text
            ' You have
            span
              | $
              = currency App.billingUsage.creditsRemaining
              '  Credit
            '
            | available.

        p.note-text.see-terms
          | Please review the&nbsp;
          a href='http://docs.nitrous.io/v1.0/docs/terms-of-use' terms of service
          |, and&nbsp;
          a href='http://docs.nitrous.io/v1.0/docs/privacy-policy' privacy policy
          |. All sales are final.

      .card-footer.bordered
        if saving
          if host.progress.status
            .left
              p
                = host.progress.status
          .right
            button.ui.btn disabled='disabled'
              i.spinner
              | Creating...
        else
          .right
            input.ui.btn.primary.raised type='submit' disabled={view.createButtonDisabled} value='Create'

    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=host.progress.progressDetail.current max=host.progress.progressDetail.total

  .screen class={view.hideProgress:hide}
    .card-body
      .notice-text
        | Your new workspace &ldquo;
        = name
        | &rdquo; is being created
        = ui-ellipsis

    .log class={view.showLog:show}
      .terminal-screen

    .card-footer.bordered
      if saving
        if host.progress.status
          .left
            p
              = host.progress.status
        .right
          button.ui.btn disabled='disabled'
            i.spinner
            | Creating...
          button.ui.btn click='toggleLog target="view"'
            if view.showLog
              | Hide Log
            else
              | Show Log
      else
        .right
          a.ui.btn.primary.raised disabled={view.createButtonDisabled} click='create target="view"' Create
    = ui-progress hide=view.hideProgress indeterminate=view.indeterminateProgress value=host.progress.progressDetail.current max=host.progress.progressDetail.total
