= host-tab-bar selected='volumes' model=model

.card-body
  if records.loaded
    if records.length
      ul.ui.list.item-2-line
        each volume in records
          li.list-item
            .left-accessory
              .ui.checkbox
                input.record-checkbox type='checkbox' id={volume.inputId} value={volume.id}
                label
            .lines
              label for={volume.inputId}
                h4
                  = volume.displayName
                p
                  = volume.slug
                  span.sep
                  | Created&nbsp;
                  = ago volume.createdAt
                  span.sep
                  a href='#' click='calculateSize volume' Calculate Size
                  if volume.info
                    span.sep
                    = volume.info.size
                    | &nbsp;bytes

    else
      p.hint-text
        i.fa.fa-exclamation-circle
        | This application does not have any volumes.
  else
    p.hint-text
      i.spinner
      | Loading...

.card-footer.bordered
  .left
    if removing
      button.ui.btn disabled='disabled'
        i.spinner
        | Removing...
    else
      button.ui.btn click='askRemove target="view"' disabled=noneSelected Remove
  .right
    button.ui.btn.primary click='add' New Volume...

#confirm-remove-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you sure?
    .card-body
      p
        | Are you sure you want to remove the following volume
        if view.multipleSelected
          | s
        | ?
      ul.comma-separated
        each record in selected
          li
            | &ldquo;
            = record.displayName
            | &rdquo;

    .card-footer
      .right
        button.ui.btn click='cancelRemove target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmRemove target="view"' Remove
