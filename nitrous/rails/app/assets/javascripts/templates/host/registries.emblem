= host-tab-bar selected='registries' model=model

.card-body
  if records.loaded
    if records.length
      ul.ui.list.with-separators.item-2-line
        each registry in records
          li.list-item
            .left-accessory
              .ui.checkbox
                input.record-checkbox type='checkbox' id={registry.inputId} value={registry.id}
                label
            .lines
              label for={registry.inputId}
                h4
                  = registry.url
                p
                  = registry.username
                  if registry.email
                    | &nbsp;(
                    = registry.email
                    | )
    else
      p.hint-text
        i.fa.fa-exclamation-circle
        | This host is not connected to any Docker registry.
  else
    p.hint-text
      i.spinner
      | Loading...

.card-footer.bordered
  .left
    if removing
      button.ui.btn disabled='disabled'
        i.spinner
        | Removing...
    else
      button.ui.btn click='askRemove target="view"' disabled=noneSelected Remove
  .right
    button.ui.btn.primary click='add' Connect to Registry...

#confirm-remove-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you sure?
    .card-body
      p
        | Are you sure you want to remove the following registr
        if view.multipleSelected
          | ies
        else
          | y
        | ?
      ul.comma-separated
        each record in selected
          li
            | &ldquo;
            = record.url
            | &rdquo;

    .card-footer
      .right
        button.ui.btn click='cancelRemove target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmRemove target="view"' Remove
