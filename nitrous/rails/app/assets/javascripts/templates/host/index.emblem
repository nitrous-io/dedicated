= host-tab-bar selected='general' model=model

.card-body
  if pendingRespec
    unless isRespeccing
      .notice-text
        i.fa.fa-warning
          '
          ' You can complete upgrading this workspace to the
          = plan.name
          '
          ' plan.
          a click='respec' href='#' Upgrade Now
  else
    if updateAvailable
      unless isUpdating
        .notice-text
          i.fa.fa-warning
          if canUpdate
            '
            | There are updates available for this workspace.
            '
            a click='update' href="#" Update Now
          else
            | There are updates available for this workspace. Please stop your containers before updating.

  if hasError
    .notice-text.error
      i.fa.fa-warning
      '
      | There are issues connecting to your workspace. If this lasts more than 10 minutes, please contact support.

  if topAnnouncement
    .notice-text.multi-line
      i.fa.fa-warning
      '
      .group
        each msg in topAnnouncement.splitMessage
          .part
            if msg.break
              br
            else
              = msg.text

  table.ui.table.horizontal
    tr
      th State
      td
        .state-indicator class={state}
        = stateForDisplay
      th Uptime
      td.usage
        if view.hostStatsAvailable
          = durationInWords stats.uptime
        else
          span.empty &ndash;

    tr
      th Slug
      td
        span.click-highlight
          = slug
      th CPU Usage (%)
      td.usage
        if view.hostStatsAvailable
          ul.comma-separated
            each cpuUsage in stats.perCPUUsage
              li
                = toFixed cpuUsage 1
        else
          span.empty &ndash;

    tr
      th Region
      td
        = region.name
      th
        | Memory
        span.no-text-transform &nbsp;(MiB)
      td.usage
        if view.hostStatsAvailable
          = mebibytes stats.memoryUsage
          | &nbsp;/&nbsp;
          = mebibytes stats.memoryTotal
          ' &nbsp;
          a.ui.icon-btn.fa.fa-refresh href='#' click='refresh target="view"'
        else
          span.empty &ndash;

    tr
      th Size
      td
        = plan.name
      th
        | Storage
        span.no-text-transform &nbsp;(GiB)
      td.usage
        if view.hostStatsAvailable
          = gibibytes stats.storageUsage
          | &nbsp;/&nbsp;
          = gibibytes stats.storageTotal
          ' &nbsp;
          a.ui.icon-btn.fa.fa-refresh href='#' click='refresh target="view"'
        else
          span.empty &ndash;

    tr
      th Host
      td colspan='3'
        span.click-highlight
          = hostname

    tr
      th Created At
      td colspan='3'
        = dateabbr createdAt

    if liveDockerVersion
      tr
        th Docker ver
        td
          = liveDockerVersion
        th Freighterd ver
        td.usage
          = liveFreighterdVersion

.card-footer.bordered
  if isRunning
    .left
      if App.billingProfile.free
        button.ui.btn click='upgradePaid' Upgrade
        button.ui.btn click='showTerminateDialog target="view"' Terminate...
      else
        if canSafeStop
          button.ui.btn click='restart' Restart
          button.ui.btn click='stop' Stop
        else
          button.ui.btn click='showRestartDialog target="view"' Restart
          button.ui.btn click='showStopDialog target="view"' Stop
    .right
      button.ui.btn.primary class={containers.length::pulsate} click='newContainer' New Container...

  else
    if isTerminated
      .left
        button.ui.btn disabled='disabled' Terminated
    else
      if isOrphan
        .right
          button.ui.btn.primary click='showTerminateDialog target="view"' Terminate
      else
        if isStopped
          if App.billingProfile.free
            .left
              button.ui.btn click='upgradePaid' Upgrade

            .right
              button.ui.btn.primary disabled=App.usage.expired click='start' Start
              if subscription
                button.ui.btn click='showTerminateDialog target="view"' Cancel Plan
              else
                button.ui.btn click='showTerminateDialog target="view"' Terminate...
          else
            .left
              if subscription
                button.ui.btn click='showTerminateDialog target="view"' Cancel Plan
              else
                button.ui.btn click='showTerminateDialog target="view"' Terminate...
            .right
              button.ui.btn.primary click='start' Start
        else
          .left
            button.ui.btn disabled='disabled'
              i.spinner
              | Please Wait...

#terminate-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      ' Are you
      strong
        ' absolutely
      | sure?
    .card-body
      if App.billingProfile.free
        p
          strong
            | You will not be able to create another free workspace.
      if subscription
        p
          ' Your workspace
          strong
            | &ldquo;
            = displayName
            ' &rdquo;
          | will be deleted at the end of this billing cycle. (NOMERGE: Specify date)
      else
        p
          ' This action
          strong
            ' CANNOT
          | be undone!
        p
          ' This will permanently delete the workspace
          strong
            | &ldquo;
            = displayName
            ' &rdquo;
          | and all containers, images, volumes, and archives within the workspace.
      p
        ' Please type in the slug of the workspace
        strong
          | (
          span.click-highlight
            = slug
          ' )
        | to confirm:
      .ui.input-group
        Em.TextField class='focus' placeholder=slug value=view.terminateSlugConfirmation insertNewline=view.clickTerminate
    .card-footer
      .right
        button.ui.btn click='cancelTerminate target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmTerminate target="view"' disabled=view.terminateSlugConfirmationInvalid Terminate

#stop-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      ' Are you
      strong
        ' absolutely
      | sure?
    .card-body
      p Stopping your workspace now may cause its containers to not be shutdown cleanly.
      p You may want to stop your containers first.
    .card-footer
      .right
        button.ui.btn click='cancelStop target="view"' Cancel
        button.ui.btn.danger.stop-btn click='confirmStop target="view"' Stop Anyway

#restart-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      ' Are you
      strong
        ' absolutely
      | sure?
    .card-body
      p Restarting your workspace now may cause its containers to not be shutdown cleanly.
      p You may want to stop your containers first.
    .card-footer
      .right
        button.ui.btn click='cancelRestart target="view"' Cancel
        button.ui.btn.danger.restart-btn click='confirmRestart target="view"' Restart Anyway

#upgrade-complete-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Do More on Nitrous
    .card-body
      | Your upgraded workspace has:

      ul
        li
          i.fa.fa-check
          | No hourly limits
        li
          i.fa.fa-check
          ' Advanced container management &mdash;
          a href="http://docs.nitrous.io/v1.0/docs/advanced-container-management-options" target="_blank" learn more
        li
          i.fa.fa-check
          ' Access to Nitrous Desktop app &mdash;
          a href=App.desktopDownloadUrl target="_blank" download now
        if App.upgradeCredited
          li
            i.fa.fa-check
            | Your $
            = App.upgradeCredited
            '
            | credit has been applied!

      h3 Restart required

      p
        ' Your workspace needs to be restarted in order to increase its storage.

    .card-footer
      .right
        button.ui.btn click='hideUpgradeDialog target="view"'
          | Later
        button.ui.btn.primary click='respecNow target="view"'
          | Restart workspace now
