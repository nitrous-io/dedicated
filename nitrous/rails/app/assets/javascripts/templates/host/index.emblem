= host-tab-bar selected='general' model=model

.card-body
  if upgradeAvailable
    unless isUpgrading
      .notice-text
        i.fa.fa-warning
        if canUpgrade
          '
          | There are updates available for this workspace.
          '
          a click='upgrade' href="#" Update Now
        else
          | There are updates available for this workspace. Please stop your containers before updating.

  if topAnnouncement
    .notice-text.multi-line
      i.fa.fa-warning
      '
      .group
        each msg in topAnnouncement.splitMessage
          .part
            if msg.break
              br
            else
              = msg.text

  table.ui.table.horizontal
    tr
      th State
      td
        .state-indicator class={state}
        = state
      th Uptime
      td.usage
        if view.hostStatsAvailable
          = durationInWords stats.uptime
        else
          span.empty &ndash;

    tr
      th Slug
      td
        span.click-highlight
          = slug
      th CPU Usage (%)
      td.usage
        if view.hostStatsAvailable
          ul.comma-separated
            each cpuUsage in stats.perCPUUsage
              li
                = toFixed cpuUsage 1
        else
          span.empty &ndash;

    tr
      th Region
      td
        = region.name
      th
        | Memory
        span.no-text-transform &nbsp;(MiB)
      td.usage
        if view.hostStatsAvailable
          = mebibytes stats.memoryUsage
          | &nbsp;/&nbsp;
          = mebibytes stats.memoryTotal
          ' &nbsp;
          a.ui.icon-btn.fa.fa-refresh href='#' click='refresh target="view"'
        else
          span.empty &ndash;

    tr
      th Size
      td
        = plan.name
      th
        | Storage
        span.no-text-transform &nbsp;(GiB)
      td.usage
        if view.hostStatsAvailable
          = gibibytes stats.storageUsage
          | &nbsp;/&nbsp;
          = gibibytes stats.storageTotal
          ' &nbsp;
          a.ui.icon-btn.fa.fa-refresh href='#' click='refresh target="view"'
        else
          span.empty &ndash;

    tr
      th Host
      td colspan='3'
        span.click-highlight
          = hostname

    tr
      th Created At
      td colspan='3'
        = dateabbr createdAt

    if liveDockerVersion
      tr
        th Docker ver
        td
          = liveDockerVersion
        th Freighterd ver
        td.usage
          = liveFreighterdVersion

.card-footer.bordered
  if isRunning
    .left
      button.ui.btn click='restart' Restart
      if supportsStopStart
        button.ui.btn click='stop' Stop
      else
        button.ui.btn click='showTerminateDialog target="view"' Terminate...
    .right
      button.ui.btn.primary class={containers.length::pulsate} click='newContainer' New Container...
  else
    if isTerminated
      .left
        button.ui.btn disabled='disabled' Terminated
    else
      if isOrphan
        .right
          button.ui.btn.primary click='showTerminateDialog target="view"' Terminate
      else
        if isStopped
          if supportsStopStart
            .left
              button.ui.btn click='showTerminateDialog target="view"' Terminate...
            .right
              button.ui.btn.primary click='start' Start
          else
            .left
              button.ui.btn disabled='disabled'
                i.spinner
                | Please Wait...
        else
          .left
            button.ui.btn disabled='disabled'
              i.spinner
              | Please Wait...


#terminate-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        ' This action
        strong
          ' CANNOT
        | be undone!
      p
        ' This will permanently delete the workspace
        strong
          | &ldquo;
          = displayName
          ' &rdquo;
        | and all containers, images, volumes, and archives within the workspace.
      p
        ' Please type in the slug of the workspace
        strong
          | (
          span.click-highlight
            = slug
          ' )
        | to confirm:
      .ui.input-group
        Em.TextField class='focus' placeholder=slug value=view.terminateSlugConfirmation insertNewline=view.clickTerminate
    .card-footer
      .right
        button.ui.btn click='cancelTerminate target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmTerminate target="view"' disabled=view.terminateSlugConfirmationInvalid Terminate
