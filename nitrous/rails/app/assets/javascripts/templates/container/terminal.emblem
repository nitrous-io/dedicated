.terminal-window
  .tabs
    ul.ui.tab-bar.terminal-tab-bar
      li.selected
        a.noclick href='#' Terminal

    .fullscreen-btn
      button.ui.btn.mini title='Toggle Full Screen' click='toggleFullscreen target="view"'
        i.fa.fa-arrows-alt
        span Fullscreen
  .card-body.terminal-screen.monospace
.terminal-placeholder
