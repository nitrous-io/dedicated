= container-tab-bar selected='general' model=model

.card-body
  table.ui.table.horizontal
    tr
      th State
      td colspan='3'
        .state-indicator class={state}
        = stateForDisplay

    tr
      th Slug
      td colspan='3'
        span.click-highlight
          = slug

    if App.user.advanced
      tr
        th Image
        td colspan='3'
          span.click-highlight
            = image

      if cmd
        tr
          th CMD
          td colspan='3'
            ul.space-separated.blocks
              each cm in cmd
                li
                  span.click-highlight
                    = cm

      if entrypoint
        tr
          th ENTRYPOINT
          td colspan='3'
            ul.space-separated.blocks
              each ep in entrypoint
                li
                  span.click-highlight
                    = ep

    if App.user.advanced
      tr
        th Internal IP
        td
          if ipAddress
            span.click-highlight
              = ipAddress
          else
            span.empty &ndash;
        th Gateway IP
        td.right
          if gatewayIP
            span.click-highlight
              = gatewayIP
          else
            span.empty &ndash;
      tr
        th Started At
        td
          if startedAt
            = dateabbr startedAt
          else
            span.empty &ndash;
        th Finished At
        td.right
          if finishedAt
            = dateabbr finishedAt
          else
            span.empty &ndash;

      tr
        th Exit Code
        td colspan='3'
          span.click-highlight
            = exitCodeString
    tr
      th Created At
      td colspan='3'
        = dateabbr createdAt

    if isRunning
      tr
        th SSH URL
        td colspan='3'
          if sshURL
            if sshKeysAdded
              ui-trackable-link href=sshURL text=sshURL track=Mp.EventDashboardUserClickedSSHURL
          else
            if sshEnabled
              link-to 'container.keys' | Register your SSH key

      if previewURL
        tr
          th Preview URL
          td colspan='3'
            ui-trackable-link href=previewURL target='_blank' text=previewURL track=Mp.EventDashboardUserClickedPreviewURL

.card-footer.bordered
  if isRunning
    .left
      button.ui.btn click='stop' Stop
      button.ui.btn click='restart' Restart
      if App.user.advanced
        if canEdit
          button.ui.btn click='showSnapshotDialog target="view"' Snapshot...
    .right
      if App.user.advanced
        unless isNitrousImage
          button.ui.btn click='openLogs' Logs
          button.ui.btn click='openAttach' Attach
      a.ui.btn.primary href=ideURL disabled=openingIDE click='openIDE'
        if openingIDE
          i.spinner
          | Opening IDE...
        else
          | IDE
  else
    if isStopped
      .left
        if canEdit
          button.ui.btn click='showTerminateDialog target="view"' Terminate...
        if App.user.advanced
          if canEdit
            button.ui.btn click='showSnapshotDialog target="view"' Snapshot...
      .right
        if App.user.advanced
          unless isNitrousImage
            button.ui.btn click='openLogs' Logs
        button.ui.btn.primary click='start' Start
    else
      if isTerminated
        .left
          button.ui.btn disabled='disabled' Terminated
      else
        .left
          button.ui.btn disabled='disabled'
            i.spinner
            | Please Wait...

#terminate-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        | This action&nbsp;
        strong CANNOT
        | &nbsp;be undone!
      p
        ' This will permanently delete the container
        strong
          | &ldquo;
          = displayName
          ' &rdquo;
        | and all data stored within the container.
      p
        ' Please type in the slug of the container
        strong
          | (
          span.click-highlight
            = slug
          ' )
        | to confirm:
      .ui.input-group
        Em.TextField class='focus' placeholder=slug value=view.terminateSlugConfirmation insertNewline=view.clickTerminate
    .card-footer
      .right
        button.ui.btn click='cancelTerminate target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmTerminate target="view"' disabled=view.terminateSlugConfirmationInvalid Terminate

#snapshot-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | New Snapshot
    form submit='confirmSnapshot target="view"'
      .card-body
        .ui.input-group
          label.field-label for='snapshot-name'
            | Image Name/Tag
          = input type='text' id='snapshot-name' value=snapshotImageName required=true disabled=snapshotting pattern="^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$"
      .card-footer
        .right
          if snapshotting
            button.ui.btn disabled='disabled'
              i.spinner
              | Taking Snapshot...
          else
            a.ui.btn click='cancelSnapshot target="view"' Cancel
            input.ui.btn.primary type='submit' value='Take' disabled=view.snapshotImageNameEmpty
