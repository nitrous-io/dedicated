= container-tab-bar selected='general' model=model

.card-body
  table.ui.table.horizontal
    tr
      th State
      td colspan='3'
        .state-indicator class={state}
        = state

    tr
      th Slug
      td colspan='3'
        span.click-highlight
          = slug

    if sshURL
      tr
        th SSH URL
        td colspan='3'
          a href={sshURL}
            = sshURL

    tr
      th Created At
      td colspan='3'
        = dateabbr createdAt

.card-footer.bordered
  if isRunning
    .left
      if hasApp
        if isAppRunning
          button.ui.btn click='restartApp' Restart App
          button.ui.btn click='stopApp' Stop App
        else
          if isAppStopped
            button.ui.btn click='startApp' Start App
      button.ui.btn click='showSnapshotDialog target="view"' Snapshot...
    .right
      if supportsPreview
        a.ui.btn href=previewURL target='_blank' Preview
      if App.user.ideEnabled
        button.ui.btn click='openTerminal' Terminal
        a.ui.btn.primary href=ideURL target='_blank' IDE
      else
        button.ui.btn.primary click='openTerminal' Terminal
  else
    if isStopped
      .left
        button.ui.btn click='showSnapshotDialog target="view"' Snapshot...
      .right
        button.ui.btn.primary click='start' Start
    else
      if isTerminated
        .left
          button.ui.btn disabled='disabled' Terminated
      else
        .left
          button.ui.btn disabled='disabled'
            i.spinner
            | Please Wait...

#snapshot-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | New Snapshot
    form
      .card-body
        .ui.input-group
          label.field-label for='snapshot-name'
            | Image Name/Tag
          = input type='text' id='snapshot-name' value=snapshotImageName required=true disabled=snapshotting
    .card-footer
      .right
        if snapshotting
          button.ui.btn disabled='disabled'
            i.spinner
            | Taking Snapshot...
        else
          button.ui.btn click='cancelSnapshot target="view"' Cancel
          button.ui.btn.primary click='confirmSnapshot target="view"' disabled=view.snapshotImageNameEmpty Take
