= container-tab-bar selected='collaborators' model=model
.card-body
  if model.canEdit
    unless records.length
      .notice-text
        i.fa.fa-info-circle
        '
        | Collaborators can work with you in real-time in the IDE and have full console access.

  if records.loaded
    ul.ui.list.item-1-line.with-margins
      each collaborator in records
        li.list-item
          .left-accessory
            img.gravatar.medium src=collaborator.gravatar
          .lines
            h4
              if collaborator.username
                = collaborator.username
                if collaborator.name
                  '
                  | (#{collaborator.name})
              else
                = collaborator.pendingEmail
                |  (pending)

            p
              | Added&nbsp;
              = ago collaborator.createdAt

          if model.canEdit
            .right-accessory
              button.ui.btn click='showRemoveCollaborator collaborator'
                | Remove

          if collaborator.isSelf
            .right-accessory
              button.ui.btn click='showLeaveContainer collaborator'
                | Leave container

  else
    p.hint-text
      i.spinner
      | Loading...

  if model.canEdit
    .form-wrapper
      form.container-config submit='add'
        .ui.input-group.container-config-form
          table.ui.table
            thead
              tr
                th Add new collaborator
            tbody
              tr
                td
                  = input type='text' placeholder='Username or email' required=true value=username
                td
                  input.ui.btn.raised type='submit' value='Add'

.remove-collaborator-modal-dialog.ui.modal
  .ui.card
    h2.card-header Remove collaborator?
    .card-body
      p 
        strong
          = collaborator.username  
        '  will no longer have access to 
        strong
          = containerSlug
        ' .
    .card-footer
      .right
        button.ui.btn click='hideRemoveCollaborator' Cancel 
        button.ui.btn.secondary click='removeCollaborator' Remove 

.leave-container-modal-dialog.ui.modal
  .ui.card
    h2.card-header Leave container?
    .card-body
      p 
        ' You will no longer have access to  
        strong
          = containerSlug
        ' .
    .card-footer
      .right
        button.ui.btn click='hideLeaveContainer' Cancel 
        button.ui.btn.secondary click='leaveContainer' Leave 
