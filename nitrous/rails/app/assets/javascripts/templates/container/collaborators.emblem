= container-tab-bar selected='collaborators' model=model
.card-body
  if model.canEdit
    unless hasRecords
      .notice-text
        i.fa.fa-info-circle
        | Collaborators can work with you in real-time in the IDE and have full console access.


  if records.loaded
    ul.ui.list.item-1-line.with-margins
      each collaborator in records
        li.list-item class={collaborator.pendingRemove:pending-removal}
          .left-accessory
            img.gravatar.medium src=collaborator.gravatar
          .lines
            h4
              = collaborator.username
            p
              | Added&nbsp;
              = ago collaborator.createdAt
          if model.canEdit
            .right-accessory
              if collaborator.pendingRemove
                button.ui.btn click='toggle collaborator target="view"'
                  i.fa.fa-undo
              else
                button.ui.btn click='toggle collaborator target="view"'
                  i.fa.fa-close

      each pend in pending
        li.list-item class={pend.error:item-error}
          .left-accessory
            span.gravatar.medium.empty
          .lines
            h4
              = pend.username
            if pend.error
              p.error
                = pend.error
          if model.canEdit
            .right-accessory
              button.ui.btn click='removePending pend'
                i.fa.fa-close
  else
    p.hint-text
      i.spinner
      | Loading...

  if model.canEdit
    .form-wrapper
      form.container-config submit='add'
        .ui.input-group.container-config-form
          table.ui.table
            thead
              tr
                th Add new collaborator
            tbody
              tr
                td
                  = input type='text' placeholder='Username or email' required=true value=username
                td
                  input.ui.btn.raised type='submit' value='Add'

if model.canEdit
  .card-footer.bordered
    .right
      if saving
        button.ui.btn disabled='disabled'
          i.spinner
          | Saving...
      else
        button.ui.btn click='applyChanges' class={changes:primary} Apply Changes
