= container-tab-bar selected='config'

.card-body
  .ui.input-group
    label.field-label
      | Volume Mounts

  form submit='addVolumeMount'
    .ui.input-group
      ul.ui.chips
        each volumeMount in volumeMounts
          li
            = volumeMount
            a.close href='#' click='removeVolumeMount volumeMount' &times;
        each volumeMount in volumeMountsRO
          li.disabled title='This volume mount cannot be changed.'
            = volumeMount

      table.ui.table
        thead
          tr
            th Volume
            th colspan='2' Mount Point (Optional)
        tbody
          tr
            td
              .ui.select
                Ember.Select required=true name='containers-config-selected-volume' content=host.volumes optionValuePath='content.id' optionLabelPath='content.displayName' value=selectedVolumeId disabled=hostVolumesIsEmpty
            td
              = input type='text' pattern=view.volumeMountpointInputPattern title=view.volumeMountpointInputTitle placeholder=selectedVolume.defaultMountpoint value=volumeMountpoint
            td
              input.ui.btn.raised type='submit' disabled={view.addVolumeMountButtonDisabled} value='Add'

.card-body.bordered
  .ui.input-group
    label.field-label
      | Port Bindings

    form submit='addPortBinding'
      .ui.input-group
        ul.ui.chips
          each portBinding in portBindings
            li
              = portBinding
              a.close href='#' click='removePortBinding portBinding' &times;

        table.ui.table
          thead
            tr
              th Public
              th Host Port (Optional)
              th colspan='2' Container Port
          tbody
            tr
              td
                .ui.checkbox
                  = input type='checkbox' checked=publicPort
                  label
              td
                = input type='number' min='1' max='65535' step='1' placeholder='63000' value=hostPort
              td
                = input type='number' min='1' max='65535' step='1' placeholder='3000' required=true value=containerPort
              td
                input.ui.btn.raised type='submit' disabled={view.addPortBindingButtonDisabled} value='Add'

      ul.ui.checkbox-group
        li
          .ui.checkbox
            = input type='checkbox' id='containers-config-publish-all' checked=publishAll
            label
          label for='containers-config-publish-all' Publish All Exposed Ports

.card-body.bordered
  .ui.input-group
    label.field-label
      | Environment Variables
  form submit='addEnvVar'
    .ui.input-group
      ul.ui.chips
        each envVar in envVars
          li
            = envVar
            a.close href='#' click='removeEnvVar envVar' &times;
        each envVar in envVarsRO
          li.disabled title='This environment variable cannot be removed.'
            = envVar

      table.ui.table
        thead
          tr
            th Key
            th Value
        tbody
          tr
            td
              = input type='text' placeholder='KEY' required=true value=envKey
            td
              = input type='text' placeholder='value' required=true value=envValue
            td
              input.ui.btn.raised type='submit' disabled={view.addEnvVarButtonDisabled} value='Add'

.card-footer.bordered
  .right
    if configuring
      button.ui.btn disabled='disabled'
        i.spinner
        | Configuring...
    else
      button.ui.btn.primary click='askApply target="view"' Apply Changes

#confirm-apply-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you sure?
    .card-body
      p Changing container configuration may render your container unusable. Proceed with caution.
      p Are you sure you want to apply changes?

    .card-footer
      .right
        button.ui.btn click='cancelApply target="view"' Cancel
        button.ui.btn.primary click='confirmApply target="view"' Apply
