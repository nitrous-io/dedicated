= container-tab-bar selected='config' model=model

.card-body
  if model.canEdit
    .notice-text
      i.fa.fa-warning
      '
      | Applying configuration changes will restart your container. Save your work before you proceed.

  .ui.input-group
    label.field-label
      | Port Mappings

  unless config
    p.hint-text
      i.spinner
      | Loading...

  ul.ui.chips
    each portMapping in portMappings.content
      li class={view.formDisabled:disabled}
        App.PortMappingView content=portMapping readonly=view.formDisabled

  if model.canEdit
    form.container-config submit='addPortMapping'
      .ui.input-group.container-config-form
        table.ui.table
          thead
            tr
              th Public
              th Workspace Port
              th Container Port
              th colspan='2' Protocol
          tbody
            tr
              td
                .ui.checkbox
                  = input type='checkbox' checked=publicPort disabled=view.formDisabled
                  label
              td
                = input type='number' min='1' max='65535' step='1' placeholder='e.g. 80, 443 (optional)' value=hostPort disabled=view.formDisabled
              td
                = input type='number' min='1' max='65535' step='1' placeholder='a port from 1 - 65535' required=true value=containerPort disabled=view.formDisabled
              td
                .ui.select
                  Ember.Select required=true value=protocol content=protocolOptions optionValuePath='content.id' optionLabelPath='content.displayName' disabled=view.formDisabled
              td
                input.ui.btn.raised type='submit' disabled={view.addPortMappingButtonDisabled} value='Add' disabled={view.formDisabled}

.card-body.bordered
  .ui.input-group
    label.field-label
      | Environment Variables

  unless config
    p.hint-text
      i.spinner
      | Loading...

  ul.ui.chips
    each envVar in envVars
      li class={view.formDisabled:disabled}
        = envVar
        unless view.formDisabled
          a.close href='#' click='removeEnvVar envVar' &times;
    each envVar in envVarsRO
      li.disabled title='This environment variable cannot be removed.'
        = envVar

  if model.canEdit
    form.container-config submit='addEnvVar'
      .ui.input-group.container-config-form
        table.ui.table
          thead
            tr
              th Key
              th Value
          tbody
            tr
              td
                = input type='text' placeholder='e.g., FOO' required=true value=envKey disabled=view.formDisabled
              td
                = input type='text' placeholder='e.g., bar' required=true value=envValue disabled=view.formDisabled
              td
                input.ui.btn.raised type='submit' disabled={view.addEnvVarButtonDisabled} value='Add' disabled={view.formDisabled}

.card-body.bordered
  .ui.input-group
    label.field-label
      | Volume Mounts

  unless config
    p.hint-text
      i.spinner
      | Loading...

  ul.ui.chips
    each volumeMount in volumeMounts
      li class={view.formDisabled:disabled}
        = volumeMount
        unless view.formDisabled
          a.close href='#' click='removeVolumeMount volumeMount' &times;

  if model.canEdit
    form.container-config submit='addVolumeMount'
      .ui.input-group.container-config-form
        table.ui.table
          thead
            tr
              th Volume
              th colspan='2' Mount Point (Optional)
          tbody
            tr
              td
                .ui.select
                  Ember.Select required=true name='containers-config-selected-volume' content=host.volumes optionValuePath='content.id' optionLabelPath='content.displayName' value=selectedVolumeId disabled=view.volumeDropdownDisabled
              td
                = input type='text' pattern=view.volumeMountpointInputPattern title=view.volumeMountpointInputTitle placeholder=selectedVolume.defaultMountpoint value=volumeMountpoint disabled=view.formDisabled
              td
                input.ui.btn.raised type='submit' disabled={view.addVolumeMountButtonDisabled} value='Add' disabled={view.formDisabled}

.card-body.bordered
  .ui.input-group
    label.field-label
      | Experimental Settings

      ul.ui.checkbox-group
        li
          .ui.checkbox
            = input type='checkbox' id='containers-config-privileged' checked=privileged disabled=view.formDisabled
            label
          label for='containers-config-privileged' Privileged Mode

if model.canEdit
  .card-footer.bordered
    .right
      if saving
        button.ui.btn disabled='disabled'
          i.spinner
          | Applying Changes...
      else
        button.ui.btn.primary click='askApply target="view"' disabled={view.formDisabled} Apply Changes

  #confirm-apply-modal-dialog.ui.modal
    .ui.card
      h2.card-header
        | Are you sure?
      .card-body
        p Changing container configuration may render your container unusable. Proceed with caution.
        p Are you sure you want to apply changes?

      .card-footer
        .right
          if saving
            button.ui.btn disabled='disabled'
              i.spinner
              | Applying Changes...
          else
            button.ui.btn click='cancelApply target="view"' Cancel
            button.ui.btn.primary click='confirmApply target="view"' Apply
