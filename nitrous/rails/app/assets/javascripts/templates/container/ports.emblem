= container-tab-bar selected='ports' model=model

.card-body
  if model.canEdit
    .notice-text
      i.fa.fa-warning
      '
      | Applying port changes will restart your container. Save your work before you proceed.

  .ui.input-group
    label.field-label
      | Port Mappings

  ul.ui.chips
    each portMapping in portMappings.content
      li class={view.formDisabled:disabled}
        unless portMapping.public
          i.fa.fa-lock
          '
        if portMapping.hostPort
          = portMapping.hostPort
        else
          if portMapping.assignedHostPort
            = portMapping.assignedHostPort
            |  (dynamic)
          else
            | dynamic
        '
        ' &rarr;
        = portMapping.containerPort
        | /
        = portMapping.protocol
        unless view.formDisabled
          a.close href='#' click='removePortMapping portMapping' &times;
    else
      p.hint-text
        i.fa.fa-exclamation-circle
        | No port mappings

  if model.canEdit
    form.container-config submit='add'
      .ui.input-group.container-config-form
        table.ui.table
          thead
            tr
              th
                abbr title='Use this port as the preview port' Preview
              th Workspace Port
              th Container Port
              th colspan='2' Protocol
          tbody
            tr
              td
                .ui.checkbox
                  = input type='checkbox' checked=setPreviewPort disabled=view.formDisabled
                  label
              td
                = input type='number' min='1' max='65535' step='1' placeholder='e.g. 80, 443 (optional)' value=hostPort disabled=view.formDisabled
              td
                = input type='number' min='1' max='65535' step='1' placeholder='a port from 1 - 65535' required=true value=containerPort disabled=view.formDisabled
              td
                .ui.select
                  Ember.Select required=true value=protocol content=protocolOptions optionValuePath='content.id' optionLabelPath='content.displayName' disabled=formDisabled
              td
                input.ui.btn.raised type='submit' disabled={view.addDisabled} value='Add'

if model.canEdit
  .card-footer.bordered
    .right
      if saving
        button.ui.btn disabled='disabled'
          i.spinner
          | Applying Changes...
      else
        button.ui.btn.primary click='apply' disabled={saving} Apply Changes
