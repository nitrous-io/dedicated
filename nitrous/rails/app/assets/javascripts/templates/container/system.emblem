= container-tab-bar selected='system' model=model

.card-body
  table.ui.table.horizontal
    tr
      th State
      td colspan='3'
        .state-indicator class={state}
        = state

    if App.user.advanced
      tr
        th Image
        td colspan='3'
          span.click-highlight
            = image

      if cmd
        tr
          th CMD
          td colspan='3'
            ul.space-separated.blocks
              each cm in cmd
                li
                  span.click-highlight
                    = cm

      if entrypoint
        tr
          th ENTRYPOINT
          td colspan='3'
            ul.space-separated.blocks
              each ep in entrypoint
                li
                  span.click-highlight
                    = ep

    tr
      th Workspace Host
      td colspan='3'
        span.click-highlight
          = host.hostname

    tr
      th Internal IP
      td
        if ipAddress
          span.click-highlight
            = ipAddress
        else
          span.empty &ndash;
      th Gateway IP
      td.right
        if gatewayIP
          span.click-highlight
            = gatewayIP
        else
          span.empty &ndash;

    tr
      th Started At
      td
        if startedAt
          = dateabbr startedAt
        else
          span.empty &ndash;
      th Finished At
      td.right
        if finishedAt
          = dateabbr finishedAt
        else
          span.empty &ndash;

    if App.user.advanced
      tr
        th Exit Code
        td colspan='3'
          span.click-highlight
            = exitCodeString

.card-footer.bordered
  if isRunning
    .left
      button.ui.btn click='openLogs' Logs
      unless isNitrousImage
        button.ui.btn click='openAttach' Attach
    .right
      button.ui.btn click='stop' Shut Down
      button.ui.btn.primary click='restart' Reboot
  else
    if isStopped
      .left
        button.ui.btn click='openLogs' Logs
      .right
        button.ui.btn click='showTerminateDialog target="view"' Terminate...
        button.ui.btn.primary click='start' Start
    else
      if isTerminated
        .left
          button.ui.btn disabled='disabled' Terminated
      else
        .left
          button.ui.btn disabled='disabled'
            i.spinner
            | Please Wait...

#terminate-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        | This action&nbsp;
        strong CANNOT
        | &nbsp;be undone!
      p
        ' This will permanently delete the application
        strong
          | &ldquo;
          = displayName
          ' &rdquo;
        | and all data stored within the application.
      p
        ' Please type in the slug of the application
        strong
          | (
          span.click-highlight
            = slug
          ' )
        | to confirm:
      .ui.input-group
        Em.TextField class='focus' placeholder=slug value=view.terminateSlugConfirmation insertNewline=view.clickTerminate
    .card-footer
      .right
        button.ui.btn click='cancelTerminate target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmTerminate target="view"' disabled=view.terminateSlugConfirmationInvalid Terminate

