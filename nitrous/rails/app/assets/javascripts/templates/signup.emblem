= outlet topnav

.ui.card
  .card-header.bordered
    h2 New Account

  form submit='signup'
    .card-body
      if App.pendingCoupon
        .free-credit class='show'
          .notice-text
            p
              ' You can claim your
              span = App.pendingCoupon
              '
              | coupon after this step.
      else
        if promoCodeInfo
          .free-credit class={promoCodeInfo.content:show}
            .notice-text
              h5 Limited Time Promotion
              p
                ' Sign up and receive
                span
                  ' $
                  = currency promoCodeInfo.content
                '
                | credit

      .ui.input-group
        label.field-label for='signup-username'
          | Username
        = input type='text' id='signup-username' classNameBindings='view.usernameFieldInvalid:error' disabled=signingUp value=user.username placeholder='e.g., cloudist'

      .ui.input-group
        label.field-label for='signup-email'
          | Email
        = input type='email' id='signup-email' classNameBindings='view.emailFieldInvalid:error' disabled=emailDisabled value=user.email placeholder='e.g., cloudist@example.com'
        .suggested-email class={showSuggested:show}
          if showSuggested
            p.hint-text click="acceptSuggestedEmail"
              i.fa.fa-exclamation-circle
              ' Did you mean
              span
                = suggestedEmail
              | ?

      .ui.input-group
        label.field-label for='signup-password'
          | Password
        = input type='password' id='signup-password' classNameBindings='view.passwordFieldInvalid:error' title=view.passwordInputTitle pattern=view.passwordInputPattern disabled=signingUp value=user.password

    .card-body
      .right
        input#signup-submit.ui.btn.primary.raised.full type='submit' disabled={view.disableSubmitButton} value='Create New Account'

    .card-body.bordered
      .right
        button.ui.btn.raised.full
          .icon.fa.fa-github.fa-lg
          '   Sign Up With GitHub

p.note
  ' By creating an account, you agree to the Nitrous
  br
  a href="http://docs.nitrous.io/v1.0/docs/terms-of-use" target="_blank" Terms of Service
  '  and
  a href="http://docs.nitrous.io/v1.0/docs/privacy-policy" target="_blank" Privacy Policy
  | .
  br
  br
  br
  | Already have an account?&nbsp;
  link-to 'login' | Log in
  | .

= partial 'partials/footer'
