= outlet topnav

.ui.card
  .card-header.bordered
    h2 New Account

  form submit='signup'
    .card-body
      .notice-text
        h5 Limited Time Bonus
        p
          ' New users receive
          span
            ' $
            if App.settings.new_user_credit
              = App.settings.new_user_credit
              '
            else
              ' 5
            ' Free
          | Credit

      .ui.input-group
        label.field-label for='signup-code'
          | Sign Up Code
        = input type='password' id='signup-code' classNameBindings='view.codeFieldInvalid:error' disabled=signingUp value=code

      .ui.input-group
        label.field-label for='signup-username'
          | Username
        = input type='text' id='signup-username' classNameBindings='view.usernameFieldInvalid:error' disabled=signingUp value=user.username placeholder='e.g., jdawg91'

      .ui.input-group
        label.field-label for='signup-email'
          | Email
        = input type='email' id='signup-email' classNameBindings='view.emailFieldInvalid:error' disabled=signingUp value=user.email placeholder='e.g., jdawg91@example.com'
        .suggested-email class={suggestedEmail:show}
          if suggestedEmail
            p.hint-text click="acceptSuggestedEmail"
              i.fa.fa-exclamation-circle
              ' Did you mean
              span
                = suggestedEmail
              | ?

      .ui.input-group
        label.field-label for='signup-password'
          | Password
        = input type='password' id='signup-password' classNameBindings='view.passwordFieldInvalid:error' disabled=signingUp value=user.password

    .card-footer
      .right
        input#signup-submit.ui.btn.primary.raised.full type='submit' disabled={view.disableSubmitButton} value='Create New Account'

p.note
  | Already have an account?&nbsp;
  link-to 'login' | Log in
  | .

= partial 'partials/footer'
