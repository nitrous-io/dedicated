= outlet topnav

.ui.card
  .card-header.bordered
    h2 New Account

  .intro
    | New users receive
    '
    .important
      | $
      if App.settings.new_user_credit
        = App.settings.new_user_credit
      else
        | 5
      '  Free Credit
    | .

  form submit='signup'
    .card-body
      .ui.input-group
        label.field-label for='signup-code'
          | Sign Up Code
        = input type='password' id='signup-code' classNameBindings='view.codeFieldInvalid:error' disabled=signingUp value=code

      .ui.input-group
        label.field-label for='signup-username'
          | Username
        = input type='text' id='signup-username' classNameBindings='view.usernameFieldInvalid:error' disabled=signingUp value=user.username placeholder='e.g. jcitizen91'

      .ui.input-group
        label.field-label for='signup-email'
          | Email
        = input type='email' id='signup-email' classNameBindings='view.emailFieldInvalid:error' disabled=signingUp value=user.email placeholder='e.g. jcitizen91@gmail.com'
        if suggestedEmail
          .suggestedEmail click="acceptSuggestedEmail"
            | Did you mean
            '
            = suggestedEmail
            | ?

      .ui.input-group
        label.field-label for='signup-password'
          | Password
        = input type='password' id='signup-password' classNameBindings='view.passwordFieldInvalid:error' disabled=signingUp value=user.password

    .card-footer
      .right
        input#signup-submit.ui.btn.primary.full type='submit' disabled={view.disableSubmitButton} value='Create New Account'

p.note
  | Already have an account?&nbsp;
  link-to 'login' | Log in
  | .

= partial 'partials/footer'
