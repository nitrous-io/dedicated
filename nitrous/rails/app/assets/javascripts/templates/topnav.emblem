.container
  ul.nav.left
    li
      link-to 'home.index'
        h1.logo
          span Nitrous
          small Beta
  ul.nav.right
    if App.user
      li
        a href='#'
          img.gravatar src={App.user.gravatar}
          = App.user.username
      li
        a href='#' click='sendFeedback target="view"'
          | Send Feedback
      li.ui.dropdown
        a href='#'
          | New
          .ui.dropdown-triangle
        ul.dropdown-menu
          if App.canCreateHosts
            li
              link-to 'hosts.new'| New Application...
          else
            li.disabled
              a href='#' title=view.newApplicationTitle New Application...
          if App.user.advanced
            if App.noHost
              li.disabled
                a href='#' New Container...
            else
              li
                link-to 'containers.new' | New Container...
      li.ui.dropdown
        a href='#'
          | Account
          .ui.dropdown-triangle
        ul.dropdown-menu.right
          li
            link-to 'account' | Account Settings
          / TODO: FFLAG payments
          if App.user.billingEnabled
            li
              link-to 'billing' | Billing
          else
            li.disabled
              a href='#' Billing
          else
          li.separator
          li
            a href='/docs/' Help
          li.separator
          li
            link-to 'logout' | Log Out
      if App.user.admin
        li.ui.dropdown
          a href='#'
            | Admin
            .ui.dropdown-triangle
          ul.dropdown-menu.right
            li
              a href='#' click='switchUser target="view"'
                | Switch User
    else
      li
        a href='/docs/' Documentation
      li.primary
        link-to 'signup' | Sign Up
      li.primary
        link-to 'login' | Log In
