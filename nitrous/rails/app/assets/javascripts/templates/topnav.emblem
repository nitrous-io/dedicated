.container
  ul.nav.left
    li
      link-to 'home.index'
        h1.logo
          span Nitrous
          small Beta
  ul.nav.right
    if App.user
      li
        a href='#' click='sendFeedback target="view"'
          | Send Feedback
      li.ui.dropdown
        a href='#'
          | New
          .ui.dropdown-triangle
        ul.dropdown-menu
          unless App.noHost
            li
              link-to 'containers.new' | New Container...
          if App.canCreateHosts
            li
              link-to 'hosts.new'| New Workspace...
          else
            li.disabled
              a href='#' title=view.newHostTitle New Workspace...
      if App.user.admin
        li.ui.dropdown
          a href='#'
            | Admin
            .ui.dropdown-triangle
          ul.dropdown-menu
            li
              a href='#' click='switchUser target="view"'
                | Switch User
            li
              = link-to 'provider-templates'
                | Provider Templates
      li.ui.dropdown
        a href='#'
          img.gravatar src={App.user.gravatar}
          = App.user.username
          .ui.dropdown-triangle
        ul.dropdown-menu.right
          li
            link-to 'account' | Account Settings
          if App.user.billingEnabled
            li
              link-to 'billing' | Billing
          else
            li.disabled
              a href='#' Billing
          li.separator
          li
            a href='/docs/' Help
          li.separator
          li
            link-to 'logout' | Log Out
    else
      li
        a href='/docs/' Documentation
      li.primary
        link-to 'signup' | Sign Up
      li.primary
        link-to 'login' | Log In
