.container
  ul.nav.left
    li
      if App.user
        link-to 'home.index'
          h1.logo
            span Nitrous
            small Pro
      else
        a href='/'
          h1.logo
            span Nitrous
            small Pro
  ul.nav.right
    if App.user
      li.ui.dropdown
        a href='#'
          i.fa.fa-plus
        ul.dropdown-menu
          if App.disableNewContainer
            li.disabled
              a href='#' title='You can only create a container when a workspace is running.'
                | New Container...
          else
            li
              link-to 'containers.new' | New Container...
          unless App.billingProfile.free
            if App.canCreateHosts
              li
                link-to 'hosts.new'| New Workspace...
            else
              li.disabled
                a href='#' title=view.newHostTitle New Workspace...
      if App.user.admin
        li.ui.dropdown
          a href='#'
            | Admin
            .ui.dropdown-triangle
          ul.dropdown-menu
            li
              a href='#' click='switchUser target="view"'
                | Switch User
            li
              a href='#' click='viewUser target="view"'
                | View User
            li
              a href='#' click='creditUser target="view"'
                | Credit User
            li
              = link-to 'admin.announcements'
                | Create Announcements
            li
              = link-to 'provider-templates'
                | Edit Provider Templates
            li
              = link-to 'admin.templates'
                | Edit Container Templates
            li
              = link-to 'admin.amazon-hosts'
                | Amazon
            li
              a href='#' click='updateAdminHosts target="view"'
                | Update My Hosts

      li.ui.dropdown
        a href='#'
          img.gravatar src={App.user.gravatar}
          = App.user.username
          if App.usage
            .free free
          .ui.dropdown-triangle
        ul.dropdown-menu.right
          li
            link-to 'account' | Account Settings
          li
            link-to 'billing' | Billing
          li.separator
          if App.usage
            li
              span.usage
                if App.usage.expired
                  span
                    i.fa.fa-exclamation-circle
                    | Daily usage exceeded
                  if App.usage.refreshIn
                    span
                      = durationInWords App.usage.refreshIn
                      |  until reset
                else
                  span.left Usage left:
                  span.right
                    = durationInWords App.usage.remaining
                  .progress-bar
                    .progress-bar-inner style=App.usage.progressBarStyle

            li.separator
          li
            a href='#' click='sendFeedback target="view"'
              | Send Feedback
          li
            a href='http://docs.nitrous.io/' target='_blank' Help
          li.separator
          if App.adminToken
            li
              a href='#' click='switchBackAdmin target="view"'
                | Switch Back Admin
          li
            link-to 'logout' | Log Out
    else
      li
        a href='/pricing' Pricing
      li
        a href='http://docs.nitrous.io/' target='_blank' Documentation
      li.primary
        link-to 'signup' | Sign Up
      li.primary
        link-to 'login' | Log In
