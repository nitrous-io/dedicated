.card-header.bordered
  h2
    | Verify your Phone Number

.card-body

  .notice-text
    p We will send you an SMS to verify your phone number
    p Please select your country code and enter your mobile number below

  form submit="savePhone" autocomplete="on"
    .ui.input-group
      label.field-label for='phone-country-code'
        | Country Code
      .ui.select.phone-country-code
        Ember.Select id='phone-country-code' name='phone-country-code' content=countryList optionValuePath='content.code' optionLabelPath='content.name' disabled=view.phoneFormDisabled value=phoneCountryCode required=true prompt='Select your country'

    .ui.input-group
      label.field-label for='phone'
        | Mobile Number
      = input type='text' id='phone' name='phone' disabled=view.phoneFormDisabled value=phone required=true autofocus=true

      input.ui.btn.primary type='submit' disabled=view.phoneFormDisabled value='Save'

      if otpSent
        .note
          p
            ' A verification code has been sent to
            strong = fullPhone
            ' . Please enter it below.

  if otpSent
    hr

    form submit="verifyOTP"
      .ui.input-group
        label.field-label for='otp'
          | Verification Code
        = input type='text' id='otp' name='otp' classNameBindings='invalidOTP:error' disabled=verifying value=otp

        input.ui.btn.primary type='submit' disabled=view.resendOTPDisabled value='Verify'
        a.ui.btn href='#' click='resendOTP' disabled=view.resendOTPDisabled Resend Code
        a.ui.btn href='#' click='editPhone' disabled=view.editPhoneDisabled Edit Number
