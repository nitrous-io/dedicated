if App.user.billingEnabled
  .card-header.bordered
    h2 Billing

  .card-body
    table.ui.table.horizontal
      tr
        th Card Type
        td
          = App.billingProfile.cardType
      tr
        th Last Four Digits
        td
          = App.billingProfile.lastFour
      tr
        th Expiry
        td
          = App.billingProfile.expiry

  .card-footer.bordered
      .right
        button.ui.btn click='changeCard' Change Card
else
  .card-header.bordered
    h2 Billing

  .card-body
    p
      | Billing has not been enabled for your account, please contact
      '
      a href="mailto:support@nitrous.io"
        | support@nitrous.io
      | .

if App.billingUsage
  .card-header.bordered
    h2 Current Usage

  .card-body
    .invoice-item
      table.ui.table.horizontal
        tbody
          = each item in App.billingUsage.items
            tr
              td
                = item.description
              td
                | $
                = item.totalChargeDollars
        tr.total-charge
          td
            | Total Charge
          td
            | $
            = App.billingUsage.totalChargeDollars


.card-header.bordered
  h2 Invoices

.card-body
  = each invoice in model
    .invoice-item
      .heading
        h4
          = simpledate invoice.periodStart
          '  -
          = simpledate invoice.periodEnd
        .payment-status class={invoice.unpaid:unpaid}
          if invoice.successfulCharge
            | Paid
          else
            | Unpaid
      table.ui.table.horizontal
        tbody
          = each item in invoice.items
            tr
              td
                = item.description
              td
                | $
                = item.totalChargeDollars
        tr.total-charge
          td
            | Total Charge
          td
            | $
            = invoice.totalChargeDollars
