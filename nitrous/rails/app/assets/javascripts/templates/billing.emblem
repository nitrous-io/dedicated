if App.billingProfile.hasCard
  .card-header.bordered
    h2 Billing

  .card-body
    if App.billingProfile.requiresAttention
      .notice-text
        i.fa.fa-warning
        '
        | There were issues billing your card. Please verify your card and
        '
        a href='#' click='didClickShowInvoices target="view"' click Pay Now on your invoices below
        | .
    table.ui.table.horizontal.credit-card-info
      tr
        th Card Type
        td#card-type
          = App.billingProfile.cardType
      tr
        th Last Four Digits
        td
          = App.billingProfile.lastFour
      tr
        th Expiry
        td
          = App.billingProfile.expiry

  .card-footer.bordered
      .right
        button.ui.btn click='changeCard' Change Card

if App.subscriptions
  .card-header.bordered
    h2 Current Subscriptions
  .card-body
    table.ui.table
      thead
        tr
          th Plan
          th Start
          th End
          th
      tbody
        = each subscription in App.subscriptions
          tr
            td
              = subscription.plan.displayName
            td
              = simpledate subscription.currentPeriodStart
            td
              = simpledate subscription.currentPeriodEnd
            td
              button.ui.btn click='showCancelSubscription subscription' Cancel

if App.billingUsage
  unless App.billingProfile.exempt
    .card-header.bordered
      h2 Current Usage

    .card-body
      .invoice-item
        table.ui.table.horizontal
          tbody
            = each group in App.billingUsage.groupedItems
              = each item in group.items
                App.InvoiceItemView item=item
          tr
            td.gap

          tr
            td
              | Current Usage
            td.charge
              | $
              = currency App.billingUsage.totalChargeDollars
          tr
            td
              | Available Credits
            td class={:charge App.billingUsage.hasCredit:credit}
              | ($-
              = currency App.billingUsage.availableCreditsDollars
              | )
          tr.total-charge
            td
              | Total Estimated Charge
            td.charge
              | $
              = currency App.billingUsage.estimatedCharge


#invoices-list.card-header.bordered
  h2 Invoices

.card-body
  unless App.invoices.content
    p.hint-text
      i.fa.fa-exclamation-circle
      | You don't have any invoices available.
  = each invoice in App.invoices
    if invoice.showInvoice
      .invoice-item
        .heading
          h4
            = simpledate invoice.periodStart
            '  -
            = simpledate invoice.periodEnd
          if invoice.showInvoiceState
            .payment-status class={invoice.unpaid:unpaid}
              if invoice.awaitingUpdate
                i.spinner
                | Verifying
              else
                if invoice.manuallyPayable
                  .payment-pay-now-action
                    button.ui.btn.danger disabled=invoice.paying click='payInvoice invoice'
                      if invoice.paying
                        i.spinner
                        | Processing
                      else
                        | Pay Now
                else
                  if invoice.successfulCharge
                    | Paid
                  else
                    if invoice.deferred
                      | Deferred
                    else
                      | Unpaid
        table.ui.table.horizontal
          tbody
            = each group in invoice.groupedItems
              = each item in group.items
                App.InvoiceItemView item=item

          tr.divider
            td
              | Total usage this period
            td.charge
              | $
              = currency invoice.totalUsageForPeriod
          tr
            td
              | Credits applied
              if invoice.creditAvailableDollars
                |  ($
                = currency invoice.creditAvailableDollars
                |  available)
            td class={:charge invoice.hasCredit:credit}
              | ($-
              = currency invoice.totalCreditDollars
              | )
          tr.total-charge
            td
              | Total Charge
            td.charge
              | $
              = currency invoice.totalChargeDollars

#cancel-subscription-modal-dialog.ui.modal
  .ui.card
    h2.card-header Cancel subscription
    .card-body
      p Are you sure?
    .card-footer
      button.ui.btn click='cancelSubscription subscription' Cancel Subscription
      button.ui.btn click='hideCancelSubscription' Back
