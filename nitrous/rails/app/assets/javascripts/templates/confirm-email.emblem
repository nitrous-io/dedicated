= outlet topnav

.ui.card
  if resendingConfirm
    h2.card-header
      | Resending confirmation email

  if resentConfirm
    h2.card-header
      | Resending confirmation email

    .ui
      .card-body.clear-top
        p
          | Your confirmation email has been resent, please check your email.

  if confirmLapsed
    h2.card-header
      | Your confirmation email has expired.

    .ui
      .card-body.clear-top
        p
          | Please resend your confirmation email to try again.
        p
          a.ui.btn click='resendConfirmationEmail' Resend confirmation email

  if confirming
    h2.card-header
      | Confirming your Email

  if generalError
    h2.card-header
      | A general error has occurred confirming your email

    .ui
      .card-body.clear-top
        p
          | You may have already confirmed your account or been provided with a broken link.
        p
          | Please try again or contact support if the error persists.

= partial 'partials/footer'
