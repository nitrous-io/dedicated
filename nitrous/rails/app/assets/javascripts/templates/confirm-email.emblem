= outlet topnav

.ui.card
  if resendingConfirm
    .card-header.bordered
      h2 Resending confirmation email

  if resentConfirm
    .card-header.bordered
      h2 Resending confirmation email

    .card-body.clear-top
      p
        | Your confirmation email has been resent, please check your email.

  if confirmLapsed
    .card-header.bordered
      h2 Your confirmation email has expired.

    .card-body.clear-top
      p
        | Please resend your confirmation email to try again.
      p
        a.ui.btn click='resendConfirmationEmail' Resend confirmation email

  if confirming
    .card-header.bordered
      h2 Confirming your Email

  if generalError
    .card-header.bordered
      h2 A general error has occurred confirming your email

    .card-body.clear-top
      p
        | You may have already confirmed your account or been provided with a broken link.
      p
        | Please try again or contact support if the error persists.

= partial 'partials/footer'
