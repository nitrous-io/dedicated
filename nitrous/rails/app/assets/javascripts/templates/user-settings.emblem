.card-header.bordered
  h2 Account Settings

form submit='save'
  .card-body
    .ui.input-group
      ul.ui.checkbox-group
        li
          .ui.checkbox
            = input type='checkbox' id='user-settings-advanced' checked=App.userProfile.advanced
            label
          label for='user-settings-advanced' Show Advanced Options

    .card-footer.bordered
      .right
        if saving
          button.ui.btn disabled='disabled'
            i.spinner
            | Saving...
        else
          a.ui.btn href='#' click='cancel' Cancel
          input.ui.btn.primary type='submit' disabled={saving} value='Save'

#confirm-advanced-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Warning!
    .card-body
      p
        | Changing advanced settings may affect the stability, security, and performance of your applications and containers.
      p
        | Only enable this if you are confident in what you are doing.
    .card-footer
      .right
        button.ui.btn.danger.terminate-btn click='hideModal target="view"' OK
