.container
  .left
    | Nitrous Pro Pre-Release Beta
  .right
    ul.space-separated
      li
        a href='/docs' target='_blank' Beta Docs
      li
        a href='#' click='sendFeedback target="view"' Send Feedback
      if App.user.admin
        li
          a href='#' click='switchUser target="view"' Switch User

#feedback-dialog.ui.modal
  .ui.card
    h2.card-header
      | Send Feedback
    form submit='send'
      .card-body
        .ui.input-group
          label.field-label for='feedback-subject'
            | Subject
          = input type='text' id='feedback-subject' value=subject required=true

        .ui.input-group
          label.field-label for='feedback-message'
            | Message
          Ember.TextArea id='feedback-message' rows='10' value=message required=true
      .card-footer
        .right
          if sending
            button.ui.btn disabled='disabled'
              i.spinner
              | Sending...
          else
            a.ui.btn href='#' click='closeModal target="view"' Cancel
            input.ui.btn.primary type='submit' value='Send'

if App.user.admin
  #switch-user-dialog.ui.modal
    .ui.card
      h2.card-header
        | Switch User
      form submit='switchUser'
        .card-body
          .ui.input-group
            label.field-label for='switch-user-login'
              | Email/Username
            = input type='text' id='switch-user-login' value=login required=true

        .card-footer
          .right
            if switching
              button.ui.btn disabled='disabled'
                i.spinner
                | Wait...
            else
              a.ui.btn href='#' click='closeModal target="view"' Cancel
              input.ui.btn.primary type='submit' value='Switch'
