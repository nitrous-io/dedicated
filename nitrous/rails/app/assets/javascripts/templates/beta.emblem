if App.user.admin
  #switch-user-dialog.ui.modal
    .ui.card
      h2.card-header
        | Switch User
      form submit='switchUser'
        .card-body
          .ui.input-group
            label.field-label for='switch-user-login'
              | Email/Username
            = input type='text' id='switch-user-login' value=login required=true

        .card-footer
          .right
            if switching
              button.ui.btn disabled='disabled'
                i.spinner
                | Wait...
            else
              a.ui.btn href='#' click='cancelSwitchUser target="view"' Cancel
              input.ui.btn.primary type='submit' value='Switch'
