.pricing-table
  .card-body.bordered
    .narrow-body
      .ui.input-group
        label.field-label
          | Workspace Size
      ul.plans
        each plan in arrangedContent
          li
            h4
              = plan.name
            h3
              = plan.priceInDollars
              '
              span
                | / mo.
            .content
              ul.features
                li.max-containers
                  ' Up to
                  span
                    = plan.maxContainers
                  '
                  | Applications
                li
                  span
                    = plan.memory
                  '
                  | Memory
                li
                  span
                    = plan.storage
                  '
                  | Storage
                li
                  | Root Access
                li
                  | Dedicated Resources
              button.ui.btn.primary.raised click='selectPlan plan target="view"'
                | Select This Plan
            if plan.mostPopular
              .ribbon
                p Most Popular
  .card-body.bordered
    .narrow-body
      .description
        h4 All plans also come with
        .features
          ul
            li Always On
            li SSH Access
            li Desktop Sync (Mac/Windows/Linux)
            li Custom Domains
          ul
            li SSL Protection
            li Web IDE
            li Snapshots
            li Custom Container Management
