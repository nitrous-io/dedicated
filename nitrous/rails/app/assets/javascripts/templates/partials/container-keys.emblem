.card-body
  label.field-label
    | Container Public Keys

  p.hint-text
   | Public keys on your container. Add these to external services to allow access to them from your container

  if error
    p.error-text
      i.fa.fa-exclamation-circle
      if notRunningError
        | Please start this container to view its public keys
      else
        | Error loading container public keys
  else
    if containerKeys.loaded
      if containerKeys.length
        table.ui.table
          tbody
            each key in containerKeys
              .left
                h4
                  = key.name
                .ui.input-group
                  = textarea type='text' class='text-highlight key-field' id='public-key' name='public-key' rows='6' value=key.key readonly=true
              .right
                if App.userProfile.authorizedGitHubUserName
                  if removing
                    button.ui.btn disabled='disabled'
                      i.spinner
                      | Removing...
                  else
                    button.ui.btn click='askRemoveContainerKey target="view"' disabled={view.removeKeyDisabled} Remove from GitHub

                  if saving
                    button.ui.btn disabled='disabled'
                      i.spinner
                      | Adding to GitHub...
                  else
                    button.ui.btn click='addToGitHub key' disabled={view.addToGithubDisabled} Add to GitHub

      else
        p.hint-text
          i.fa.fa-info-circle
          | There aren't any container keys.
    else
      p.hint-text
        i.spinner
        | Loading...

#confirm-remove-container-key-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you sure?
    .card-body
      p
        | Are you sure you want to remove the container key from GitHub?

    .card-footer
      .right
        button.ui.btn click='cancelRemoveContainerKey target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmRemoveContainerKey target="view"' Remove
