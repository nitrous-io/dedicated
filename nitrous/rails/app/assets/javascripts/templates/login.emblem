= outlet topnav

.ui.card class={error:shake}
  .card-header.bordered
    h2 Log In

  if controller.confirmationLapsed
    .message
      if resentConfirm
        p
          | Confirmation resent!
        p
          | Please check your email to confirm your email.
      else
        if resendingConfirm
          p
            | Resending confirmation.....
        else
          p
            | Your confirmation email has lapsed.
          if controller.confirmationLapsedResendable
            p
              | Didn't receive a confirmation email?
              a.ui.btn click='resendConfirmationEmail' Resend confirmation email

  form
    .card-body
      .ui.input-group
        label.field-label for='login-login'
          | Username or Email
        = input type='text' id='login-login' value=login

      .ui.input-group
        label.field-label for='login-password'
          | Password
        = input type='password' id='login-password' value=password

    .card-footer
      .right
        if loggingIn
          button.ui.btn disabled='disabled'
            i.spinner
            | Logging In...
        else
          button.ui.btn.primary.login-submit-btn click='login' disabled={view.disableSubmitButton}
            | Log In

p.note
  | Don't have an account?&nbsp;
  link-to 'signup' | Sign up
  | .
  br
  br
  | Can't remember password?&nbsp;
  link-to 'forgot-password' | Reset password
  | .

= partial 'footer'
