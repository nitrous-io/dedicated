= outlet topnav

.ui.card class={error:shake}
  .card-header.bordered
    h2 Log In

  form
    .card-body
      if App.confirmationLapsed
        .notice-text
          if resentConfirm
            p
              ' Confirmation resent!
              | Please check your email.
          else
            if resendingConfirm
              p
                i.spinner
                | Resending confirmation...
            else
              p
                | Your confirmation email has expired.
                if confirmationLapsedResendable
                  a.ui.btn.raised.primary href='#' click='resendConfirmationEmail' Resend confirmation email

      .ui.input-group
        label.field-label for='login-login'
          | Username or Email
        = input type='text' id='login-login' value=login

      .ui.input-group
        label.field-label for='login-password'
          | Password
        = input type='password' id='login-password' value=password

    .card-body
      .right
        if loggingIn
          button.ui.btn disabled='disabled'
            i.spinner
            | Logging In...
        else
          button.ui.btn.raised.full click='login' disabled={view.disableSubmitButton}
            | Log In

    .card-body.bordered
      .right
        button.ui.btn.raised.full
          .icon.fa.fa-github.fa-lg
          '   Log In With GitHub

p.note
  | Don't have an account?&nbsp;
  link-to 'signup' | Sign up
  | .
  br
  br
  | Can't remember password?&nbsp;
  link-to 'forgot-password' | Reset password
  | .

= partial 'partials/footer'
