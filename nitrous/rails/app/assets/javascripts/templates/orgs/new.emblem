.card-header.bordered
  h2 New Organization

form submit='create target="view"'
  .card-body
    .ui.input-group
      label.field-label for='orgs-new-name'
        | Name
      = input type='text' name='name' id='orgs-new-name' disabled=saving value=name

    .ui.input-group
      label.field-label for='orgs-new-email'
        | Billing Email
      = input type='text' name='email' id='orgs-new-email' disabled=saving value=email

  .card-footer.bordered
    .right
      if saving
        button.ui.btn disabled='disabled'
          i.spinner
          | Creating...
      else
        input.ui.btn.primary type='submit' disabled={view.createButtonDisabled} value='Create'
