h4
  = plan.name
h3
  ' $
  = plan.totalPriceInDollars
  '
  span
    | / mo.
.content
  ul.features
    li.max-containers
      ' Up to
      span
        = plan.maxContainers
      '
      | Containers
    li
      span
        = plan.cpu
      '
      | Core Processor
    li
      span
        = plan.memory
      '
      | Memory
    li
      span
        = plan.storage
      '
      | Storage
    li
      | Root Access
    li
      | Dedicated Resources
  if canSelectPlan
    button.ui.btn.primary.raised class={view.isSelected:active} click='selectPlan plan'
      | Select This Plan

if plan.trialAvailable
  .ribbon
    p.free-trial Free Trial
else
  if plan.mostPopular
    .ribbon
      p.most-popular Most Popular
