= app-tab-bar selected='general' model=model

.card-body
  table.ui.table.horizontal
    tr
      th State
      td
        .state-indicator class={appState}
        = appState
      th Size
      td.usage
        = plan.name

    tr
      th Slug
      td
        span.click-highlight
          = slug
      th
        | Memory
        span.no-text-transform &nbsp;(MiB)
      td.usage
        if view.hostStatsAvailable
          = mebibytes stats.memoryUsage
          | &nbsp;/&nbsp;
          = mebibytes stats.memoryTotal
          ' &nbsp;
          a.ui.icon-btn.fa.fa-refresh href='#' click='refresh target="view"'
        else
          span.empty &ndash;

    tr
      th Template
      td
        = appContainer.image
      th
        | Storage
        span.no-text-transform &nbsp;(GiB)
      td.usage
        if view.hostStatsAvailable
          = gibibytes stats.storageUsage
          | &nbsp;/&nbsp;
          = gibibytes stats.storageTotal
          ' &nbsp;
          a.ui.icon-btn.fa.fa-refresh href='#' click='refresh target="view"'
        else
          span.empty &ndash;

    tr
      th Hostname
      td colspan='3'
        span.click-highlight
          = hostname

    tr
      th Created At
      td colspan='3'
        = dateabbr createdAt

.card-footer.bordered
  // if host is running
  if isRunning
    if appContainer
      if appContainer.isRunning
        .left
          button.ui.btn click='restart' Restart
          button.ui.btn click='stop' Stop
        .right
          button.ui.btn click='openLogs' Logs
          if appContainer.previewURL
            a.ui.btn href=appContainer.previewURL target='_blank' Preview
          if App.user.ideEnabled
            button.ui.btn click='openTerminal' Terminal
            a.ui.btn.primary href=appContainer.ideURL target='_blank' IDE
          else
            button.ui.btn.primary click='openTerminal' Terminal
      else
        if appContainer.isStopped
          .left
            button.ui.btn click='showTerminateDialog target="view"' Terminate...
          .right
            button.ui.btn click='openLogs' Logs
            button.ui.btn.primary click='start' Start
        else
          if appContainer.isTerminated
            .left
              button.ui.btn disabled='disabled' Terminated
          else
            .left
              button.ui.btn disabled='disabled'
                i.spinner
                | Please Wait...
    else
      // if appContainer is not found
      .left
        button.ui.btn click='showTerminateDialog target="view"' Terminate...
      .right
        button.ui.btn.primary click='restart' Restart

  else
    // if host is terminated
    if isTerminated
      .left
        button.ui.btn disabled='disabled' Terminated
    else
      .left
        button.ui.btn disabled='disabled'
          i.spinner
          | Please Wait...

#terminate-modal-dialog.ui.modal
  .ui.card
    h2.card-header
      | Are you ABSOLUTELY sure?
    .card-body
      p
        | This action&nbsp;
        strong CANNOT
        | &nbsp;be undone!
      p
        ' This will permanently delete the workspace
        strong
          | &ldquo;
          = displayName
          ' &rdquo;
        | .
      p
        ' Please type in the slug of the workspace&nbsp;
        strong
          | (
          span.click-highlight
            = slug
          ' )
        | to confirm:
      .ui.input-group
        Em.TextField class='focus' placeholder=slug value=view.terminateSlugConfirmation insertNewline=view.clickTerminate
    .card-footer
      .right
        button.ui.btn click='cancelTerminate target="view"' Cancel
        button.ui.btn.danger.terminate-btn click='confirmTerminate target="view"' disabled=view.terminateSlugConfirmationInvalid Terminate
