= app-tab-bar selected='ports' model=model

.card-body
  p.hint-text
    | Manage exposed ports for this application.

  ul.ui.chips
    each port in publicPorts
      li
        = port
        unless saving
          a.close href='#' click='remove port' &times;

  form submit='add'
    .ui.input-group
      table.ui.table
        thead
          tr
            th colspan='2' Port
        tbody
          tr
            td
              = input type='number' min='1' max='65535' step='1' placeholder='8080' value=port disabled=saving
            td
              input.ui.btn.raised type='submit' value='Add' disabled={view.addDisabled}

.card-footer.bordered
  .right
    button.ui.btn.primary click='apply' Apply
