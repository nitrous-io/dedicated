= app-tab-bar selected='ports' model=model

.card-body
  ul.ui.chips
    if publicPorts
      each port in publicPorts
        li
          = port.value
          |&nbsp;
          if port.preview
            i.fa.fa-globe
          unless saving
            a.close href='#' click='remove port' &times;

      p.hint-text
        i.fa.fa-globe
        | denotes the preview port
    else
      p.hint-text
        i.fa.fa-exclamation-circle
        | There aren't any exposed ports for this application.

  form submit='add'
    .ui.input-group
      table.ui.table
        thead
          tr
            th
              abbr title='Enable to use this port as the preview port' Preview
            th colspan='2'  Port
        tbody
          tr
            td
              .ui.checkbox
                = input type='checkbox' checked=previewPort disabled=saving
                label
            td
              = input type='number' min='1' max='65535' step='1' placeholder='8080' value=port disabled=saving
            td
              input.ui.btn.raised type='submit' value='Add' disabled={view.addDisabled}

.card-footer.bordered
  .right
    button.ui.btn.primary click='apply' disabled={saving} Apply
