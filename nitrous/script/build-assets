#!/bin/bash
set -e
BUILD_DIR=./build

rm -rf "$BUILD_DIR"/public
cd rails
rm -rf ./public/assets
rm -rf ./public/app
bundle install
RACK_ENV=production bundle exec rake assets:clean assets:precompile
mkdir -p "$BUILD_DIR"/public/app

bundle exec rails runner -e production '
	File.write("'"$BUILD_DIR"'/public/app/index.html", ActionView::Base.new(Rails::Application::Configuration.new(Rails.root).paths["app/views"]).render(template: "web_app/index"))
	File.write("'"$BUILD_DIR"'/public/index.html", ActionView::Base.new(Rails::Application::Configuration.new(Rails.root).paths["app/views"]).render(template: "pages/home"))
'
cd ..

mv ./rails/public/assets "$BUILD_DIR"/public
