#!/usr/bin/env bash
set -x
set -e

APP=${1:?"app name is required"}
VERSION=${2:?"version is required"}
ENV=${3:?"env is required"}

ARTIFACT_DIR=/tmp/$APP/$VERSION/$ENV/darwin/amd64

if [[ "$ENV" == "production" ]]; then
  PACKAGE_NAME=$APP
else
  PACKAGE_NAME=${ENV}${APP}
  mv ${ARTIFACT_DIR}/${APP} ${ARTIFACT_DIR}/${PACKAGE_NAME}
fi

# OSX package
OSX_ARCH="darwin_amd64"
OSX_PKG=${PACKAGE_NAME}-${VERSION}-${OSX_ARCH}.tar.gz
OSX_BUCKET=osx.nitrous.io

cd $ARTIFACT_DIR
tar -zvcf ${OSX_PKG} ${PACKAGE_NAME}

s3cmd --access_key=$ACCESS_KEY --secret_key=$SECRET_KEY --acl-public put ${ARTIFACT_DIR}/${OSX_PKG} s3://${OSX_BUCKET}/${OSX_PKG}
s3cmd --access_key=$ACCESS_KEY --secret_key=$SECRET_KEY --acl-public put ${ARTIFACT_DIR}/${OSX_PKG} s3://${OSX_BUCKET}/${PACKAGE_NAME}-latest-${OSX_ARCH}.tar.gz

