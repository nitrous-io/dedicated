#!/bin/sh
set -e

### BEGIN INIT INFO
# Provides:           freighterd
# Required-Start:     $syslog $remote_fs
# Required-Stop:      $syslog $remote_fs
# Default-Start:      2 3 4 5
# Default-Stop:       0 1 6
# Short-Description:  Nitrous.IO HTTP frontend for docker.
# Description:
#   Nitrous.IO HTTP frontend for docker.
#   All Rights Reserved - Irrational Industries d/b/a Nitrous.IO
### END INIT INFO

export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin

BASE=freighterd
FREIGHTERD=/usr/sbin/$BASE
# This is the pid file managed by freighterd itself
FREIGHTERD_PIDFILE=/var/lib/freighter/freighter.pid
# This is the pid file created/managed by start-stop-daemon
FREIGHTERD_SSD_PIDFILE=/var/run/$BASE-ssd.pid
FREIGHTERD_LOGFILE=/var/log/$BASE.log

# Get lsb functions
. /lib/lsb/init-functions

# see also init_is_upstart in /lib/lsb/init-functions (which isn't available in Ubuntu 12.04, or we'd use it)
if [ -x /sbin/initctl ] && /sbin/initctl version 2>/dev/null | grep -q upstart; then
	log_failure_msg "$BASE is managed via upstart, try using service $BASE $1"
	exit 1
fi

# Check docker is present
if [ ! -x $FREIGHTERD ]; then
	log_failure_msg "$FREIGHTERD not present or not executable"
	exit 1
fi

fail_unless_root() {
	if [ "$(id -u)" != '0' ]; then
		log_failure_msg "$BASE must be run as root"
		exit 1
	fi
}

case "$1" in
	start)
		fail_unless_root

		touch "$FREIGHTERD_LOGFILE"

		ulimit -n 1048576
		if [ "$BASH" ]; then
			ulimit -u 1048576
		else
			ulimit -p 1048576
		fi

		log_begin_msg "Starting $BASE"
		start-stop-daemon --start --background \
			--no-close \
			--exec "$FREIGHTERD" \
			--pidfile "$FREIGHTERD_SSD_PIDFILE" \
			--make-pidfile \
			-- \
				-d -p "$FREIGHTERD_PIDFILE" \
					>> "$FREIGHTERD_LOGFILE" 2>&1
		log_end_msg $?
		;;

	stop)
		fail_unless_root
		log_begin_msg "Stopping $BASE"
		start-stop-daemon --stop --pidfile "$FREIGHTERD_SSD_PIDFILE"
		log_end_msg $?
		;;

	restart)
		fail_unless_root
		freighterd_pid=`cat "$FREIGHTERD_SSD_PIDFILE" 2>/dev/null`
		[ -n "$freighterd_pid" ] \
			&& ps -p $freighterd_pid > /dev/null 2>&1 \
			&& $0 stop
		$0 start
		;;

	force-reload)
		fail_unless_root
		$0 restart
		;;

	status)
		status_of_proc -p "$FREIGHTERD_SSD_PIDFILE" "$FREIGHTERD" "$BASE"
		;;

	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
