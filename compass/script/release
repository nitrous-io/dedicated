#!/usr/bin/env bash
# upload the tar binaries to s3
# requires s3cmd to be setup

cd $(pwd)/build
VERSION=$(git rev-parse --short HEAD)
BUCKET=nitrous-dedicated

if [[ -f "compass_${VERSION}.tgz" || -f "compass_latest.tgz" ]]; then
  echo "Uploading binary packages to s3 ...."
  s3cmd put compass_${VERSION}.tgz s3://${BUCKET}/compass_${VERSION}.tgz
  s3cmd put compass_latest.tgz s3://${BUCKET}/compass_latest.tgz
else
  echo "Failed to find package: $VERSION in ./build directory."
  exit 1
fi
