#!/usr/bin/env bash
set -e

VERSION=$1
PACKAGE=github.com/nitrous-io/compass
BUILD=$(pwd)/build

echo "Building revision ${VERSION} ...."
export GOBIN=$BUILD
go install -ldflags "-X main.version ${VERSION}" -v $PACKAGE/...

cd $BUILD
tar -f compass_${VERSION}.tgz -zv -c compass
tar -f compass_latest.tgz -zv -c compass
