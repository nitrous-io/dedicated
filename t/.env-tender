ADDR=0.0.0.0
DATABASE_URL=host=/var/run/postgresql user=root dbname=tender_test sslmode=disable
FREIGHTERD_PORT=65333

# require settings for proxying container's request
# this will let tender listen to the preview port range and proxy request
# accordingly to the host
CONTAINER_BASE_DOMAIN=.n2odevapp.com
CONTAINER_CA_CRT=script/certs/n2odev.crt
CONTAINER_CA_KEY=script/certs/n2odev.key
PREVIEW_START_PORT=8000
PREVIEW_END_PORT=9000

# required settings for proxying host's request
# this let tender listen the the domain that should proxy request to freighter
HOST_BASE_DOMAIN=.n2odev.com
HOST_CA_CRT=script/certs/n2odev.crt
HOST_CA_KEY=script/certs/n2odev.key

TLS_DOMAIN=.n2odev.com
PRI_CRT=script/certs/n2odevpro-ca.crt
